info(
    title: "产品管理模块"
    desc: "产品管理模块"
    author: "杨磊"
    email: "603685348@qq.com"
    version: "v1"
)

@server(
    group: things/device/schema
    prefix: /api/v1/things/device/schema
    accessCodePrefix: "thingsDeviceSchema"
    accessNamePrefix: "设备物模型"
    accessGroup: "设备管理"
    middleware:  CheckTokenWare,InitCtxsWare
	defaultAuthType: "admin"
	defaultNeedAuth: "true"
)
    //物联网平台通过定义一种物的描述语言来描述物模型模块和功能，称为TSL（Thing Specification Language）
service api {
//    @doc(
//        summary: "导入设备物模型tsl"
//        authType: "admin"
//        isNeedAuth: "true"
//    )
//    @handler tslImport
//    post /tsl-import (ProductSchemaTslImportReq) returns ()
    @doc(
        summary: "获取设备物模型tsl"
        description: "获取设备的完整物模型TSL（Thing Specification Language）描述。TSL是物联网平台定义的物模型描述语言，包含属性、事件、行为的完整定义。返回JSON格式的TSL字符串，用于设备调试、物模型导入导出。"
        authType: "admin"
        group: "things/device/schema"
        resource: "things/device/schema"
        action: "view"
        recordLogMode: "1"
    )
    @handler tslGetOne
    post /tsl-read (DeviceSchemaTslGetOneReq) returns (DeviceSchemaTslGetOneResp)

    @doc(
        summary: "更新设备物模型"
        description: "更新设备的单个物模型条目（属性、事件或行为）。设备物模型用于覆盖或补充产品物模型，实现设备级别的个性化配置。修改后立即生效，影响该设备的数据解析和控制逻辑。"
        authType: "admin"
        isNeedAuth: "true"
        group: "things/device/schema"
        resource: "things/device/schema"
        action: "update"
        recordLogMode: "1"
    )
    @handler update
    post /update (DeviceSchema) returns ()
    @doc(
        summary: "创建设备物模型"
        description: "为设备新增一个物模型条目（属性、事件或行为）。用于设备有产品物模型之外的个性化功能，或需要修改产品物模型中的默认定义。创建后设备将拥有该功能定义。"
        authType: "admin"
        isNeedAuth: "true"
        group: "things/device/schema"
        resource: "things/device/schema"
        action: "create"
        recordLogMode: "1"
    )
    @handler create
    post /create (DeviceSchema) returns ()
    @doc(
        summary: "批量创建设备物模型"
        description: "批量导入设备物模型条目。支持两种方式：1）通过标识符列表从产品物模型继承定义；2）直接传入自定义的物模型列表。用于快速为设备配置多个物模型功能。"
        authType: "admin"
        isNeedAuth: "true"
        group: "things/device/schema"
        resource: "things/device/schema"
        action: "create"
        recordLogMode: "1"
    )
    @handler batchCreate
    post /batch-create (DeviceSchemaBatchCreateReq) returns ()
    @doc(
        summary: "批量删除设备物模型"
        description: "批量删除设备的物模型条目。通过标识符列表指定要删除的功能定义。删除后设备将恢复使用产品物模型的默认定义。注意：必选标签（tag=3）的物模型不可删除。"
        authType: "admin"
        isNeedAuth: "true"
        group: "things/device/schema"
        resource: "things/device/schema"
        action: "delete"
        recordLogMode: "1"
    )
    @handler batchDelete
    post /batch-delete (DeviceSchemaBatchDeleteReq) returns ()

    @doc(
        summary: "获取设备物模型列表"
        description: "查询设备的物模型条目列表。支持按类型（属性/事件/行为）、标签（自定义/可选/必选）、标识符等条件筛选。可选择是否同时获取产品物模型用于对比。用于设备物模型管理、功能配置查询。"
        authType: "admin"
        group: "things/device/schema"
        resource: "things/device/schema"
        action: "view"
        recordLogMode: "1"
    )
    @handler getList
    post /get-list (DeviceSchemaGetListReq) returns (DeviceSchemaGetListResp)
}

type (
    DeviceSchemaTslGetOneReq  {
        ProductID string `json:"productID"` //产品id
        DeviceName string `json:"deviceName"`
    }
    DeviceSchemaTslGetOneResp  {
        Tsl string `json:"tsl"`                   //物模型tsl
    }
)

type (
    DeviceSchemaUpdateReq  {
        *DeviceSchema
    }
    DeviceSchemaBatchDeleteReq{
        ProductID string `json:"productID"`         //产品id
        DeviceName string `json:"deviceName"`
        Identifiers []string    `json:"identifiers"` //物模型ID列表
    }
    DeviceSchemaBatchCreateReq{
        ProductID string `json:"productID"`         //产品id
        DeviceName string `json:"deviceName"`
        Identifiers []string `json:"identifiers,optional"`                //导入的标识符列表
        List []*DeviceSchema `json:"list,optional"`           //如果没有填标识符列表取这里
    }
    DeviceSchemaDeleteReq {
        ProductID string `json:"productID"`         //产品id
        DeviceName string `json:"deviceName"`
        Identifier string `json:"identifier"`                //标识符
    }
    DeviceSchemaGetListReq {
        Page *PageInfo `json:"page,optional"`                              //分页信息,只获取一个则不填
        ProductID string `json:"productID"`                                //产品id
        DeviceName string `json:"deviceName"`
        Type int64 `json:"type,optional"`                                  //物模型类型 1:property属性 2:event事件 3:action行为
        Types []int64 `json:"types,optional"`
        Tag int64 `json:"tag,optional"`                                    //过滤条件: 物模型标签 1:自定义 2:可选 3:必选
        Identifiers []string `json:"identifiers,optional"`                 //过滤标识符列表
        Name string  `json:"name,optional"`
        IsCanSceneLinkage int64  `json:"isCanSceneLinkage,optional"` //是否可以场景联动
        FuncGroup int64 `json:"funcGroup,optional"`// 功能分类: 1:普通功能 2:系统功能
        // UserPerm int64 `json:"userPerm,optional"`//用户权限操作: 1:r(只读) 3:rw(可读可写)
        PropertyMode string  `json:"propertyMode,optional"`//属性类型可用 读写类型: 1:r(只读) 2:rw(可读可写)
        ControlMode int64 `json:"controlMode,optional"`//控制模式: 1: 可以群控,可以单控  2:只能单控
        WithProductSchema bool `json:"withProductSchema,optional"` //同时获取产品物模型
    }
    DeviceSchemaGetListResp {
        List []*DeviceSchema `json:"list"`           //分页信息,只获取一个则不填
        PageResp
    }
)


type (
/*物模型条目*/
    DeviceSchema  {
        ProductID string `json:"productID,optional"`                  //产品id 只读
        DeviceName string `json:"deviceName,optional"`
        Type int64 `json:"type"`                             //物模型类型 1:property属性 2:event事件 3:action行为
        Tag int64 `json:"tag"`                               //物模型标签 1:自定义 2:可选 3:必选  必选不可删除
        Identifier string `json:"identifier"`                //标识符
        ExtendConfig string    `json:"extendConfig,optional"`//拓展参数
        Name *string `json:"name,optional"`                           //功能名称
        Desc *string `json:"desc,optional"`                           //描述
        Required int64 `json:"required,optional"`                     //是否必须 1:是 2:否
        /*
        Affordance 各功能类型的详细参数定义(JSON)。由字段 Type 决定其结构:

        1) Type=1 PropertyAffordance (属性能力)
           - isUseShadow: bool  是否使用设备影子。true: 设备离线写影子，在线直发
           - isNoRecord:  bool  是否不存储历史记录。true: 不落库，仅保留最新
           - define:      object 数据定义(Define)。描述数据类型、取值范围/枚举、单位、步进等
           - mode:        int    读写类型(PropertyMode)。1: r(只读) 2: rw(可读可写)
           - JSON 示例: {"isUseShadow":true,"isNoRecord":false,"define":{"type":"int","min":0,"max":100,"unit":"%"},"mode":2}

        2) Type=2 EventAffordance (事件能力)
           - type:   string  事件类型(EventType)。info/alert/fault
           - params: object  事件参数(Params)。键为参数名，值为参数定义(同 Define)
           - JSON 示例: {"type":"alert","params":{"code":{"type":"string"},"level":{"type":"enum","enum":["L1","L2","L3"]}}}

        3) Type=3 ActionAffordance (行为能力)
           - dir:    string  调用方向(ActionDir)。如 up/down
           - input:  object  调用入参(Params)。键为参数名，值为参数定义(同 Define)
           - output: object  返回出参(Params)。键为参数名，值为参数定义(同 Define)
           - JSON 示例: {"dir":"down","input":{"switch":{"type":"bool"}},"output":{"result":{"type":"int","enum":[0,1]}}}

        参考: things/share/domain/schema/affordance.go
        */
        Affordance *string `json:"affordance,optional"`
        IsCanSceneLinkage int64  `json:"isCanSceneLinkage,optional"` //是否可以场景联动
        FuncGroup int64 `json:"funcGroup,optional"`// 功能分类: 1:普通功能 2:系统功能
        // UserPerm int64 `json:"userPerm,optional"`//用户权限操作: 1:r(只读) 3:rw(可读可写)
        // RecordMode int64 `json:"recordMode,optional"`// 1(默认) 记录历史记录 2 只记录差异值 3 不记录历史记录
        // IsPassword int64 `json:"isPassword,optional"` //是否是密码类型,密码类型需要加掩码
        Order int64 `json:"order,optional"`// 排序
        // ControlMode int64 `json:"controlMode,optional"`//控制模式: 1: 可以群控,可以单控  2:只能单控

        //        Event *SchemaEvent `json:"event,optional"`           //事件参数定义
//        Property *SchemaProperty `json:"property,optional"`  //属性参数定义
//        Action *SchemaAction `json:"action,optional"`        //行为参数定义
    }
)
