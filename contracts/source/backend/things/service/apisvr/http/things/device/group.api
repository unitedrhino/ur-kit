info(
    title: "数据交互(待定)"
    desc: "数据交互(待定)"
    author: "杨磊"
    email: "603685348@qq.com"
    version: "v1"
)
@server(
    group: things/device/group
    prefix: /api/v1/things/device/group
    middleware:  CheckTokenWare,InitCtxsWare
	defaultAuthType: "admin"
	defaultNeedAuth: "true"
    accessCodePrefix: "thingsDeviceGroup"
    accessNamePrefix: "设备信息"
    accessGroup: "设备管理"
)
service api {
    @doc(
        summary: "将设备加到多个分组中"
        description: "批量将设备添加到多个分组。分组用于设备分类管理，可按用途（purpose）区分（如default默认分组、alarm告警分组等）。支持同时添加到多个分组ID，用于设备批量归类、场景分组管理。"
        authType: "admin"
        group: "things/device/group"
        resource: "things/device/group"
        action: "create"
        recordLogMode: "1"
    )
    @handler batchCreate
    post /batch-create (DeviceGroupBatchSaveReq) returns ()

    @doc(
        summary: "更新设备所在分组"
        description: "修改设备所属的分组关系。传入新的分组ID列表，会替换设备原有的该用途下的分组关系。用于设备重新分类、调整分组归属。"
        authType: "admin"
        group: "things/device/group"
        resource: "things/device/group"
        action: "update"
        recordLogMode: "1"
    )
    @handler batchUpdate
    post /batch-update (DeviceGroupBatchSaveReq) returns ()

    @doc(
        summary: "删除设备所在分组"
        description: "将设备从指定分组中移除。不影响设备本身，只解除设备与分组的关联关系。用于设备不再属于某分组时的移除操作。"
        authType: "admin"
        group: "things/device/group"
        resource: "things/device/group"
        action: "delete"
        recordLogMode: "1"
    )
    @handler batchDelete
    post /batch-delete (DeviceGroupBatchSaveReq) returns ()

}
type (
    DeviceGroupBatchSaveReq{
        ProductID string `json:"productID"`                                               //产品id
        DeviceName string `json:"deviceName"`                                             //设备名称
        Purpose string `json:"purpose,optional"`//用途 不填默认为default
        GroupIDs []int64 `json:"groupIDs,string"`
    }
)
