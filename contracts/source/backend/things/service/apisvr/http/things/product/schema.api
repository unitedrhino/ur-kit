info (
	title:   "产品管理模块"
	desc:    "产品管理模块"
	author:  "杨磊"
	email:   "603685348@qq.com"
	version: "v1"
)

@server (
	group:            things/product/schema
	prefix:           /api/v1/things/product/schema
	accessCodePrefix: "thingsProductSchema"
	accessNamePrefix: "产品物模型"
	accessGroup:      "产品管理"
	middleware:       CheckTokenWare,InitCtxsWare
	defaultAuthType: "admin"
	defaultNeedAuth: "true"
)
//物联网平台通过定义一种物的描述语言来描述物模型模块和功能，称为TSL（Thing Specification Language）
service api {
	@doc (
		summary:    "导入产品物模型tsl"
		description: "业务说明：从TSL JSON格式导入产品物模型定义。TSL包含属性、事件、行为三种类型功能点。用于物模型批量迁移、模板导入"
		authType:   "admin"
		isNeedAuth: "true"
		group: "things/product/schema"
		resource: "things/product/schema"
		action: "import"
		recordLogMode: "1"
	)
	@handler tslImport
	post /tsl-import (ProductSchemaTslImportReq)

	@doc(
	    summary: "获取产品物模型tsl"
	    description: "业务说明：获取产品物模型的TSL JSON格式定义。TSL格式符合物联网平台物模型规范，用于物模型导出、第三方系统集成"
	    authType: "admin"
	    group: "things/product/schema"
	    resource: "things/product/schema"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler tslGetOne
	post /tsl-read (ProductSchemaTslGetOneReq) returns (ProductSchemaTslGetOneResp)

	@doc (
		summary:    "更新产品物模型"
		description: "业务说明：修改产品物模型功能点定义。支持更新名称、描述、数据类型、取值范围、读写属性等。标识符不可修改"
		authType:   "admin"
		isNeedAuth: "true"
		group: "things/product/schema"
		resource: "things/product/schema"
		action: "update"
		recordLogMode: "1"
	)
	@handler update
	post /update (ProductSchemaInfo)

	@doc (
		summary:    "创建产品物模型"
		description: "业务说明：为产品创建物模型功能点。功能类型：1=属性【传感器数据、状态参数】、2=事件【告警、故障上报】、3=行为【控制命令、服务调用】。定义标识符、数据类型、取值范围、读写属性等"
		authType:   "admin"
		isNeedAuth: "true"
		group: "things/product/schema"
		resource: "things/product/schema"
		action: "create"
		recordLogMode: "1"
	)
	@handler create
	post /create (ProductSchemaInfo)

	@doc (
		summary:    "批量创建产品物模型"
		description: "业务说明：批量创建产品物模型功能点。可通过标识符列表批量创建，或直接传入功能点定义列表。用于物模型快速初始化"
		authType:   "admin"
		isNeedAuth: "true"
		group: "things/product/schema"
		resource: "things/product/schema"
		action: "create"
		recordLogMode: "1"
	)
	@handler batchCreate
	post /batch-create (ProductSchemaBatchCreateReq)

	@doc (
		summary:    "删除产品物模型"
		description: "业务说明：删除产品物模型功能点。必选标签【tag=3】的功能点不可删除。删除后设备上报该标识符数据不再解析"
		authType:   "admin"
		isNeedAuth: "true"
		group: "things/product/schema"
		resource: "things/product/schema"
		action: "delete"
		recordLogMode: "1"
	)
	@handler delete
	post /delete (ProductSchemaDeleteReq)

	@doc(
	    summary: "获取产品物模型"
	    description: "业务说明：分页查询产品物模型功能点列表。支持按类型【属性、事件、行为】、标签【自定义、可选、必选】、标识符过滤。返回功能点定义详情包括数据类型、取值范围、读写属性、场景联动支持等"
	    authType: "admin"
	    group: "things/product/schema"
	    resource: "things/product/schema"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler getList
	post /get-list (ProductSchemaGetListReq) returns (ProductSchemaGetListResp)
}

type (
	ProductSchemaTslGetOneReq {
		ProductID string `json:"productID"` //产品id
	}
	ProductSchemaTslGetOneResp {
		Tsl string `json:"tsl"` //物模型tsl
	}
)

type (
	ProductSchemaTslImportReq {
		ProductID string `json:"productID"` //产品id 只读
		Tsl       string `json:"tsl"` //物模型tsl
	}
	ProductSchemaBatchCreateReq {
		ProductID   string               `json:"productID"` //产品id
		Identifiers []string             `json:"identifiers,optional"` //导入的标识符列表
		List        []*ProductSchemaInfo `json:"list,optional"` //如果没有填标识符列表取这里
	}
	ProductSchemaDeleteReq {
		ProductID  string `json:"productID"` //产品id
		Identifier string `json:"identifier"` //标识符
	}
	ProductSchemaGetListReq {
		Page              *PageInfo `json:"page,optional"` //分页信息,只获取一个则不填
		ProductID         string    `json:"productID"` //产品id
		Type              int64     `json:"type,optional"` //物模型类型 1:property属性 2:event事件 3:action行为
		Types             []int64   `json:"types,optional"`
		Tag               int64     `json:"tag,optional"` //过滤条件: 物模型标签 1:自定义 2:可选 3:必选
		Identifiers       []string  `json:"identifiers,optional"` //过滤标识符列表
		Name              string    `json:"name,optional"`
		IsCanSceneLinkage int64     `json:"isCanSceneLinkage,optional"` //是否可以场景联动
		FuncGroup         int64     `json:"funcGroup,optional"` // 功能分类: 1:普通功能 2:系统功能
		PropertyMode      string    `json:"propertyMode,optional"` //属性类型可用 读写类型: 1:r(只读) 2:rw(可读可写)
		ControlMode       int64     `json:"controlMode,optional"` //控制模式: 1: 可以群控,可以单控  2:只能单控
	}
	ProductSchemaGetListResp {
		List []*ProductSchemaInfo `json:"list"` //分页信息,只获取一个则不填
		PageResp
	}
)

type (
	/*物模型条目*/
	ProductSchemaInfo {
		ProductID    string  `json:"productID,optional"` //产品id 只读
		Type         int64   `json:"type"` //物模型类型 1:property属性 2:event事件 3:action行为
		Tag          int64   `json:"tag"` //物模型标签 1:自定义 2:可选 3:必选  必选不可删除
		Identifier   string  `json:"identifier"` //标识符
		ExtendConfig string  `json:"extendConfig,optional"` //拓展参数
		Name         *string `json:"name,optional"` //功能名称
		Desc         *string `json:"desc,optional"` //描述
		Required     int64   `json:"required,optional"` //是否必须 1:是 2:否
		/*
    Affordance 各功能类型的详细参数定义(JSON)。由字段 Type 决定其结构:

    1) Type=1 PropertyAffordance (属性能力)
       - isUseShadow: bool  是否使用设备影子。true: 设备离线写影子，在线直发
       - isNoRecord:  bool  是否不存储历史记录。true: 不落库，仅保留最新
       - define:      object 数据定义(Define)。描述数据类型、取值范围/枚举、单位、步进等
       - mode:        int    读写类型(PropertyMode)。1: r(只读) 2: rw(可读可写)
       - JSON 示例: {"isUseShadow":true,"isNoRecord":false,"define":{"type":"int","min":0,"max":100,"unit":"%"},"mode":2}

    2) Type=2 EventAffordance (事件能力)
       - type:   string  事件类型(EventType)。info/alert/fault
       - params: object  事件参数(Params)。键为参数名，值为参数定义(同 Define)
       - JSON 示例: {"type":"alert","params":{"code":{"type":"string"},"level":{"type":"enum","enum":["L1","L2","L3"]}}}

    3) Type=3 ActionAffordance (行为能力)
       - dir:    string  调用方向(ActionDir)。如 up/down
       - input:  object  调用入参(Params)。键为参数名，值为参数定义(同 Define)
       - output: object  返回出参(Params)。键为参数名，值为参数定义(同 Define)
       - JSON 示例: {"dir":"down","input":{"switch":{"type":"bool"}},"output":{"result":{"type":"int","enum":[0,1]}}}

    参考: things/share/domain/schema/affordance.go
    */
		Affordance        *string `json:"affordance,optional"`
		IsCanSceneLinkage int64   `json:"isCanSceneLinkage,optional"` //是否可以场景联动
		FuncGroup         int64   `json:"funcGroup,optional"` // 功能分类: 1:普通功能 2:系统功能
		// UserPerm int64 `json:"userPerm,optional"`//用户权限操作: 1:r(只读) 3:rw(可读可写)
		// RecordMode int64 `json:"recordMode,optional"`// 1(默认) 记录历史记录 2 只记录差异值 3 不记录历史记录
		// IsPassword int64 `json:"isPassword,optional"` //是否是密码类型,密码类型需要加掩码
		Order int64 `json:"order,optional"` // 排序
	// ControlMode int64 `json:"controlMode,optional"`//控制模式: 1: 可以群控,可以单控  2:只能单控
	//        Event *SchemaEvent `json:"event,optional"`           //事件参数定义
	//        Property *SchemaProperty `json:"property,optional"`  //属性参数定义
	//        Action *SchemaAction `json:"action,optional"`        //行为参数定义
	}
	SchemaAction {
		Input  []*SchemaParam `json:"input,optional"` //调用参数
		Output []*SchemaParam `json:"output,optional"` //返回参数
	}
	SchemaProperty {
		Mode   string        `json:"mode,optional"` //读写类型: r(只读) rw(可读可写)
		Define *SchemaDefine `json:"define"` //参数定义
	}
	SchemaEvent {
		Type   string         `json:"type"` //事件类型: 信息:info  告警alert  故障:fault
		Params []*SchemaParam `json:"params,optional"` //事件参数
	}
)
