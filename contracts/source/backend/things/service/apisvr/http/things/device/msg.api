info (
	title:   "数据交互"
	desc:    "数据交互"
	author:  "杨磊"
	email:   "603685348@qq.com"
	version: "v1"
)

@server (
	group:            things/device/msg
	prefix:           /api/v1/things/device/msg
	middleware:       CheckTokenWare,InitCtxsWare
	defaultAuthType: "admin"
	defaultNeedAuth: "true"
	accessCodePrefix: "thingsDeviceMsg"
	accessNamePrefix: "设备消息"
	accessGroup:      "设备消息"
)
service api {
	@doc(
	    summary: "获取云端诊断日志"
	    description: "查询设备与云端交互的通信日志，包括MQTT连接/断开、消息发布/订阅、物模型上报/下发等操作的详细记录。用于设备调试、问题排查、通信异常分析。支持按时间范围、操作类型、主题、内容等条件过滤。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler hubLogGetList
	post /hub-log/get-list (DeviceMsgHubLogGetListReq) returns (DeviceMsgHubLogGetListResp)

	@doc(
	    summary: "获取设备状态日志"
	    description: "查询设备的在线/离线状态变更历史记录。记录设备每次上线、下线的时间戳和状态。用于分析设备连接稳定性、掉线原因排查。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler statusLogGetList
	post /status-log/get-list (DeviceMsgStatusLogGetListReq) returns (DeviceMsgStatusLogGetListResp)

	@doc(
	    summary: "获取设备命令日志"
	    description: "查询向设备下发的控制命令历史记录，包括属性控制、行为调用、获取属性请求等操作。记录命令发送者、发送时间、命令内容、执行结果等。用于追溯设备操作历史、排查命令执行失败原因。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler sendLogGetList
	post /send-log/get-list (DeviceMsgSendLogGetListReq) returns (DeviceMsgSendLogGetListResp)

	@doc(
	    summary: "获取设备异常日志"
	    description: "查询设备异常告警历史记录，包括设备触发的各类异常事件（如频繁上下线、通信超时、数据异常等）。记录异常触发时间、类型、原因、解除时间。用于设备异常监控、故障预警。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler abnormalLogGetList
	post /abnormal-log/get-list (DeviceMsgAbnormalLogGetListReq) returns (DeviceMsgAbnormalLogGetListResp)

	@doc(
	    summary: "获取设备sdk日志"
	    description: "查询设备端SDK上报的日志信息，包括设备运行状态、调试信息、错误日志等。用于远程诊断设备端问题、分析设备运行状态。设备需配置日志上报级别（关闭/错误/告警/信息/调试）。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler sdkLogGetList
	post /sdk-log/get-list (DeviceMsgSdkLogGetListReq) returns (DeviceMsgSdkGetListResp)

	@doc(
	    summary: "获取单个id属性历史记录"
	    description: "查询设备指定属性标识符的历史上报数据。支持按时间范围、分页查询，可选择是否进行时间窗口聚合（如按小时/天聚合）。用于查看属性变化趋势、数据分析、报表生成。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler propertyLogGetList
	post /property-log/get-list (DeviceMsgPropertyLogGetListReq) returns (DeviceMsgPropertyGetListResp)

	@doc(
	    summary: "弃用"
	    description: "该接口已弃用，请使用 propertyLogAggGetList 替代。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler propertyAggGetList
	post /property-agg/get-list (DeviceMsgPropertyLogAggGetListReq) returns (DeviceMsgPropertyLogAggGetListResp)

	@doc(
	    summary: "弃用"
	    description: "该接口已弃用，请使用 propertyLogAggByDeviceGetList 替代。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler propertyAggByDeviceGetList
	post /property-agg/by-device/get-list (DeviceMsgPropertyAggByDeviceGetListReq) returns (DeviceMsgPropertyLogAggGetListResp)

	@doc(
	    summary: "聚合属性历史记录"
	    description: "查询设备属性历史数据的聚合统计结果。支持按时间窗口（秒/分/时/天）聚合，可指定聚合函数（avg平均值、first首值、last末值、count计数、twa时间加权平均）。用于数据趋势分析、统计报表。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler propertyLogAggGetList
	post /property-log-agg/get-list (DeviceMsgPropertyLogAggGetListReq) returns (DeviceMsgPropertyLogAggGetListResp)

	@doc(
	    summary: "聚合属性历史记录,设备维度"
	    description: "批量查询多个设备的属性历史聚合统计结果。支持按设备维度分组聚合，适用于批量数据分析、多设备对比分析场景。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler propertyLogAggByDeviceGetList
	post /property-log-agg/by-device/get-list (DeviceMsgPropertyAggByDeviceGetListReq) returns (DeviceMsgPropertyLogAggGetListResp)

	@doc(
	    summary: "聚合属性最新值"
	    description: "获取设备属性最新值的聚合统计结果。支持跨设备聚合（如多设备平均值），用于实时监控大屏、批量设备状态概览。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler propertyLatestAggGetList
	post /property-latest-agg/get-list (DeviceMsgPropertyLatestAggGetListReq) returns (DeviceMsgPropertyLatestAggGetListResp)

	@doc(
	    summary: "批量获取单个id属性历史记录"
	    description: "批量查询多个时间范围或多个属性标识符的历史数据。适用于需要一次性获取多组数据的场景，减少接口调用次数。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler propertyLogBatchGetList
	post /property-log/batch-get-list (DeviceMsgPropertyLogBatchGetListReq) returns (DeviceMsgPropertyBatchGetListResp)

	@doc(
	    summary: "弃用"
	    description: "该接口已弃用，请使用 propertyLatestGetList 替代。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler propertyLogLatestGetList
	post /property-log-latest/get-list (DeviceMsgPropertyLatestGetListReq) returns (DeviceMsgPropertyGetListResp)

	@doc(
	    summary: "获取最新属性记录"
	    description: "获取设备属性的最新上报值。可指定获取全部属性或指定属性标识符列表。用于实时状态展示、设备监控面板、属性快捷查询。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler propertyLatestGetList
	post /property-latest/get-list (DeviceMsgPropertyLatestGetListReq) returns (DeviceMsgPropertyGetListResp)

	@doc(
	    summary: "获取事件历史记录"
	    description: "查询设备上报的事件历史记录，包括信息事件（info）、告警事件（alert）、故障事件（fault）。用于事件追溯、告警分析、故障排查。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler eventLogGetList
	post /event-log/get-list (DeviceMsgEventLogGetListReq) returns (DeviceMsgEventLogGetListResp)

	@doc(
	    summary: "获取设备影子列表"
	    description: "获取设备影子（Device Shadow）数据。设备影子是云端存储的设备状态副本，用于设备离线时记录期望状态，设备上线后同步。支持查询属性的期望值和实际值、同步状态。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler shadowGetList
	post /shadow/get-list (DeviceMsgPropertyLatestGetListReq) returns (DeviceMsgShadowGetListResp)

	@doc(
	    summary: "获取网关可以绑定的子设备列表"
	    description: "查询指定网关可绑定的子设备候选列表。用于网关添加子设备的场景，返回该网关产品配置允许接入的子设备产品类型下的未绑定设备。"
	    authType: "admin"
	    group: "things/device/msg"
	    resource: "things/device/msg"
	    action: "view"
	    recordLogMode: "1"
	)
	@handler gatewayCanBindGetList
	post /gateway-can-bind/get-list (GatewayCanBindGetListReq) returns (GatewayCanBindGetListResp)
}

type (
	GatewayCanBindGetListReq {
		Gateway *DeviceCore `json:"gateway"` //如果是不同的产品,则传这个字段,上面两个参数填了优先使用
	}
	GatewayCanBindGetListResp {
		SubDevices  []*DeviceCore `json:"subDevices"` //如果是不同的产品,则传这个字段,上面两个参数填了优先使用
		UpdatedTime int64         `json:"updatedTime"` //
	}
	DeviceMsgShadowIndex {
		DataID            string `json:"dataID"` //属性id
		Value             string `json:"value"` //获取到的值
		UpdatedDeviceTime int64  `json:"updatedDeviceTime"` //更新到设备的时间
	}
	DeviceMsgShadowGetListResp {
		List []*DeviceMsgShadowIndex `json:"list"`
	}
	DeviceMsgHubLogGetListReq {
		DeviceName string    `json:"deviceName,optional,omitempty"` //设备名
		ProductID  string    `json:"productID,optional,omitempty"` //产品id 获取产品id下的所有设备信息
		TimeStart  int64     `json:"timeStart,string,optional,omitempty"` //获取时间的开始(毫秒时间戳)
		TimeEnd    int64     `json:"timeEnd,string,optional,omitempty"` //时间的结束(毫秒时间戳)
		Page       *PageInfo `json:"page,optional"` //分页信息
		Actions    []string  `json:"actions,optional"` //过滤操作类型 connected:上线 disconnected:下线  property:属性 event:事件 action:操作 thing:物模型提交的操作为匹配的日志
		Topics     []string  `json:"topics,optional"` //过滤主题
		Content    string    `json:"content,optional"` //过滤内容
		RequestID  string    `json:"requestID,optional"` //过滤请求ID
	}
	DeviceMsgHubLogGetListResp {
		List []*DeviceMsgHubLogInfo `json:"list"` //数据
		PageResp
	}
	DeviceMsgHubLogInfo {
        ReceivedTime int64 `json:"receivedTime"` // 平台接收时间，毫秒；历史未知为0

		Timestamp   int64  `json:"timestamp,string"` //发生时间戳(毫秒时间戳)
		Action      string `json:"action"` //connected:上线 disconnected:下线  property:属性 event:事件 action:操作 thing:物模型提交的操作为匹配的日志
		RequestID   string `json:"requestID"`
		TraceID     string `json:"traceID"`
		Topic       string `json:"topic"`
		Content     string `json:"content"`
		ResultCode  int64  `json:"resultCode,string"`
		RespPayload string `json:"respPayload"`
	}
	DeviceMsgSendLogGetListReq {
		ProductCategoryID   int64     `json:"productCategoryID,string,optional"` //只有管理员有权限
		ProductCategoryCode string   `json:"productCategoryCode,optional"` //品类编码
		ProjectID         int64     `json:"projectID,string,optional,omitempty"` //只有管理员有权限
		AreaID            int64     `json:"areaID,string,optional,omitempty"` //只有管理员有权限
		AreaIDPath        string    `json:"areaIDPath,optional,omitempty"` //只有管理员有权限
		AreaIDs           []int64   `json:"areaIDs,string,optional,omitempty"` //只有管理员有权限
		GroupIDPaths      []string  `json:"groupIDPaths,optional,omitempty"` //只有管理员有权限
		GroupIDs          []int64   `json:"groupIDs,string,optional,omitempty"` //只有管理员有权限
		ProductID         string    `json:"productID,optional"` //产品id
		DeviceName        string    `json:"deviceName,optional"` //设备名
		TimeStart         int64     `json:"timeStart,string,optional"` //获取时间的开始(毫秒时间戳)
		TimeEnd           int64     `json:"timeEnd,string,optional"` //时间的结束(毫秒时间戳)
		Page              *PageInfo `json:"page,optional"` //分页信息
		UserID            int64     `json:"userID,string,optional"`
		Actions           []string  `json:"actions,optional"`
		ResultCode        int64     `json:"resultCode,optional"` //请求结果状态,200为成功
		DataID            string    `json:"dataID,optional"` //模糊查询
		DataIDs           []string  `json:"dataIDs,optional"` //精确查询
		WithUser          bool      `json:"withUser,optional"` //同时返回用户信息
	}
	DeviceMsgSendLogGetListResp {
		List []*DeviceMsgSendLogInfo `json:"list"` //数据
		PageResp
	}
	DeviceMsgSendLogInfo {
		Timestamp  int64     `json:"timestamp,string,optional"` //发生时间戳(毫秒时间戳)
		Account    string    `json:"account,optional"`
		UserID     int64     `json:"userID,string,optional"` //
		ProductID  string    `json:"productID,optional"` //
		DeviceName string    `json:"deviceName,optional"` //
		Action     string    `json:"action,optional"` //操作类型 propertySend:属性控制 actionSend:操作控制 propertyGetReportSend:获取最新属性请求
		DataID     string    `json:"dataID,optional"` //identify
		TraceID    string    `json:"traceID,optional"` //服务器端事务id
		Content    string    `json:"content,optional"` //操作的内容
		ResultCode int64     `json:"resultCode,optional"` //请求结果状态,200为成功
		User       *UserCore `json:"user,optional,omitempty"`
	}
	DeviceMsgAbnormalLogGetListReq {
		ProductCategoryID   int64              `json:"productCategoryID,string,optional"` //只有管理员有权限
		ProductCategoryCode string             `json:"productCategoryCode,optional"` //品类编码
		ProjectID         int64              `json:"projectID,string,optional,omitempty"` //只有管理员有权限
		AreaID            int64              `json:"areaID,string,optional,omitempty"` //只有管理员有权限
		AreaIDPath        string             `json:"areaIDPath,optional,omitempty"` //只有管理员有权限
		AreaIDs           []int64            `json:"areaIDs,string,optional,omitempty"` //只有管理员有权限
		BelongGroup       map[string]IDsInfo `json:"belongGroup,optional,omitempty"` //key是group的purpose, value是里面包含的分组id 只有partitionBy 传该参数的时候才会返回
		ProductID         string             `json:"productID,optional"` //产品id
		DeviceName        string             `json:"deviceName,optional"` //设备名
		TimeStart         int64              `json:"timeStart,string,optional"` //获取时间的开始(毫秒时间戳)
		TimeEnd           int64              `json:"timeEnd,string,optional"` //时间的结束(毫秒时间戳)
		Page              *PageInfo          `json:"page,optional"` //分页信息
		User              *UserCore          `json:"user,optional,omitempty"`
		Type              string             `json:"type,optional"` //异常类型
		Action            int64              `json:"action,optional"` //触发1 还是解除2
	}
	DeviceMsgAbnormalLogGetListResp {
		List []*DeviceMsgAbnormalLogInfo `json:"list"` //数据
		PageResp
	}
	DeviceMsgAbnormalLogInfo {
		Timestamp  int64  `json:"timestamp,string,optional"` //发生时间戳(毫秒时间戳)
		ProductID  string `json:"productID,optional"` //
		DeviceName string `json:"deviceName,optional"` //
		Action     int64  `json:"action,optional"` //触发1 还是解除2
		Type       string `json:"type,optional"` //异常类型
		TraceID    string `json:"traceID,optional"` //服务器端事务id
		Reason     string `json:"reason,optional"` //原因
	}
	DeviceMsgStatusLogGetListReq {
		ProductID  string    `json:"productID,optional"` //产品id
		DeviceName string    `json:"deviceName,optional"` //设备名
		TimeStart  int64     `json:"timeStart,string,optional"` //获取时间的开始(毫秒时间戳)
		TimeEnd    int64     `json:"timeEnd,string,optional"` //时间的结束(毫秒时间戳)
		Page       *PageInfo `json:"page,optional"` //分页信息
		Status     int64     `json:"status,optional"` //在线状态
	}
	DeviceMsgStatusLogGetListResp {
		List []*DeviceMsgStatusLogInfo `json:"list"` //数据
		PageResp
	}
	DeviceMsgStatusLogInfo {
		Timestamp  int64  `json:"timestamp,optional,string"` //发生时间戳(毫秒时间戳)
		Status     int64  `json:"status,optional"` //过滤请求ID
		DeviceName string `json:"deviceName,omitempty"`
		ProductID  string `json:"productID,omitempty"`
	}
)

type (
	DeviceMsgSdkLogGetListReq {
		DeviceName string    `json:"deviceName,omitempty"` //设备名
		ProductID  string    `json:"productID,omitempty"` //产品id 获取产品id下的所有设备信息
		TimeStart  int64     `json:"timeStart,string,optional,omitempty"` //获取时间的开始(毫秒时间戳)
		TimeEnd    int64     `json:"timeEnd,string,optional,omitempty"` //时间的结束(毫秒时间戳)
		LogLevel   int       `json:"logLevel,optional"` //等级
		Page       *PageInfo `json:"page,optional"` //分页信息
	}
	DeviceMsgSdkGetListResp {
		List []*DeviceMsgSdkInfo `json:"list"` //数据
		PageResp
	}
	DeviceMsgSdkInfo {
		Timestamp int64  `json:"timestamp,string"` //发生时间戳(毫秒时间戳)
		Loglevel  int64  `json:"loglevel"` //日志级别 1)关闭 2)错误 3)告警 4)信息 5)调试
		Content   string `json:"content"` //具体内容
	}
)

type (
	DeviceMsgPropertyLatestAggGetListReq {
		TenantCode        string                  `json:"tenantCode,optional,omitempty"` //只有管理员有权限
		ProjectID         int64                   `json:"projectID,string,optional,omitempty"` //只有管理员有权限
		AreaID            int64                   `json:"areaID,string,optional,omitempty"` //只有管理员有权限
		AreaIDPath        string                  `json:"areaIDPath,optional,omitempty"` //只有管理员有权限
		AreaIDs           []int64                 `json:"areaIDs,string,optional,omitempty"` //只有管理员有权限
		BelongGroup       map[string]IDsInfo      `json:"belongGroup,optional,omitempty"` //key是group的purpose, value是里面包含的分组id 只有partitionBy 传该参数的时候才会返回
		DeviceName        string                  `json:"deviceName,optional,omitempty"` //设备名(不填获取产品下所有设备)
		DeviceNames       []string                `json:"deviceNames,optional,omitempty"` //设备名(不填获取产品下所有设备,只有管理员有权限)
		ProductID         string                  `json:"productID,omitempty,optional"` //产品id 获取产品id下的所有设备信息
		ProductCategoryID   int64                   `json:"productCategoryID,string,optional"` //产品品类id,通用物模型有效
		ProductCategoryCode string                  `json:"productCategoryCode,optional"` //品类编码
		PartitionBy       string                  `json:"partitionBy,optional"` //切分数据,可以填写deviceName
		Aggs              []*DeviceMsgPropertyAgg `json:"aggs"` //聚合对象
	}
	DeviceMsgPropertyAggCore {
		DataID   string   `json:"dataID,omitempty"` //获取的具体标识符的数据
		ArgFuncs []string `json:"argFuncs"` //聚合函数 avg:平均值 first:第一个参数 last:最后一个参数 count:总数 twa: 时间加权平均函数 参考: https://docs.taosdata.com/reference/taos-sql/function/#apercentile
	}
	DeviceMsgPropertyLatestAggGetListResp {
		List []*DeviceMsgPropertyLatestAggResp `json:"list"`
	}
	DeviceMsgPropertyLatestAggResp {
		ProductID   string                                  `json:"productID,omitempty"`
		DeviceName  string                                  `json:"deviceName,omitempty"` //设备名称
		TenantCode  string                                  `json:"tenantCode,optional,omitempty"` //只有partitionBy 传该参数的时候才会返回
		ProjectID   int64                                   `json:"projectID,string,optional,omitempty"` //只有partitionBy 传该参数的时候才会返回
		AreaID      int64                                   `json:"areaID,string,optional,omitempty"` //只有partitionBy 传该参数的时候才会返回
		AreaIDPath  string                                  `json:"areaIDPath,optional,omitempty"` //只有partitionBy 传该参数的时候才会返回
		AreaIDs     []int64                                 `json:"areaIDs,string,optional,omitempty"` //只有partitionBy 传该参数的时候才会返回
		BelongGroup map[string]IDsInfo                      `json:"belongGroup,optional,omitempty"` //key是group的purpose, value是里面包含的分组id 只有partitionBy 传该参数的时候才会返回
		Values      []*DeviceMsgPropertyLatestAggRespDetail `json:"values"`
	}
	DeviceMsgPropertyLatestAggRespDetail {
		DataID   string            `json:"dataID"` //属性ID
		DataName string            `json:"dataName"` //属性名称
		values   map[string]*string `json:"values"` //key是聚合函数
	}
	DeviceMsgPropertyLogAggGetListReq {
		TenantCode        string                  `json:"tenantCode,optional,omitempty"` //只有管理员有权限
