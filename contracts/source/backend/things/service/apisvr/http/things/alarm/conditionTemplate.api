info (
	title:   "告警触发条件模板"
	desc:    "告警触发条件模板"
	author:  "杨磊"
	email:   "603685348@qq.com"
	version: "v1"
)

import "alarmCommon.api"

@server (
	group:            things/alarm/conditionTemplate
	prefix:           /api/v1/things/alarm/condition-template
	accessCodePrefix: "thingsAlarmConditionTemplate"
	accessNamePrefix: "触发条件模板"
	accessGroup:      "规则引擎"
	middleware:       CheckTokenWare,InitCtxsWare
	defaultAuthType: "admin"
	defaultNeedAuth: "true"
)
service api {
	@doc(
    summary: "创建触发条件模板"
    description: "创建触发条件模板"
    resource: "things/alarm/conditionTemplate"
    action: "create"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/conditionTemplate"
)
	@handler create
	post /create (AlarmConditionTemplateCreateReq) returns (AlarmInfoWithID)

	@doc(
    summary: "更新触发条件模板"
    description: "更新触发条件模板"
    resource: "things/alarm/conditionTemplate"
    action: "update"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/conditionTemplate"
)
	@handler update
	post /update (AlarmConditionTemplateUpdateReq) returns (ShareEmpty)

	@doc(
    summary: "删除触发条件模板"
    description: "删除触发条件模板"
    resource: "things/alarm/conditionTemplate"
    action: "delete"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/conditionTemplate"
)
	@handler delete
	post /delete (AlarmInfoWithID) returns (ShareEmpty)

	@doc(
    summary: "获取触发条件模板详情"
    description: "获取触发条件模板详情"
    resource: "things/alarm/conditionTemplate"
    action: "view"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/conditionTemplate"
)
	@handler getOne
	post /get-one (AlarmInfoWithID) returns (AlarmConditionTemplate)

	@doc(
    summary: "获取触发条件模板列表"
    description: "获取触发条件模板列表"
    resource: "things/alarm/conditionTemplate"
    action: "view"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/conditionTemplate"
)
	@handler getList
	post /get-list (AlarmConditionTemplateGetListReq) returns (AlarmConditionTemplateGetListResp)
}

type AlarmConditionTemplateCreateReq {
	Name              string   `json:"name"`                       // 名称
	Desc              string   `json:"desc,optional"`              // 描述
	ProductID         string   `json:"productID,optional"`         // 产品ID
	ProductCategoryID string   `json:"productCategoryID,optional"` // 产品品类ID
	If                *AlarmIf `json:"if,optional"`                // 触发条件
}

type AlarmConditionTemplateUpdateReq {
	Id                int64    `json:"id,string"`                  // ID
	Name              string   `json:"name,optional"`              // 名称
	Desc              string   `json:"desc,optional"`              // 描述
	ProductID         string   `json:"productID,optional"`         // 产品ID
	ProductCategoryID string   `json:"productCategoryID,optional"` // 产品品类ID
	If                *AlarmIf `json:"if,optional"`                // 触发条件
	Status            int64    `json:"status,optional"`            // 状态
}

type AlarmConditionTemplateGetListReq {
	Page              *PageInfo `json:"page,optional"`             // 分页
	Keyword           string    `json:"keyword,optional"`          // 名称模糊搜索
	ProductID         string    `json:"productID,optional"`        // 产品ID
	ProductCategoryID string    `json:"productCategoryID,optional"` // 产品品类ID
	Status            int64     `json:"status,optional"`           // 状态
}

type AlarmConditionTemplateGetListResp {
	List []*AlarmConditionTemplate `json:"list"` // 模板列表
	PageResp
}
