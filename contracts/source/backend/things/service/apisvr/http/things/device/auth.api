info(
    title: "认证管理(p2)"
    desc: "认证管理(p2)"
    author: "杨磊"
    email: "603685348@qq.com"
    version: "v1"
)

@server(
    group: things/device/auth
    prefix: /api/v1/things/device/auth
    middleware:  InitCtxsWare
)
service api {
    @doc(
        summary: "设备登录认证"
        description: "MQTT Broker的设备登录认证接口。设备连接MQTT时，Broker调用此接口验证设备身份（用户名+密码或证书）。验证成功后设备获得连接权限，否则连接被拒绝。用于EMQX等MQTT Broker的认证钩子。"
        authType: "device"
        group: "things/device/auth"
        resource: "things/device/auth"
        action: "login"
        recordLogMode: "1"
    )
    @handler login
    post /login (DeviceAuthLoginReq) returns ()
    @doc(
        summary: "设备操作认证"
        description: "MQTT Broker的设备发布/订阅操作认证接口。设备进行MQTT发布或订阅时，Broker调用此接口验证操作权限。检查设备是否有权限访问指定主题。用于EMQX等MQTT Broker的ACL钩子。"
        authType: "device"
        group: "things/device/auth"
        resource: "things/device/auth"
        action: "access"
        recordLogMode: "1"
    )
    @handler access
    post /access (DeviceAuthAccessReq) returns ()
    @doc(
        summary: "鉴定是否是root账号"
        description: "检查设备认证账号是否为root超级账号。root账号拥有最高权限，可订阅所有主题、执行所有操作。用于区分普通设备和调试设备、管理设备的权限级别。"
        authType: "device"
        group: "things/device/auth"
        resource: "things/device/auth"
        action: "view"
        recordLogMode: "1"
    )
    @handler rootCheck
    post /root-check (DeviceAuthRootCheckReq) returns ()
    @doc(
        summary: "设备自动注册"
        description: "设备动态注册接口，用于设备首次连接时自动创建设备记录。设备使用产品秘钥进行签名认证，验证通过后返回设备秘钥（PSK）或证书。适用于产品配置了动态注册功能，设备无需预先创建即可接入的场景。"
        authType: "device"
        group: "things/device/auth"
        resource: "things/device/auth"
        action: "create"
        recordLogMode: "1"
    )
    @handler register
    post /register (DeviceRegisterReq) returns (DeviceRegisterResp)
}


type DeviceAuthLoginReq  {
    Username string `json:"username"`                          //用户名
    Password string `json:"password,optional"`                 //密码
    ClientID string `json:"clientID"`                          //clientID
    Ip string `json:"ip"`                                      //访问的ip地址
    Certificate string `json:"certificate,optional,omitempty"` //客户端证书 base64后传过来
}

type DeviceAuthAccessReq  {
    Username string `json:"username,omitempty"`//用户名
    Topic string `json:"topic,omitempty"`      //主题
    ClientID string `json:"clientID,omitempty"`//clientID
    Access string `json:"access,omitempty"`    //操作
    Ip string `json:"ip,omitempty"`            //访问的ip地址
}

type DeviceAuthRootCheckReq  {
    Username string `json:"username,omitempty"`                //用户名
    Password string `json:"password,optional,omitempty"`       //密码
    ClientID string `json:"clientID,omitempty"`                //clientID
    Ip string `json:"ip,omitempty"`                            //访问的ip地址
    Certificate []byte `json:"certificate,optional,omitempty"` //客户端证书
}

type DeviceRegisterReq  {
    ProductID string `json:"productId"`                             //产品id 只读
    DeviceName string `json:"deviceName"`                          //设备名称 读写
    Nonce int64 `json:"nonce"`                                     //随机数
    Timestamp int64 `json:"timestamp"`                             //秒级时间戳
    Signature string `json:"signature"`                            //签名信息
    RetEnc string `json:"retEnc,optional,omitempty"`               //返回使用的加密方式: aes128cbc(默认) aes128ecb
    TenantCode string `json:"tenantCode,optional,omitempty"`       //租户号（可选）：产品为common租户或租户号与产品一致时生效
    DeviceAlias string `json:"deviceAlias,optional,omitempty"`     //设备别名（可选）：注册成功后写入设备别名，仅新注册及未激活设备生效
    RemoteAddr string `json:"remoteAddr,optional,omitempty"`       //远程访问地址（可选）：注册成功后写入设备远程访问地址，仅新注册及未激活设备生效
    Tags map[string]string `json:"tags,optional,omitempty"`        //设备标签（可选）：注册成功后写入设备标签，仅新注册及未激活设备生效
}

type DeviceRegisterResp  {
    Len int64  `json:"len"`   //payload加密前信息的长度
    /*
    加密过程将原始 JSON 格式的 payload 转为字符串后进行 AES 加密，再进行 base64 加密。AES 加密算法为 CBC 模式，密钥长度128，取 productSecret 前16位，偏移量为长度16的字符“0”。
    原始 payload 内容说明：
    key                value               描述
    encryptionType     1              加密类型，1表示证书认证，2表示签名认证。
    psk                1239           设备密钥，当产品认证类型为签名认证时有此参数
    clientCert         -              设备证书文件字符串格式，当产品认证类型为证书认证时有此参数。
    clientKey          -              设备私钥文件字符串格式，当产品认证类型为证书认证时有此参数。
    */
    Payload string `json:"payload"`
}