info (
	title:   "ota升级作业接口"
	desc:    "ota升级作业接口"
	author:  "Hya"
	email:   "1943965929@qq.com"
	version: "v1"
)

@server (
	group:             things/ota/firmware/device
	prefix:            /api/v1/things/ota/firmware/device
	middleware:        CheckTokenWare,InitCtxsWare
	accessCodePrefix:  "thingsOtaDevice"
	accessNamePrefix:  "设备"
	accessGroup:       "ota远程升级"
	defaultIsNeedAuth: "true"
	defaultAuthType:   "admin"
)
service api {
	//查询指定升级批次下的设备升级作业列表
	@doc (
		summary:      "查询升级设备列表"
		description:  "业务说明：查询指定OTA升级任务批次中各设备的升级作业状态。返回设备升级详情（目标版本、当前版本、升级进度、状态、是否在线等），支持按设备名称、状态、版本号过滤。用于监控批量升级进度、排查升级失败的设备、查看整体升级成功率。"
		authType:     "admin"
		isNeedAuth:   "true"
		operType: "find"
		group: "things/ota/firmware/device"
		resource: "things/ota/firmware/device"
		action: "view"
		recordLogMode: "1"
	)
	@handler getList
	post /get-list (OtaFirmwareDeviceGetListReq) returns (OtaFirmwareDeviceGetListResp)

	@doc (
		summary:      "取消指定任务下的升级"
		description:  "业务说明：取消指定升级批次中部分设备的OTA升级任务。支持批量取消多个设备的升级作业。取消后设备状态变为【已取消】，不再接收升级推送。适用于：设备升级失败需暂停、临时停止特定设备升级、调整升级范围时移除部分设备。注意：已进入【升级中】状态的设备可能无法立即取消。"
		authType:     "admin"
		isNeedAuth:   "true"
		operType: "find"
		group: "things/ota/firmware/device"
		resource: "things/ota/firmware/device"
		action: "delete"
		recordLogMode: "1"
	)
	@handler cancel
	post /cancel (OtaFirmwareDeviceCancelReq)

	@doc (
		summary:      "重试设备升级"
		description:  "业务说明：重新触发升级失败的设备执行OTA升级。支持批量重试多个设备。重试后设备状态从【升级失败】变为【待推送】，系统会重新推送升级包下载地址。适用于：因网络波动、设备临时离线导致的升级失败，在设备恢复在线后重新执行升级。重试次数受批次配置的重试次数限制。"
		authType:     "admin"
		isNeedAuth:   "true"
		operType: "find"
		group: "things/ota/firmware/device"
		resource: "things/ota/firmware/device"
		action: "update"
		recordLogMode: "1"
	)
	@handler retry
	post /retry (OtaFirmwareDeviceRetryReq)

	@doc (
		summary: "确认升级设备"
		description: "业务说明：设备侧确认接收OTA升级任务。当升级批次配置为【需要确认】模式时，设备需通过此接口确认后才可获取升级包信息。确认后设备状态从【待确认】变为【待推送】。适用于：需要人工审核或设备主动确认后才执行升级的场景，如关键设备升级需运维人员确认。"
		authType: "admin"
		group: "things/ota/firmware/device"
		resource: "things/ota/firmware/device"
		action: "update"
		recordLogMode: "1"
	)
	@handler confirm
	post /confirm (OtaFirmwareDeviceConfirmReq)
}

// OTATaskByJobGetListReq 表示根据作业索引的OTA任务请求。
type OtaFirmwareDeviceGetListReq {
	Page       *PageInfo `json:"page,optional"` // 分页信息
	JobID      int64     `json:"jobID,string,optional"` // 作业ID
	FirmwareID int64     `json:"firmwareID,string,optional"` // 任务状态
	DeviceName string    `json:"deviceName,optional"` // 设备名称
	SrcVersion string    `json:"srcVersion,optional"`
	Status     int64     `json:"status,optional"` //设备升级作业状态。1：待确认。 2：待推送。 3：已推送。  4：升级中。 5:升级成功 6: 升级失败. 7:已取消
	IsOnline   int64     `json:"isOnline,optional"` //设备是否在线
}

type OtaFirmwareDeviceConfirmReq {
	ProductID  string `json:"productID"`
	DeviceName string `json:"deviceName"`
}

// OtaUpTaskInfo 表示OTA任务的信息。
type OtaFirmwareDeviceInfo {
	ID          int64  `json:"id,string"`
	FirmwareID  int64  `json:"firmwareID,string"`
	JobID       int64  `json:"jobID,string"`
	ProductID   string `json:"productID"`
	ProductName string `json:"productName"`
	DeviceName  string `json:"deviceName"`
	SrcVersion  string `json:"srcVersion"`
	DestVersion string `json:"destVersion"`
	Step        int64  `json:"step"`
	Detail      string `json:"detail"`
	Status      int64  `json:"status"`
	CreatedTime int64  `json:"createdTime,string"`
	UpdatedTime int64  `json:"updatedTime"`
	IsOnline    int64  `json:"isOnline,optional"` //设备是否在线
}

type OtaFirmwareDeviceGetListResp {
	List []*OtaFirmwareDeviceInfo `json:"list"` // OTA任务信息列表
	PageResp
}

// OTATaskByJobCancelReq 表示根据作业取消的OTA任务请求。
type OtaFirmwareDeviceCancelReq {
	FirmwareID  int64    `json:"firmwareID,string"`
	JobID       int64    `json:"jobID,string"`
	DeviceNames []string `json:"deviceNames"`
}

// OTATaskByDeviceCancelReq 表示根据设备取消的OTA任务请求。
type OtaFirmwareDeviceRetryReq {
	FirmwareID  int64    `json:"firmwareID,string"`
	JobID       int64    `json:"jobID,string"`
	DeviceNames []string `json:"deviceNames"`
}
