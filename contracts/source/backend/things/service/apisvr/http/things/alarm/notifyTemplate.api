info (
	title:   "告警通知内容模板"
	desc:    "告警通知内容模板"
	author:  "杨磊"
	email:   "603685348@qq.com"
	version: "v1"
)

import "alarmCommon.api"

@server (
	group:            things/alarm/notifyTemplate
	prefix:           /api/v1/things/alarm/notify-template
	accessCodePrefix: "thingsAlarmNotifyTemplate"
	accessNamePrefix: "通知内容模板"
	accessGroup:      "规则引擎"
	middleware:       CheckTokenWare,InitCtxsWare
	defaultAuthType: "admin"
	defaultNeedAuth: "true"
)
service api {
	@doc(
    summary: "创建通知内容模板"
    description: "创建通知内容模板"
    resource: "things/alarm/notifyTemplate"
    action: "create"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/notifyTemplate"
)
	@handler create
	post /create (AlarmNotifyTemplateCreateReq) returns (AlarmInfoWithID)

	@doc(
    summary: "更新通知内容模板"
    description: "更新通知内容模板"
    resource: "things/alarm/notifyTemplate"
    action: "update"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/notifyTemplate"
)
	@handler update
	post /update (AlarmNotifyTemplateUpdateReq) returns (ShareEmpty)

	@doc(
    summary: "删除通知内容模板"
    description: "删除通知内容模板"
    resource: "things/alarm/notifyTemplate"
    action: "delete"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/notifyTemplate"
)
	@handler delete
	post /delete (AlarmInfoWithID) returns (ShareEmpty)

	@doc(
    summary: "获取通知内容模板详情"
    description: "获取通知内容模板详情"
    resource: "things/alarm/notifyTemplate"
    action: "view"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/notifyTemplate"
)
	@handler getOne
	post /get-one (AlarmInfoWithID) returns (AlarmNotifyTemplate)

	@doc(
    summary: "获取通知内容模板列表"
    description: "获取通知内容模板列表"
    resource: "things/alarm/notifyTemplate"
    action: "view"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/notifyTemplate"
)
	@handler getList
	post /get-list (AlarmNotifyTemplateGetListReq) returns (AlarmNotifyTemplateGetListResp)

	@doc(
    summary: "测试发送通知"
    description: "测试发送通知"
    resource: "things/alarm/notifyTemplate"
    action: "create"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/notifyTemplate"
)
	@handler testSend
	post /test-send (AlarmNotifyTemplateTestSendReq) returns (ShareEmpty)
}

type AlarmNotifyTemplateCreateReq {
	Name         string            `json:"name"`                 // 名称
	Desc         string            `json:"desc,optional"`        // 描述
	Channel      string            `json:"channel"`              // 渠道
	Subject      string            `json:"subject,optional"`     // 主题
	TriggerBody  string            `json:"triggerBody,optional"`  // 触发内容
	RecoveryBody string            `json:"recoveryBody,optional"` // 恢复内容
	Headers      map[string]string `json:"headers,optional"`     // 请求头
}

type AlarmNotifyTemplateUpdateReq {
	Id           int64             `json:"id,string"`            // ID
	Name         string            `json:"name,optional"`        // 名称
	Desc         string            `json:"desc,optional"`        // 描述
	Channel      string            `json:"channel,optional"`     // 渠道
	Subject      string            `json:"subject,optional"`     // 主题
	TriggerBody  string            `json:"triggerBody,optional"`  // 触发内容
	RecoveryBody string            `json:"recoveryBody,optional"` // 恢复内容
	Headers      map[string]string `json:"headers,optional"`     // 请求头
	Status       int64             `json:"status,optional"`      // 状态
}

type AlarmNotifyTemplateGetListReq {
	Page    *PageInfo `json:"page,optional"`    // 分页
	Keyword string    `json:"keyword,optional"` // 名称模糊搜索
	Channel string    `json:"channel,optional"` // 渠道
	Status  int64     `json:"status,optional"`  // 状态
}

type AlarmNotifyTemplateGetListResp {
	List []*AlarmNotifyTemplate `json:"list"` // 模板列表
	PageResp
}

type AlarmNotifyTemplateTestSendReq {
	Id      int64               `json:"id,string"`       // 模板ID
	Timing  string              `json:"timing"`          // trigger / recovery
	Targets *AlarmNotifyTargets `json:"targets,optional"` // 通知目标
}
