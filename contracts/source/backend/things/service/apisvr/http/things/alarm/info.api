info (
	title:   "告警规则管理"
	desc:    "告警规则管理"
	author:  "杨磊"
	email:   "603685348@qq.com"
	version: "v1"
)

import "alarmCommon.api"

@server (
	group:            things/alarm/info
	prefix:           /api/v1/things/alarm/info
	accessCodePrefix: "thingsAlarm"
	accessNamePrefix: "告警管理"
	accessGroup:      "规则引擎"
	middleware:       CheckTokenWare,InitCtxsWare
	defaultAuthType: "admin"
	defaultNeedAuth: "true"
)
service api {
	@doc(
    summary: "创建告警规则"
    description: "创建告警规则"
    resource: "things/alarm/info"
    action: "create"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/info"
)
	@handler create
	post /create (AlarmInfoCreateReq) returns (AlarmInfoWithID)

	@doc(
    summary: "更新告警规则"
    description: "更新告警规则"
    resource: "things/alarm/info"
    action: "update"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/info"
)
	@handler update
	post /update (AlarmInfoUpdateReq) returns (ShareEmpty)

	@doc(
    summary: "删除告警规则"
    description: "删除告警规则"
    resource: "things/alarm/info"
    action: "delete"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/info"
)
	@handler delete
	post /delete (AlarmInfoWithID) returns (ShareEmpty)

	@doc(
    summary: "获取告警规则详情"
    description: "获取告警规则详情"
    resource: "things/alarm/info"
    action: "view"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/info"
)
	@handler getOne
	post /get-one (AlarmInfoWithID) returns (AlarmInfo)

	@doc(
    summary: "获取告警规则列表"
    description: "获取告警规则列表"
    resource: "things/alarm/info"
    action: "view"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/info"
)
	@handler getList
	post /get-list (AlarmInfoGetListReq) returns (AlarmInfoGetListResp)

	@doc(
    summary: "更新告警规则状态"
    description: "更新告警规则状态"
    resource: "things/alarm/info"
    action: "update"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/info"
)
	@handler statusUpdate
	post /status-update (AlarmInfoStatusUpdateReq) returns (ShareEmpty)

	@doc(
    summary: "手动触发评估"
    description: "手动触发评估"
    resource: "things/alarm/info"
    action: "create"
        authType: "admin"
        recordLogMode: "1"
        group: "things/alarm/info"
)
	@handler evaluateTrigger
	post /evaluate-trigger (AlarmEvaluateTriggerReq) returns (ShareEmpty)
}

type AlarmInfoCreateReq {
	Name       string               `json:"name"`                // 名称
	Desc       string               `json:"desc,optional"`       // 描述
	Target     *AlarmTarget         `json:"target,optional"`     // 告警目标
	If         *AlarmIf             `json:"if,optional"`         // 触发条件
	Ladders    []*AlarmNotifyLadder `json:"ladders,optional"`    // 通知阶梯
	EvalPeriod int64                `json:"evalPeriod,optional"` // 评估周期（分钟）
	AiConfig   *AlarmAiConfig       `json:"aiConfig,optional"`   // AI 判断配置，为空表示不启用
}

type AlarmInfoUpdateReq {
	Id         int64                `json:"id,string"`           // ID
	Name       string               `json:"name,optional"`       // 名称
	Desc       string               `json:"desc,optional"`       // 描述
	Target     *AlarmTarget         `json:"target,optional"`     // 告警目标
	If         *AlarmIf             `json:"if,optional"`         // 触发条件
	Ladders    []*AlarmNotifyLadder `json:"ladders,optional"`    // 通知阶梯
	EvalPeriod int64                `json:"evalPeriod,optional"` // 评估周期（分钟）
	AiConfig   *AlarmAiConfig       `json:"aiConfig,optional"`   // AI 判断配置，为空表示不启用
}

type AlarmInfoStatusUpdateReq {
	Id     int64 `json:"id,string"`     // ID
	Status int64 `json:"status"`        // 状态：1启用 2停用
}

type AlarmInfoGetListReq {
	Page             *PageInfo  `json:"page,optional"`             // 分页
	Keyword          string     `json:"keyword,optional"`          // 名称模糊搜索
	Status           int64      `json:"status,optional"`           // 状态
	ProductID        string     `json:"productID,optional"`        // 产品ID
	Levels           []string   `json:"levels,optional"`           // 触发条件级别
	CreatedTimeRange *TimeRange `json:"createdTimeRange,optional"` // 创建时间范围
}

type AlarmInfoGetListResp {
	List []*AlarmInfo `json:"list"` // 告警规则列表
	PageResp
}

type AlarmEvaluateTriggerReq {
	AlarmIDs []int64 `json:"alarmIDs,optional"` // 告警ID列表，为空表示全量扫描
	AlarmIDStrings []string `json:"alarmIDStrings,optional"` // 无损传递大整数告警ID；与alarmIDs不可同时填写
}
