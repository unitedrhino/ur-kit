info(
    title: "数据交互(待定)"
    desc: "数据交互(待定)"
    author: "杨磊"
    email: "603685348@qq.com"
    version: "v1"
)
@server(
    group: things/device/profile
    prefix: /api/v1/things/device/profile
    middleware:  CheckTokenWare,InitCtxsWare
	defaultAuthType: "admin"
	defaultNeedAuth: "true"
    accessCodePrefix: "thingsDeviceInfo"
    accessNamePrefix: "设备信息"
    accessGroup: "设备管理"
)
service api {
    @doc(
        summary: "获取设备配置详情"
        description: "获取单个设备的配置信息（profile），配置信息包含设备特定的参数设置，用于覆盖或补充产品物模型的默认配置。通过设备ID（productID+deviceName）和配置编码查询。"
        authType: "admin"
        group: "things/device/profile"
        resource: "things/device/profile"
        action: "view"
        recordLogMode: "1"
    )
    @handler getOne
    post /get-one (DeviceProfileGetOneReq) returns (DeviceProfile)
    @doc(
        summary: "删除设备配置"
        description: "删除指定设备的配置信息，删除后设备将恢复使用产品物模型的默认配置。需要传入设备ID（productID+deviceName）和配置编码。"
        operType: "modify"
        authType: "admin"
        group: "things/device/profile"
        resource: "things/device/profile"
        action: "delete"
        recordLogMode: "1"
    )
    @handler delete
    post /delete (DeviceProfileGetOneReq) returns ()
    @doc(
        summary: "获取设备配置列表"
        description: "批量获取设备配置信息列表。支持按设备ID、配置编码等条件筛选。当设备有多个配置时，可用于查看所有配置项。"
        authType: "admin"
        group: "things/device/profile"
        resource: "things/device/profile"
        action: "view"
        recordLogMode: "1"
    )
    @handler getList
    post /get-list (DeviceProfileGetListReq) returns (DeviceProfileGetListResp)
    @doc(
        summary: "更新设备配置"
        description: "更新设备的配置信息，修改设备特定的参数设置。配置信息以JSON字符串形式存储，可覆盖产品物模型中对应属性的行为（如是否使用影子、是否记录历史等）。"
        operType: "modify"
        authType: "admin"
        group: "things/device/profile"
        resource: "things/device/profile"
        action: "update"
        recordLogMode: "1"
    )
    @handler update
    post /update (DeviceProfile) returns ()


}
type (
    DeviceProfileGetOneReq  {
        Device DeviceCore `json:"device"`
        Code   string      `json:"code"`
    }
    DeviceProfileGetListReq  {
        Device *DeviceCore `json:"device"`
        Codes  []string    `json:"codes,optional"`
    }
    DeviceProfile  {
        Device DeviceCore `json:"device"`
        Code   string      `json:"code"`
        Params string      `json:"params"`
    }
     DeviceProfileGetListResp  {
        Profiles []*DeviceProfile `json:"profiles,omitempty"`
    }
)