syntax = "v1"


info(
    title: "物联卡轮询错误"
    desc: "物联卡用量接口查询错误记录及分组"
    version: "v1"
)

type (
    CardPollingError {
        ID         int64  `json:"id,string"`
        Iccid      string `json:"iccid"`
        CodeOn     string `json:"codeOn"`
        Message    string `json:"message,optional"`
        RouteCode  string `json:"routeCode"`
        RouteName  string `json:"routeName,optional"`
        CreateDate string `json:"createDate"`
        UpdateDate string `json:"updateDate"`
        IsNotice   int64  `json:"isNotice"`
    }

    CardPollingErrorGetListReq {
        PageInfo
        Iccid     string `json:"iccid,optional"`
        CodeOn    string `json:"codeOn,optional"`
        RouteCode string `json:"routeCode,optional"`
        IsNotice  int64  `json:"isNotice,optional"`
    }

    CardPollingErrorGetListResp {
        PageResp
        List []*CardPollingError `json:"list"`
    }

    CardPollingErrorGroup {
        ID         int64  `json:"id,string"`
        CodeOn     string `json:"codeOn"`
        Message    string `json:"message,optional"`
        RouteCode  string `json:"routeCode"`
        RouteName  string `json:"routeName,optional"`
        CreateDate string `json:"createDate"`
        UpdateDate string `json:"updateDate"`
        IsNotice   int64  `json:"isNotice"`
        CtSum      int64  `json:"ctSum"`
    }

    CardPollingErrorGroupGetListReq {
        PageInfo
        CodeOn    string `json:"codeOn,optional"`
        RouteCode string `json:"routeCode,optional"`
    }

    CardPollingErrorGroupGetListResp {
        PageResp
        List []*CardPollingErrorGroup `json:"list"`
    }

    CardPollingErrorMarkReq {
        IDs      []int64 `json:"ids"`
        IsNotice int64   `json:"isNotice"`
    }
)

@server(
    group: card/pollingError
    prefix: /api/v1/things/card/polling-error
    middleware: CheckTokenWare,InitCtxsWare
)
service card {
    @doc(
        summary: "获取轮询错误列表"
        description: "业务说明：获取轮询错误列表"
        authType: "admin"
        resource: "card"
        action: "view"
        group: "things/card"
        recordLogMode: "1"
    )
    @handler getList
    post /get-list (CardPollingErrorGetListReq) returns (CardPollingErrorGetListResp)

    @doc(
        summary: "获取轮询错误详情"
        description: "业务说明：按租户和主键查询单条轮询错误"
        authType: "admin"
        resource: "card"
        action: "view"
        group: "things/card"
        recordLogMode: "1"
    )
    @handler getOne
    post /get-one (WithID) returns (CardPollingError)

    @doc(
        summary: "标记轮询错误通知状态"
        description: "业务说明：标记轮询错误通知状态"
        authType: "admin"
        resource: "card"
        action: "operate"
        group: "things/card"
        recordLogMode: "1"
    )
    @handler markNotice
    post /mark-notice (CardPollingErrorMarkReq) returns ()

    @doc(
        summary: "获取轮询错误分组列表"
        description: "业务说明：获取轮询错误分组列表"
        authType: "admin"
        resource: "card"
        action: "view"
        group: "things/card"
        recordLogMode: "1"
    )
    @handler groupGetList
    post /group/get-list (CardPollingErrorGroupGetListReq) returns (CardPollingErrorGroupGetListResp)

    @doc(
        summary: "标记轮询错误分组通知状态"
        description: "业务说明：标记轮询错误分组通知状态"
        authType: "admin"
        resource: "card"
        action: "operate"
        group: "things/card"
        recordLogMode: "1"
    )
    @handler groupMarkNotice
    post /group/mark-notice (CardPollingErrorMarkReq) returns ()
}
