    post /import (CardInfoImportReq) returns (CardImportResp)

    @doc(
        summary: "Excel 导入物联卡"
        description: "业务说明：上传正式模板版本 1 批量导入物联卡；ICCID 按行校验并按租户业务键 UPSERT，失败行写入任务明细供受控下载"
        authType: "admin"
        resource: "card"
        action: "import"
        group: "things/card"
        recordLogMode: "1"
    )
    @handler importExcel
