  "info": {
    "title": "things-mqtt",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/v1/mqtt/api/v5/clients": {
      "get": {
        "description": "业务说明：分页查询 dmsvr 当前内置 MQTT 在线客户端列表，支持按用户名过滤，用于协议服务查询在线网关客户端并做订阅管理。",
        "operationId": "getApiV1MqttApiV5Clients",
        "parameters": [
          {
            "in": "query",
            "name": "username",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "default": "200",
                      "title": "返回code",
                      "type": "integer"
                    },
                    "data": {
                      "$ref": "#/components/schemas/GetClientsResp"
                    },
                    "msg": {
                      "title": "返回的消息",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A successful response."
          }
        },
        "summary": "获取客户端列表",
        "tags": [
          "mqtt"
        ],
        "x-action": "view",
        "x-auth-type": "admin",
        "x-group": "things/mqtt/client",
        "x-log-mode": "1",
        "x-oper-type": "view",
        "x-resource": "mqttClient"
      }
    },
    "/api/v1/mqtt/api/v5/clients/{clientID}/subscribe/bulk": {
      "post": {
        "description": "业务说明：为指定 MQTT 客户端批量增加订阅主题，用于协议网关按设备在线状态动态调整客户端订阅列表。",
        "operationId": "postApiV1MqttApiV5Clients:clientIDSubscribeBulk",
        "parameters": [
          {
            "in": "path",
            "name": "clientID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscribeBulkReq"
              }
            }
          },
          "required": true,
          "x-originalParamName": "body"
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "default": "200",
                      "title": "返回code",
                      "type": "integer"
                    },
                    "data": {
                      "$ref": "#/components/schemas/SubscribeBulkReq"
                    },
                    "msg": {
                      "title": "返回的消息",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A successful response."
          }
        },
        "summary": "批量订阅",
        "tags": [
          "mqtt"
        ],
        "x-action": "update",
        "x-auth-type": "admin",
        "x-group": "things/mqtt/client",
        "x-log-mode": "1",
        "x-oper-type": "update",
        "x-resource": "mqttClient"
      }
    },
    "/api/v1/mqtt/api/v5/clients/{clientID}/subscriptions": {
      "get": {
        "description": "业务说明：查询指定 MQTT 客户端当前持有的订阅主题列表，用于协议网关在增量订阅前判断已有订阅状态。",
        "operationId": "getApiV1MqttApiV5Clients:clientIDSubscriptions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "default": "200",
                      "title": "返回code",
                      "type": "integer"
                    },
                    "data": {
                      "$ref": "#/components/schemas/SubscribeBulkReq"
                    },
                    "msg": {
                      "title": "返回的消息",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A successful response."
          }
        },
        "summary": "获取订阅topic列表",
        "tags": [
          "mqtt"
        ],
        "x-action": "view",
        "x-auth-type": "admin",
        "x-group": "things/mqtt/client",
        "x-log-mode": "1",
        "x-oper-type": "view",
        "x-resource": "mqttClient"
      }
    },
    "/api/v1/mqtt/api/v5/clients/{clientID}/unsubscribe/bulk": {
      "post": {
        "description": "业务说明：为指定 MQTT 客户端批量移除订阅主题，用于协议网关在设备离线或解绑后回收不再需要的订阅。",
        "operationId": "postApiV1MqttApiV5Clients:clientIDUnsubscribeBulk",
        "parameters": [
          {
            "in": "path",
            "name": "clientID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscribeBulkReq"
              }
            }
          },
          "required": true,
          "x-originalParamName": "body"
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "default": "200",
                      "title": "返回code",
                      "type": "integer"
                    },
                    "data": {
                      "$ref": "#/components/schemas/SubscribeBulkReq"
                    },
                    "msg": {
                      "title": "返回的消息",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A successful response."
          }
        },
        "summary": "批量取消订阅",
        "tags": [
          "mqtt"
        ],
        "x-action": "update",
        "x-auth-type": "admin",
        "x-group": "things/mqtt/client",
        "x-log-mode": "1",
        "x-oper-type": "update",
        "x-resource": "mqttClient"
      }
    }
  }
}
