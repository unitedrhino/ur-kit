        "description": "业务说明：接收智能插座厂商推送的状态变更消息，并转交平台内部处理。",
        "operationId": "postApiV1Cz",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushReq"
              }
            }
          },
          "required": true,
          "x-originalParamName": "body"
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "default": "200",
                      "title": "返回code",
                      "type": "integer"
                    },
                    "msg": {
                      "title": "返回的消息",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A successful response."
          }
        },
        "summary": "接收插座状态推送",
        "tags": [
          "mjcz"
        ],
        "x-action": "hook",
        "x-auth-type": "public",
        "x-group": "things/protocol/mjcz",
        "x-log-mode": "1",
        "x-oper-type": "hook",
        "x-resource": "protocol-mjcz"
      }
    },
