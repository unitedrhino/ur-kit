                      "title": "返回code",
                      "type": "integer"
                    },
                    "msg": {
                      "title": "返回的消息",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A successful response."
          }
        },
        "summary": "测试数据源连接",
        "tags": [
          "data/datasource/manage",
          "dataDatasourceManage"
        ],
        "x-action": "test",
        "x-auth-type": "platform",
        "x-group": "数据服务",
        "x-log-mode": "2",
        "x-oper-type": "test",
        "x-resource": "dataSource"
      }
    },
    "/api/v1/data/datasource/manage/update": {
      "post": {
        "description": "业务说明：修改数据源配置参数，支持更新名称、连接字符串、连接池参数、状态等。部分更新，空值字段不修改。修改后需重新测试连接有效性。仅平台管理员可操作。",
        "operationId": "postApiV1DataDatasourceManageUpdate",
        "requestBody": {
