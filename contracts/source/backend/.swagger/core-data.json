          "dataDatasourceManage"
        ],
        "x-action": "view",
        "x-auth-type": "platform",
        "x-group": "数据服务",
        "x-log-mode": "1",
        "x-oper-type": "view",
        "x-resource": "dataSource"
      }
    },
    "/api/v1/data/datasource/manage/get-one": {
      "post": {
        "description": "业务说明：根据ID查询单个数据源的完整配置信息，包括连接字符串、连接池参数、自定义函数模板等。用于编辑回显、配置查看等场景。仅平台管理员可访问。",
