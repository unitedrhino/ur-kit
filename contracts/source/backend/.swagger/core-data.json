                    },
                    "msg": {
                      "title": "返回的消息",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A successful response."
          }
        },
        "summary": "获取数据源详情",
        "tags": [
          "data/datasource/manage",
          "dataDatasourceManage"
        ],
        "x-action": "view",
        "x-auth-type": "platform",
        "x-group": "数据服务",
        "x-log-mode": "1",
        "x-oper-type": "view",
        "x-resource": "dataSource"
      }
    },
    "/api/v1/data/datasource/manage/ping": {
      "post": {
        "description": "业务说明：验证数据源连接配置是否有效，尝试建立数据库连接并立即关闭。用于新增/编辑数据源时的配置验证，确保连接字符串正确。仅平台管理员可操作。",
