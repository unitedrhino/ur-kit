  "openapi": "3.0.3",
  "paths": {
    "/api/v1/data/datasource/manage/create": {
      "post": {
        "description": "业务说明：创建新的数据库连接配置，支持MySQL、PostgreSQL、SQLite、TDengine等多种数据库类型。配置连接字符串、连接池参数后可用于查询配置的数据来源。数据源是平台级基础设施，跨租户共享，仅平台管理员可操作。",
        "operationId": "postApiV1DataDatasourceManageCreate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DataSourceManage"
              }
            }
          },
          "required": true,
          "x-originalParamName": "body"
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "default": "200",
                      "title": "返回code",
                      "type": "integer"
                    },
                    "data": {
                      "$ref": "#/components/schemas/WithID"
                    },
                    "msg": {
                      "title": "返回的消息",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A successful response."
          }
        },
        "summary": "添加数据源",
        "tags": [
          "data/datasource/manage",
          "dataDatasourceManage"
        ],
        "x-action": "create",
        "x-auth-type": "platform",
        "x-group": "数据服务",
        "x-log-mode": "2",
        "x-oper-type": "create",
        "x-resource": "dataSource"
      }
    },
    "/api/v1/data/datasource/manage/delete": {
      "post": {
        "description": "业务说明：删除数据源配置记录。删除前需确保无查询配置引用该数据源，否则删除失败。删除后相关查询配置将无法执行。仅平台管理员可操作。",
        "operationId": "postApiV1DataDatasourceManageDelete",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WithID"
              }
            }
          },
          "required": true,
          "x-originalParamName": "body"
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "default": "200",
                      "title": "返回code",
                      "type": "integer"
                    },
                    "msg": {
                      "title": "返回的消息",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A successful response."
          }
        },
        "summary": "删除数据源",
        "tags": [
          "data/datasource/manage",
          "dataDatasourceManage"
        ],
        "x-action": "delete",
        "x-auth-type": "platform",
        "x-group": "数据服务",
        "x-log-mode": "2",
        "x-oper-type": "delete",
        "x-resource": "dataSource"
      }
    },
    "/api/v1/data/datasource/manage/get-list": {
      "post": {
        "description": "业务说明：分页查询数据源配置列表，支持按标识、名称、数据库类型、状态过滤。用于数据源管理页面展示，返回基本信息不含敏感字段。仅平台管理员可访问。",
