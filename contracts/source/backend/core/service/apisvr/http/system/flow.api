info (
	title:   "流程审批中心"
	desc:    "流程定义管理、审批任务办理、抄送、流程实例等流程审批中心能力"
	author:  "Claude"
	email:   "noreply@anthropic.com"
	version: "v0.1.0"
)

@server (
	group:            system/flow/process
	prefix:           /api/v1/system/flow/process
	accessCodePrefix: "systemFlow"
	accessNamePrefix: "流程审批中心"
	accessGroup:      "流程审批中心"
	middleware:       CheckTokenWare,InitCtxsWare
)
service api {
	@doc(
		summary: "获取可发起流程列表"
		description: "业务说明：获取当前用户可发起的流程列表，仅返回已发布【published】状态的流程定义，同时返回流程分类分组列表；列表按最近使用排序，前端用于发起流程的选择页【分类分组+流程卡片聚合视图，同一视图返回两类数据，故使用 get-launch-list 例外路径词，理由见设计方案第5节】。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "view"
		recordLogMode: "3"
	)
	@handler getLaunchList
	post /get-launch-list (FlowProcessGetLaunchListReq) returns (FlowProcessGetLaunchListResp)

	@doc(
		summary: "发起流程"
		description: "业务说明：按流程编码发起一个流程实例，传入流程编码【processCode】、业务单据键【businessKey，可空】、实例标题【title，可空】与流程变量JSON【variable，表单数据扁平化键值对】；引擎解析流程JSON模型创建首节点任务并产生抄送，调用者为实例发起人。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "create"
		recordLogMode: "1"
	)
	@handler launch
	post /launch (FlowProcessLaunchReq) returns (WithID)
}

@server (
	group:            system/flow/task
	prefix:           /api/v1/system/flow/task
	accessCodePrefix: "systemFlow"
	accessNamePrefix: "流程审批中心"
	accessGroup:      "流程审批中心"
	middleware:       CheckTokenWare,InitCtxsWare
)
service api {
	@doc(
		summary: "我的待办任务分页"
		description: "业务说明：分页查询当前用户待办理的审批任务列表，支持按任务名、流程名称模糊筛选；返回任务ID、实例标题、流程名、当前节点名、发起人与任务创建时间等信息，用于审批待办列表页展示。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "view"
		recordLogMode: "3"
	)
	@handler getPendingList
	post /get-pending-list (FlowTaskGetPendingListReq) returns (FlowTaskGetPendingListResp)

	@doc(
		summary: "我的已办任务分页"
		description: "业务说明：分页查询当前用户已办理的审批任务列表，支持按任务名、流程名称模糊筛选与办理结论【taskState：complete同意/reject驳回等】筛选；返回办理时间与办理耗时等信息，用于已办列表页展示。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "view"
		recordLogMode: "3"
	)
	@handler getApprovedList
	post /get-approved-list (FlowTaskGetApprovedListReq) returns (FlowTaskGetApprovedListResp)

	@doc(
		summary: "可认领任务分页"
		description: "业务说明：分页查询当前用户所在候选组【角色/部门】可认领的组任务列表；请求未传候选对象列表时由网关按当前登录用户的角色自动解析填充【actorIds】；认领后任务办理人收敛为认领人。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "view"
		recordLogMode: "3"
	)
	@handler getClaimList
	post /get-claim-list (FlowTaskGetClaimListReq) returns (FlowTaskGetClaimListResp)

	@doc(
		summary: "认领任务"
		description: "业务说明：认领一个组任务【候选任务】，认领后任务办理人收敛为当前认领人，其他候选成员不再可见该任务；仅任务办理人为候选组时允许认领。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "operate"
		recordLogMode: "1"
	)
	@handler claim
	post /claim (FlowTaskOperateReq) returns ()

	@doc(
		summary: "获取审批详情"
		description: "业务说明：获取审批任务详情聚合视图，返回当前任务信息、所属实例ID、表单JSON schema【formSchema】、表单数据【variable】、当前用户操作权限JSON【operationPerm，含同意/驳回/转办/加签等操作开关组与字段级表单权限】以及已产生的审批记录列表；用于审批办理页一次性加载数据，属聚合多源数据的详情视图【故使用 get-detail 例外路径词，理由见设计方案第5节】。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "view"
		recordLogMode: "3"
	)
	@handler getDetail
	post /get-detail (FlowTaskGetDetailReq) returns (FlowTaskDetail)

	@doc(
		summary: "同意审批"
		description: "业务说明：审批同意当前任务，完成任务并驱动流程流转到下一节点【事务内完成】；可携带审批意见【comment】、签名图片URL【signature】与修改后的表单数据JSON【variable，审批人可修改部分表单字段】；若为会签节点则按全部办理人意见判定。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "operate"
		recordLogMode: "1"
	)
	@handler consent
	post /consent (FlowTaskConsentReq) returns ()

	@doc(
		summary: "驳回审批"
		description: "业务说明：驳回当前审批任务，按驳回策略【strategy：toInitiator退回发起人/toPreviousNode退回上一节点/toSpecifiedNode退回指定节点/terminateApproval终止审批/toParentNode退回父流程】回退流程；strategy 为 toSpecifiedNode 时必须传目标节点key【targetNodeKey】；可携带审批意见。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "operate"
		recordLogMode: "1"
	)
	@handler reject
	post /reject (FlowTaskRejectReq) returns ()

	@doc(
		summary: "转办任务"
		description: "业务说明：将当前任务转办给其他用户，任务办理人替换为受让人【toUserId】，原办理人不再办理；可携带转办意见，转办会记录原办理人便于追溯。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "operate"
		recordLogMode: "1"
	)
	@handler transfer
	post /transfer (FlowTaskTransferReq) returns ()

	@doc(
		summary: "加签"
		description: "业务说明：为当前任务新增办理人【userIds 列表】，新增办理人需要一并办理后方可流转到下一节点；可携带操作意见。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "operate"
		recordLogMode: "1"
	)
	@handler addSign
	post /add-sign (FlowTaskSignReq) returns ()

	@doc(
		summary: "减签"
		description: "业务说明：移除当前任务的指定办理人【userIds 列表】；若移除后任务无剩余办理人，任务作废并回退到上一节点重新产生任务；可携带操作意见。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "operate"
		recordLogMode: "1"
	)
	@handler removeSign
	post /remove-sign (FlowTaskSignReq) returns ()

	@doc(
		summary: "拿回任务"
		description: "业务说明：发起人或其他办理人拿回已提交的任务重办【reclaim】，仅当下一节点任务尚未办理时允许拿回，拿回后流程回退、当前任务重新回到待办。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "operate"
		recordLogMode: "1"
	)
	@handler reclaim
	post /reclaim (FlowTaskOperateReq) returns ()

	@doc(
		summary: "催办任务"
		description: "业务说明：对当前待办任务发起催办，任务的催办次数加一并向任务办理人发送催办通知事件；用于发起人或上一步办理人提醒当前办理人尽快处理。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "operate"
		recordLogMode: "1"
	)
	@handler urge
	post /urge (FlowTaskOperateReq) returns ()
}

@server (
	group:            system/flow/cc
	prefix:           /api/v1/system/flow/cc
	accessCodePrefix: "systemFlow"
	accessNamePrefix: "流程审批中心"
	accessGroup:      "流程审批中心"
	middleware:       CheckTokenWare,InitCtxsWare
)
service api {
	@doc(
		summary: "我收到的抄送分页"
		description: "业务说明：分页查询抄送给当前用户的审批记录列表，返回实例标题、任务名、发起人与抄送时间等信息，用于抄送我的列表页展示。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "view"
		recordLogMode: "3"
	)
	@handler getList
	post /get-list (FlowCcGetListReq) returns (FlowCcGetListResp)

	@doc(
		summary: "抄送标记已阅"
		description: "业务说明：将指定的抄送记录批量标记为已阅，标记后抄送消息不再提示未读；传入抄送记录ID列表【ids】。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "operate"
		recordLogMode: "1"
	)
	@handler markRead
	post /mark-read (FlowCcMarkReadReq) returns ()
}

@server (
	group:            system/flow/instance
	prefix:           /api/v1/system/flow/instance
	accessCodePrefix: "systemFlow"
	accessNamePrefix: "流程审批中心"
	accessGroup:      "流程审批中心"
	middleware:       CheckTokenWare,InitCtxsWare
)
service api {
	@doc(
		summary: "我的申请分页"
		description: "业务说明：分页查询当前用户发起的流程实例列表，支持按实例标题模糊、流程编码、实例状态筛选；返回实例当前节点名与耗时等信息，用于我的申请列表页展示。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "view"
		recordLogMode: "3"
	)
	@handler getMyList
	post /get-my-list (FlowInstanceGetListReq) returns (FlowInstanceGetListResp)

	@doc(
		summary: "撤销流程实例"
		description: "业务说明：发起人撤销自己发起的流程实例，仅当实例仍在运行【active】时允许撤销，撤销后整单作废【cancel】；可携带撤销原因。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "operate"
		recordLogMode: "1"
	)
	@handler revoke
	post /revoke (FlowInstanceRevokeReq) returns ()

	@doc(
		summary: "获取审批记录时间线"
		description: "业务说明：获取流程实例的审批记录时间线，按办理时间升序返回各历史任务的节点名、类型【审批/抄送/转办/委派/拿回等】、办理结论、实际办理人、审批意见与参与人列表；用于审批详情页的时间线展示，属单实例办理轨迹聚合视图【故使用 get-record 例外路径词，理由见设计方案第5节】。"
		authType: "all"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "view"
		recordLogMode: "3"
	)
	@handler getRecord
	post /get-record (FlowInstanceGetRecordReq) returns (FlowInstanceGetRecordResp)

	@doc(
		summary: "实例监控分页"
		description: "业务说明：管理员分页查询本租户全部流程实例【含他人发起的】，支持按实例标题模糊、流程编码、实例状态、发起人筛选；用于管理员实例监控列表页。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "view"
		recordLogMode: "3"
	)
	@handler getMonitorList
	post /get-monitor-list (FlowInstanceGetListReq) returns (FlowInstanceGetListResp)

	@doc(
		summary: "终止流程实例"
		description: "业务说明：管理员挂起运行中的流程实例【suspend】，挂起期间任务不可办理；可携带操作原因，用于流程需要临时冻结的场景。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "operate"
		recordLogMode: "1"
	)
	@handler terminate
	post /terminate (FlowInstanceOperateReq) returns ()

	@doc(
		summary: "恢复流程实例"
		description: "业务说明：管理员将被挂起【suspend】的流程实例恢复为运行【active】状态，恢复后任务可继续办理；可携带操作原因。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "operate"
		recordLogMode: "1"
	)
	@handler resume
	post /resume (FlowInstanceOperateReq) returns ()

	@doc(
		summary: "作废流程实例"
		description: "业务说明：管理员将流程实例作废【destroy】，实例归档并标记为作废，不可再办理；可携带操作原因，用于错误发起或长期不处理的实例清理。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "operate"
		recordLogMode: "1"
	)
	@handler destroy
	post /destroy (FlowInstanceOperateReq) returns ()
}

@server (
	group:            system/flow/def
	prefix:           /api/v1/system/flow/def
	accessCodePrefix: "systemFlow"
	accessNamePrefix: "流程审批中心"
	accessGroup:      "流程审批中心"
	middleware:       CheckTokenWare,InitCtxsWare
)
service api {
	@doc(
		summary: "创建流程定义"
		description: "业务说明：创建一个新的流程定义【草稿态】，传入流程编码【processCode，业务唯一】、流程名称、分类编码、图标、流程JSON模型【modelContent，节点树见设计方案2.1】与绑定的表单模板ID；创建后为草稿状态，需发布后用户才可发起。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "create"
		recordLogMode: "1"
	)
	@handler create
	post /create (FlowProcessDefInfo) returns (WithID)

	@doc(
		summary: "更新流程定义"
		description: "业务说明：更新流程定义信息，支持部分更新【仅传入需要修改的字段】；流程编码发布后不可修改，流程JSON模型修改后需重新发布生效。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "update"
		recordLogMode: "1"
	)
	@handler update
	post /update (FlowProcessDefInfo) returns ()

	@doc(
		summary: "删除流程定义"
		description: "业务说明：删除指定的流程定义；若该定义存在运行中或历史流程实例则禁止删除，需要先清理实例或改为停用。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "delete"
		recordLogMode: "1"
	)
	@handler delete
	post /delete (WithID) returns ()

	@doc(
		summary: "获取流程定义详情"
		description: "业务说明：根据ID获取流程定义详情，返回流程编码、名称、分类、图标、流程JSON模型【modelContent】、版本号、状态与绑定的表单模板信息；用于流程设计器的数据加载。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "view"
		recordLogMode: "3"
	)
	@handler getOne
	post /get-one (WithID) returns (FlowProcessDefInfo)

	@doc(
		summary: "获取流程定义分页"
		description: "业务说明：分页查询流程定义列表，支持按流程编码精确、流程名称模糊、分类编码与状态【draft草稿/published已发布/history历史版本/stopped停用】筛选；用于流程定义管理列表页。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "view"
		recordLogMode: "3"
	)
	@handler getList
	post /get-list (FlowProcessDefGetListReq) returns (FlowProcessDefGetListResp)

	@doc(
		summary: "发布流程定义"
		description: "业务说明：发布指定的流程定义，定义版本号加一并转为已发布状态，同编码的旧发布版本自动转为历史版本【history】；发布后用户即可按流程编码发起新实例。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "operate"
		recordLogMode: "1"
	)
	@handler deploy
	post /deploy (WithID) returns ()

	@doc(
		summary: "停用流程定义"
		description: "业务说明：停用指定的流程定义，状态转为停用【stopped】；停用后用户不可再按该流程发起新实例，运行中的实例不受影响。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "operate"
		recordLogMode: "1"
	)
	@handler unpublish
	post /unpublish (WithID) returns ()
}

@server (
	group:            system/flow/category
	prefix:           /api/v1/system/flow/category
	accessCodePrefix: "systemFlow"
	accessNamePrefix: "流程审批中心"
	accessGroup:      "流程审批中心"
	middleware:       CheckTokenWare,InitCtxsWare
)
service api {
	@doc(
		summary: "创建流程分类"
		description: "业务说明：创建一个流程分类，传入分类名称、分类编码【code，租户内唯一】、排序与备注；分类用于发起流程页的分组展示与流程定义归类。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "create"
		recordLogMode: "1"
	)
	@handler create
	post /create (FlowCategoryInfo) returns (WithID)

	@doc(
		summary: "更新流程分类"
		description: "业务说明：更新流程分类信息，支持部分更新【仅传入需要修改的字段】；分类编码为租户内唯一标识，修改时需保证唯一性。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "update"
		recordLogMode: "1"
	)
	@handler update
	post /update (FlowCategoryInfo) returns ()

	@doc(
		summary: "删除流程分类"
		description: "业务说明：删除指定的流程分类；已被流程定义引用的分类应先调整引用关系后再删除。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "delete"
		recordLogMode: "1"
	)
	@handler delete
	post /delete (WithID) returns ()

	@doc(
		summary: "获取流程分类分页"
		description: "业务说明：分页查询流程分类列表，支持按分类名称模糊、分类编码精确筛选；用于分类管理页与发起流程页的分组数据加载。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "view"
		recordLogMode: "3"
	)
	@handler getList
	post /get-list (FlowCategoryGetListReq) returns (FlowCategoryGetListResp)
}

@server (
	group:            system/flow/form
	prefix:           /api/v1/system/flow/form
	accessCodePrefix: "systemFlow"
	accessNamePrefix: "流程审批中心"
	accessGroup:      "流程审批中心"
	middleware:       CheckTokenWare,InitCtxsWare
)
service api {
	@doc(
		summary: "创建表单模板"
		description: "业务说明：创建一个表单模板【草稿态】，传入表单名称、分类编码与表单JSON schema【formSchema，组件树+属性+校验规则，见设计方案2.6】；表单模板可被流程定义绑定，作为发起与审批时的表单结构。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "create"
		recordLogMode: "1"
	)
	@handler create
	post /create (FlowFormTemplateInfo) returns (WithID)

	@doc(
		summary: "更新表单模板"
		description: "业务说明：更新表单模板信息，支持部分更新【仅传入需要修改的字段】；表单结构【formSchema】修改后版本号自增，已绑定该模板的流程定义按最新结构渲染。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "update"
		recordLogMode: "1"
	)
	@handler update
	post /update (FlowFormTemplateInfo) returns ()

	@doc(
		summary: "删除表单模板"
		description: "业务说明：删除指定的表单模板；被任一流程定义引用的表单禁止删除【删除前校验引用，命中则报错】，此类表单只允许停用。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "delete"
		recordLogMode: "1"
	)
	@handler delete
	post /delete (WithID) returns ()

	@doc(
		summary: "获取表单模板详情"
		description: "业务说明：根据ID获取表单模板详情，返回表单名称、分类、表单JSON schema、版本号与状态；用于表单设计器与流程定义绑定的数据加载。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "view"
		recordLogMode: "3"
	)
	@handler getOne
	post /get-one (WithID) returns (FlowFormTemplateInfo)

	@doc(
		summary: "获取表单模板分页"
		description: "业务说明：分页查询表单模板列表，支持按表单名称模糊、分类编码与状态【draft草稿/published已发布】筛选；用于表单模板管理列表页。"
		authType: "admin"
		isNeedAuth: "true"
		group: "system/flow"
		resource: "flow"
		action: "view"
		recordLogMode: "3"
	)
	@handler getList
	post /get-list (FlowFormTemplateGetListReq) returns (FlowFormTemplateGetListResp)
}

type (
	// 流程分类信息
	FlowCategoryInfo {
		ID     int64   `json:"id,string,optional"`    // 分类ID（创建时留空）
		Name   string  `json:"name"`                  // 分类名称
		Code   string  `json:"code"`                  // 分类编码（租户内唯一）
		Sort   int64   `json:"sort,string,optional"`  // 排序
		Remark *string `json:"remark,optional"`       // 备注
	}

	// 流程分类分页请求
	FlowCategoryGetListReq {
		Page *PageInfo `json:"page,optional"` // 分页信息
		Name string    `json:"name,optional"` // 分类名称（模糊匹配）
		Code string    `json:"code,optional"` // 分类编码（精确匹配）
	}

	// 流程分类分页响应
	FlowCategoryGetListResp {
		List  []*FlowCategoryInfo `json:"list"`          // 分类列表
		Total int64               `json:"total,string"`  // 总数
	}

	// 表单模板信息
	FlowFormTemplateInfo {
		ID         int64   `json:"id,string,optional"`   // 表单模板ID（创建时留空）
		Name       string  `json:"name"`                 // 表单名称
		Category   string  `json:"category,optional"`    // 表单分类编码
		FormSchema string  `json:"formSchema,optional"`  // 表单JSON schema（组件树+属性+校验规则）
		Version    int64   `json:"version,string,optional"` // 版本号（修改发布自增）
		Status     string  `json:"status,optional"`      // 状态：draft草稿/published已发布
		Remark     *string `json:"remark,optional"`      // 备注
	}

	// 表单模板分页请求
	FlowFormTemplateGetListReq {
		Page     *PageInfo `json:"page,optional"`      // 分页信息
		Name     string    `json:"name,optional"`      // 表单名称（模糊匹配）
		Category string    `json:"category,optional"`  // 表单分类编码
		Status   string    `json:"status,optional"`    // 状态：draft/published
	}

	// 表单模板分页响应
	FlowFormTemplateGetListResp {
		List  []*FlowFormTemplateInfo `json:"list"`         // 表单模板列表
		Total int64                   `json:"total,string"` // 总数
	}

	// 流程定义信息
	FlowProcessDefInfo {
		ID               int64   `json:"id,string,optional"`      // 流程定义ID（创建时留空）
		ProcessCode      string  `json:"processCode"`             // 流程编码（业务唯一，发布后不可改）
		Name             string  `json:"name"`                    // 流程名称
		Category         string  `json:"category,optional"`       // 分类编码
		Icon             string  `json:"icon,optional"`           // 流程图标URL
		ModelContent     string  `json:"modelContent,optional"`   // 流程JSON模型（节点树）
		Version          int64   `json:"version,string,optional"` // 版本号（发布自增）
		State            string  `json:"state,optional"`          // 状态：draft草稿/published已发布/history历史版本/stopped停用
		FormTemplateId   int64   `json:"formTemplateId,string,optional"` // 绑定的表单模板ID（0=未绑定）
		Remark           *string `json:"remark,optional"`         // 备注
		FormTemplateName string  `json:"formTemplateName,optional"` // 表单模板名称（仅查询返回，冗余展示）
		Sort             int64   `json:"sort,string,optional"` // 分组内排序，数值越小越靠前
	}

	// 流程定义分页请求
	FlowProcessDefGetListReq {
		Page        *PageInfo `json:"page,optional"`       // 分页信息
		ProcessCode string    `json:"processCode,optional"` // 流程编码（精确匹配）
		Name        string    `json:"name,optional"`       // 流程名称（模糊匹配）
		Category    string    `json:"category,optional"`   // 分类编码
		State       string    `json:"state,optional"`      // 状态：draft/published/history/stopped
	}

	// 流程定义分页响应
	FlowProcessDefGetListResp {
		List  []*FlowProcessDefInfo `json:"list"`         // 流程定义列表
		Total int64                 `json:"total,string"` // 总数
	}

	// 可发起流程列表请求
	FlowProcessGetLaunchListReq {
		Page     *PageInfo `json:"page,optional"`     // 分页信息
		Name     string    `json:"name,optional"`     // 流程名称（模糊匹配）
		Category string    `json:"category,optional"` // 分类编码
	}

	// 可发起流程列表响应（分类分组+流程卡片聚合）
	FlowProcessGetLaunchListResp {
		List       []*FlowProcessDefInfo `json:"list"`       // 可发起流程列表（仅published，按最近使用排序）
		Categories []*FlowCategoryInfo   `json:"categories"` // 分类分组列表
	}

	// 发起流程请求
	FlowProcessLaunchReq {
		ProcessCode string `json:"processCode"`           // 流程编码
		BusinessKey string `json:"businessKey,optional"`  // 业务单据键（业务方关联自查表，可空）
		Title       string `json:"title,optional"`        // 实例标题（列表展示，可空）
		Variable    string `json:"variable,optional"`     // 流程变量JSON（表单数据扁平化键值对）
		ForcedBranch string `json:"forcedBranch,optional"` // 手选条件分支JSON（条件分支容器nodeKey到分支nodeKey）
		NodeAssigneeMap string `json:"nodeAssigneeMap,optional"` // 发起人自选办理人JSON（审批节点nodeKey到人员或角色ID数组，类型由selectMode决定）
	}

	// 审批任务条目（待办为运行任务，已办为历史任务）
	FlowTaskItem {
		ID              int64  `json:"id,string,optional"`       // 任务ID（待办为运行任务ID，已办为历史任务ID）
		InstanceId      int64  `json:"instanceId,string,optional"` // 流程实例ID
		InstanceTitle   string `json:"instanceTitle,optional"`   // 实例标题
		ProcessCode     string `json:"processCode,optional"`     // 流程编码
		ProcessName     string `json:"processName,optional"`     // 流程名称
		NodeKey         string `json:"nodeKey,optional"`         // 节点key
		TaskName        string `json:"taskName,optional"`        // 任务名（节点名）
		TaskState       string `json:"taskState,optional"`       // 任务状态（已办：complete/reject/autoPass/autoReject等）
		Initiator       string `json:"initiator,optional"`       // 发起人userID
		CurrentNodeName string `json:"currentNodeName,optional"` // 实例当前节点名（待办场景展示）
		CreateTime      int64  `json:"createTime,string,optional"` // 任务创建时间（毫秒时间戳）
		FinishTime      int64  `json:"finishTime,string,optional"` // 办理时间（毫秒时间戳，已办有效）
		Duration        int64  `json:"duration,string,optional"`   // 办理耗时（毫秒，已办有效）
	}

	// 待办任务分页请求
	FlowTaskGetPendingListReq {
		Page        *PageInfo `json:"page,optional"`      // 分页信息
		TaskName    string    `json:"taskName,optional"`  // 任务名（模糊匹配）
		ProcessName string    `json:"processName,optional"` // 流程名称（模糊匹配）
	}

	// 待办任务分页响应
	FlowTaskGetPendingListResp {
		List  []*FlowTaskItem `json:"list"`         // 待办任务列表
		Total int64           `json:"total,string"` // 总数
	}

	// 已办任务分页请求
	FlowTaskGetApprovedListReq {
		Page        *PageInfo `json:"page,optional"`      // 分页信息
		TaskName    string    `json:"taskName,optional"`  // 任务名（模糊匹配）
		ProcessName string    `json:"processName,optional"` // 流程名称（模糊匹配）
		TaskState   string    `json:"taskState,optional"` // 办理结论筛选（complete/reject等，可空=全部）
	}

	// 已办任务分页响应
	FlowTaskGetApprovedListResp {
		List  []*FlowTaskItem `json:"list"`         // 已办任务列表
		Total int64           `json:"total,string"` // 总数
	}

	// 可认领任务分页请求
	FlowTaskGetClaimListReq {
		Page     *PageInfo `json:"page,optional"`     // 分页信息
		ActorIds []string  `json:"actorIds,optional"` // 当前用户可认领的候选对象ID列表（角色/部门ID，不传时网关按当前用户角色解析）
		TaskName string    `json:"taskName,optional"` // 任务名（模糊匹配）
	}

	// 可认领任务分页响应
	FlowTaskGetClaimListResp {
		List  []*FlowTaskItem `json:"list"`         // 可认领任务列表
		Total int64           `json:"total,string"` // 总数
	}

	// 审批任务操作请求（认领/拿回/催办）
	FlowTaskOperateReq {
		TaskId  int64  `json:"taskId,string"`     // 任务ID
		Comment string `json:"comment,optional"`  // 操作意见（可空）
	}

	// 审批详情请求
	FlowTaskGetDetailReq {
		TaskId int64 `json:"taskId,string"` // 任务ID
	}

	// 审批任务详情（表单+当前任务+操作权限+审批记录聚合）
	FlowTaskDetail {
		Task          *FlowTaskItem        `json:"task,optional"`       // 当前任务信息
		InstanceId    int64                `json:"instanceId,string,optional"` // 流程实例ID
		FormSchema    string               `json:"formSchema,optional"` // 表单JSON schema（来自绑定表单模板）
		Variable      string               `json:"variable,optional"`   // 表单数据JSON（实例流程变量）
		OperationPerm string               `json:"operationPerm,optional"` // 当前用户操作权限JSON（操作开关组与字段级表单权限）
		Records       []*FlowTaskRecordItem `json:"records,optional"`   // 已产生的审批记录
	}

	// 同意审批请求
	FlowTaskConsentReq {
		TaskId    int64  `json:"taskId,string"`      // 任务ID
		Comment   string `json:"comment,optional"`   // 审批意见
		Signature string `json:"signature,optional"` // 签名图片URL（可空）
		Variable  string `json:"variable,optional"`  // 修改后的表单数据JSON（可空，审批人可改部分字段）
	}

	// 驳回审批请求
	FlowTaskRejectReq {
		TaskId        int64  `json:"taskId,string"`            // 任务ID
		Strategy      string `json:"strategy"`                 // 驳回策略：toInitiator/toPreviousNode/toSpecifiedNode/terminateApproval/toParentNode
		TargetNodeKey string `json:"targetNodeKey,optional"`   // 目标节点key（strategy=toSpecifiedNode时必填）
		Comment       string `json:"comment,optional"`         // 审批意见
	}

	// 转办请求
	FlowTaskTransferReq {
		TaskId   int64  `json:"taskId,string"`     // 任务ID
		ToUserId string `json:"toUserId"`          // 受让人userID
		Comment  string `json:"comment,optional"`  // 转办意见
	}

	// 加签/减签请求
	FlowTaskSignReq {
		TaskId   int64    `json:"taskId,string"`     // 任务ID
		UserIds  []string `json:"userIds"`           // 加签/减签的用户ID列表
		Comment  string   `json:"comment,optional"`  // 操作意见
	}

	// 审批记录条目（时间线）
	FlowTaskRecordItem {
		TaskId       int64                `json:"taskId,string,optional"`     // 历史任务ID
		NodeKey      string               `json:"nodeKey,optional"`           // 节点key
		TaskName     string               `json:"taskName,optional"`          // 任务名（节点名）
		TaskType     string               `json:"taskType,optional"`          // 类型：approval/major/cc/transfer/delegate/reclaim/jump/rejectJump/withdraw
		TaskState    string               `json:"taskState,optional"`         // 状态：complete/reject/autoPass/autoReject/autoJump/timeout/terminate/cancel
		Approver     string               `json:"approver,optional"`          // 实际办理人userID
		ApproverName string               `json:"approverName,optional"`      // 实际办理人名
		Assignor     string               `json:"assignor,optional"`          // 转办/委派原办理人（可空）
		Comment      string               `json:"comment,optional"`           // 审批意见
		CreateTime   int64                `json:"createTime,string,optional"` // 任务到达时间（毫秒时间戳）
		FinishTime   int64                `json:"finishTime,string,optional"` // 办理时间（毫秒时间戳）
		Duration     int64                `json:"duration,string,optional"`   // 办理耗时（毫秒）
		Actors       []*FlowTaskRecordActor `json:"actors,optional"`          // 参与人列表
	}

	// 审批记录参与人
	FlowTaskRecordActor {
		ActorId   string `json:"actorId,optional"`           // 参与人ID（用户/角色/部门）
		ActorName string `json:"actorName,optional"`         // 参与人名称
		ActorType string `json:"actorType,optional"`         // 类型：user/role/department
		Weight    int64  `json:"weight,string,optional"`     // 权重（6=抄送人）
	}

	// 抄送条目
	FlowCcItem {
		ID            int64  `json:"id,string,optional"`     // 抄送记录ID
		TaskId        int64  `json:"taskId,string,optional"` // 历史任务ID
		InstanceId    int64  `json:"instanceId,string,optional"` // 流程实例ID
		InstanceTitle string `json:"instanceTitle,optional"` // 实例标题
		TaskName      string `json:"taskName,optional"`      // 任务名
		Initiator     string `json:"initiator,optional"`     // 发起人userID
		CreateTime    int64  `json:"createTime,string,optional"` // 抄送时间（毫秒时间戳）
	}

	// 抄送分页请求
	FlowCcGetListReq {
		Page *PageInfo `json:"page,optional"` // 分页信息
	}

	// 抄送分页响应
	FlowCcGetListResp {
		List  []*FlowCcItem `json:"list"`         // 抄送列表
		Total int64         `json:"total,string"` // 总数
	}

	// 抄送标记已阅请求
	FlowCcMarkReadReq {
		IDs []int64 `json:"ids,string,string"` // 抄送记录ID列表
	}

	// 流程实例条目
	FlowInstanceItem {
		ID              int64  `json:"id,string,optional"`     // 实例ID
		ProcessCode     string `json:"processCode,optional"`   // 流程编码
		ProcessName     string `json:"processName,optional"`   // 流程名称
		Title           string `json:"title,optional"`         // 实例标题
		State           string `json:"state,optional"`         // 状态：active/suspend/finish/rejectEnd/autoPass/autoReject/timeout/terminate/cancel/destroy
		Initiator       string `json:"initiator,optional"`     // 发起人userID
		CurrentNodeName string `json:"currentNodeName,optional"` // 当前节点名
		BusinessKey     string `json:"businessKey,optional"`   // 业务单据键
		Version         int64  `json:"version,string,optional"` // 发起时定义版本
		CreateTime      int64  `json:"createTime,string,optional"` // 发起时间（毫秒时间戳）
		Duration        int64  `json:"duration,string,optional"`   // 耗时（毫秒，历史实例有效）
	}

	// 流程实例分页请求（我的申请/实例监控共用）
	FlowInstanceGetListReq {
		Page        *PageInfo `json:"page,optional"`       // 分页信息
		Title       string    `json:"title,optional"`      // 实例标题（模糊匹配）
		ProcessCode string    `json:"processCode,optional"` // 流程编码
		State       string    `json:"state,optional"`      // 实例状态
		Initiator   string    `json:"initiator,optional"`  // 发起人userID（监控列表过滤用，留空=按接口语义限定）
	}

	// 流程实例分页响应
	FlowInstanceGetListResp {
		List  []*FlowInstanceItem `json:"list"`         // 实例列表
		Total int64               `json:"total,string"` // 总数
	}

	// 撤销流程实例请求
	FlowInstanceRevokeReq {
		InstanceId int64  `json:"instanceId,string"` // 实例ID
		Comment    string `json:"comment,optional"`  // 撤销原因
	}

	// 流程实例管理操作请求（终止/恢复/作废）
	FlowInstanceOperateReq {
		InstanceId int64  `json:"instanceId,string"` // 实例ID
		Comment    string `json:"comment,optional"`  // 操作原因
	}

	// 审批记录时间线请求
	FlowInstanceGetRecordReq {
		InstanceId int64 `json:"instanceId,string"` // 实例ID
	}

	// 审批记录时间线响应
	FlowInstanceGetRecordResp {
		List []*FlowTaskRecordItem `json:"list"` // 审批记录时间线（按办理时间升序）
	}
)
