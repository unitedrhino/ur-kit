info (
	desc:   "菜单权限"
	author: "lbs"
	email:  "174805676@qq.com"
)

@server (
	group:            system/ops/workOrder
	prefix:           /api/v1/system/ops
	accessNamePrefix: "工单管理"
	accessGroup:      "运营管理"
	defaultAuthType:  "all"
	defaultNeedAuth:  "true"
	middleware:       CheckTokenWare,InitCtxsWare
)
service api {
	@doc(
	    summary: "添加工单"
	    description: "业务说明：用户创建运维工单，记录问题类型（如设备维修）、问题描述、相关区域等信息。工单进入待处理状态，运营人员可接单处理。支持所有登录用户提交工单。"
	    authType: "all"
	    group: "system/ops/workOrder"
	    resource: "system/ops/workOrder"
	    action: "create"
	    recordLogMode: "1"
	)
	@handler create
	post /work-order/create (OpsWorkOrder) returns (WithID)

	@doc(
		summary: "获取工单列表"
		description: "业务说明：查询运维工单列表，支持按状态、类型、区域、编号等条件筛选。普通用户查看自己提交的工单，平台管理员可查看所有租户的工单。用于工单管理页面的列表展示。"
		isNeedAuth: "true"
	    authType: "all"
		group: "system/ops/workOrder"
		resource: "system/ops/workOrder"
		action: "view"
		recordLogMode: "3"
	)
	@handler getList
	post /work-order/get-list (OpsWorkOrderGetListReq) returns (OpsWorkOrderGetListResp)

	@doc(
		summary: "更新工单"
		description: "业务说明：更新工单状态和处理信息，支持状态流转（待处理→处理中→已完成）。运营人员接单、处理完成时调用，记录处理时间和完成时间。"
		isNeedAuth: "true"
	    authType: "all"
		group: "system/ops/workOrder"
		resource: "system/ops/workOrder"
		action: "update"
		recordLogMode: "1"
	)
	@handler update
	post /work-order/update (OpsWorkOrder)

	@doc(
		summary: "获取工单详情"
		description: "业务说明：根据工单 ID 查询单个工单的完整信息。支持所有登录用户查看，非管理员只能查看自己提交的工单。用于工单详情抽屉展示。"
		isNeedAuth: "true"
	    authType: "all"
		group: "system/ops/workOrder"
		resource: "system/ops/workOrder"
		action: "view"
		recordLogMode: "3"
	)
	@handler getOne
	post /work-order/get-one (WithID) returns (OpsWorkOrder)

	@doc(
		summary: "删除工单"
		description: "业务说明：软删除指定工单。仅租户管理员及以上可删除。用于工单管理页面的删除操作。"
		isNeedAuth: "true"
	    authType: "admin"
		group: "system/ops/workOrder"
		resource: "system/ops/workOrder"
		action: "delete"
		recordLogMode: "1"
	)
	@handler delete
	post /work-order/delete (WithID)
}

type (
	OpsWorkOrder {
		ID           int64             `json:"id,string,optional"`
		Number       string            `json:"number,optional"` //编号
		RaiseUserID  int64             `json:"raiseUserID,string,optional"` //问题提出的用户
		AreaID       int64             `json:"areaID,string,optional"` //项目区域id
		Type         string            `json:"type,optional,options=[deviceMaintenance]"` //工单类型: deviceMaintenance:设备维修工单
		Params       map[string]string `json:"params,optional"` //参数 json格式
		IssueDesc    string            `json:"issueDesc,optional"` //问题描述
		Status       int64             `json:"status,optional,range=[0:4]"` // 状态（1 待处理 2:处理中 3:已完成 4:已取消）
		CreatedTime  int64             `json:"createdTime,string,optional"` //创建时间
		HandleTime   int64             `json:"handleTime,optional"` //处理时间
		FinishedTime int64             `json:"finishedTime,optional"` //处理完成时间
		AssignUserID int64             `json:"assignUserID,string,optional"` //责任人用户ID（派单）
		AssignTime   int64             `json:"assignTime,optional"` //派单时间
		FinishBy     int64             `json:"finishBy,string,optional"` //完成人用户ID
		Annex        string            `json:"annex,optional"` //附件（oss 资源 id，逗号分隔）
		Remark       string            `json:"remark,optional"` //工单备注
		CancelReason string            `json:"cancelReason,optional"` //取消原因
		AreaName     string            `json:"areaName,optional"` //项目区域名称（只读，按 areaID 关联查询）
	}
	OpsWorkOrderGetListReq {
		Page       *PageInfo `json:"page,optional"` // 分页信息,只获取一个则不填
		Status     int64     `json:"status,optional"`
		Type       string    `json:"type,optional"` //工单类型: deviceMaintenance:设备维修工单
		AreaID     int64     `json:"areaID,string,optional"` //区域ID过滤
		Number     string    `json:"number,optional"` //编号
		OnlyMine   bool      `json:"onlyMine,optional"` //仅查看当前用户提交的工单
		RaiseUserID int64    `json:"raiseUserID,string,optional"` //按提单人过滤
	}
	OpsWorkOrderGetListResp {
		PageResp
		List []*OpsWorkOrder `json:"list"` //菜单列表
	}
)

