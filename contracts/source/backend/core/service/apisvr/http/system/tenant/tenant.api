info (
	title:   "租户管理模块"
	desc:    "租户管理"
	author:  "L"
	email:   "174805676@qq.com"
	version: "v0.1.0"
)

@server (
	group:            system/tenant/info
	prefix:           /api/v1/system/tenant/info
	accessCodePrefix: "systemTenantManage"
	accessNamePrefix: "租户管理"
	accessGroup:      "租户管理"
	defaultAuthType:  "platform"
	defaultNeedAuth:  "true"
	middleware:       CheckTokenWare,InitCtxsWare
)
service api {
	@doc (
		summary: "添加租户"
		description: "业务说明：创建新的租户实体，设置租户名称、编码、状态等基本信息。已登录用户可为自己创建首个企业，平台管理员也可用于平台管理后台的租户开通功能。"
	    authType: "all"
		group: "system/tenant/info"
		resource: "system/tenant/info"
		action: "create"
		recordLogMode: "1"
	)
	@handler create
	post /create (TenantInfo) returns (WithIDOrCode)

	@doc (
		summary: "获取租户列表"
		description: "业务说明：分页查询租户列表，支持按名称、编码、状态过滤。平台管理员可查看所有租户，普通租户管理员只能查看自己租户。用于租户管理列表页。"
	    authType: "platform"
		group: "system/tenant/info"
		resource: "system/tenant/info"
		action: "view"
		recordLogMode: "3"
	)
	@handler getList
	post /get-list (TenantInfoGetListReq) returns (TenantInfoGetListResp)

	@doc (
		summary:    "获取租户详情"
		description: "业务说明：查询单个租户的完整信息，包括名称、编码、状态、所有者等。用于租户详情页展示、编辑表单初始化。租户管理员可查看自己租户，平台管理员可查看任意租户。"
		authType:   "admin"
		accessCode: "systemTenantManageGetOneOne"
		accessName: "获取租户信息"
		group: "system/tenant/info"
		resource: "system/tenant/info"
		action: "view"
		recordLogMode: "3"
	)
	@handler getOne
	post /get-one (WithIDOrCode) returns (TenantInfo)

	@doc (
		summary:    "更新租户"
		description: "业务说明：修改租户的基本信息，如名称、状态、联系人等。租户管理员可更新自己租户，平台管理员可更新任意租户。用于租户编辑功能。"
		authType:   "admin"
		accessCode: "systemTenantManageUpdateOne"
		accessName: "更新租户信息"
		group: "system/tenant/info"
		resource: "system/tenant/info"
		action: "update"
		recordLogMode: "1"
	)
	@handler update
	post /update (TenantInfo)

	@doc (
		summary: "删除租户"
		description: "业务说明：删除租户实体及其关联数据（用户、角色、配置等）。仅平台管理员可操作，用于平台管理后台的租户注销功能。删除前需确保租户下无活跃资源。"
	    authType: "platform"
		group: "system/tenant/info"
		resource: "system/tenant/info"
		action: "delete"
		recordLogMode: "1"
	)
	@handler delete
	post /delete (WithIDOrCode)

	@doc (
		summary:    "转让租户"
		description: "业务说明：将租户所有权转让给其他用户。支持两种模式：不传tenantCode时为自助转让，仅当前租户所有者可操作；携带tenantCode时为强制转让，仅平台管理员可操作，可将任意租户转让给该租户下的启用成员，用于原所有者失联等平台管理场景。转让后原所有者变为普通成员，新所有者获得企业主身份并自动补齐该租户管理员角色。"
		authType:   "admin"
		accessCode: "systemTenantManageTransfer"
		accessName: "转让租户所有权（仅所有者）"
		group: "system/tenant/info"
		resource: "system/tenant/info"
		action: "transfer"
		recordLogMode: "1"
	)
	@handler transfer
	post /transfer (TenantInfoTransferReq)
}

@server (
	group:            system/tenant/config
	prefix:           /api/v1/system/tenant/config
	accessNamePrefix: "租户配置"
	accessGroup:      "租户管理"
	defaultAuthType:  "admin"
	defaultNeedAuth:  "true"
	middleware:       CheckTokenWare,InitCtxsWare
)
service api {
	@doc (
		summary:    "更新租户配置"
		description: "业务说明：更新租户级配置信息，如注册角色、自动创建项目等配置项。仅租户管理员可操作，用于定制租户的默认行为策略。"
		authType:   "admin"
		isNeedAuth: "true"
		group: "system/tenant/config"
		resource: "system/tenant/config"
		action: "update"
		recordLogMode: "1"
	)
	@handler update
	post /update (TenantConfig)

	@doc (
		summary:    "获取租户配置"
		description: "业务说明：查询当前租户的配置详情，包括注册默认角色、自动创建项目/区域策略等。用于租户管理页面展示和编辑配置。"
		authType:   "admin"
		isNeedAuth: "true"
		group: "system/tenant/config"
		resource: "system/tenant/config"
		action: "view"
		recordLogMode: "3"
	)
	@handler getOne
	post /get-one (WithTenantCode) returns (TenantConfig)
}

@server (
	group:            system/tenant/core
	prefix:           /api/v1/system/tenant/core
	accessCodePrefix: "systemTenantCore"
	accessNamePrefix: "租户配置"
	accessGroup:      "租户管理"
	middleware:       InitCtxsWare
)
service api {
	@doc(
	    summary: "获取租户信息"
	    description: "业务说明：查询租户的核心信息（编码、名称等），用于轻量级的租户信息获取场景，如跨服务调用时的租户信息查询。"
	    authType: "admin"
	    group: "system/tenant/core"
	    resource: "system/tenant/core"
	    action: "view"
	    recordLogMode: "3"
	)
	@handler getOne
	post /get-one (WithIDOrCode) returns (TenantCore)

	@doc(
	    summary: "搜索租户信息"
	    description: "业务说明：搜索租户核心信息列表，支持按编码、名称、绑定应用过滤。用于租户选择器、关联查询等场景。"
	    authType: "admin"
	    group: "system/tenant/core"
	    resource: "system/tenant/core"
	    action: "view"
	    recordLogMode: "3"
	)
	@handler getList
	post /get-list (TenantCoreGetListReq) returns (TenantCoreGetListResp)
}

@server (
	group:            system/tenant/agreement
	prefix:           /api/v1/system/tenant/agreement
	accessNamePrefix: "租户协议"
	accessGroup:      "租户协议"
	middleware:       CheckTokenWare,InitCtxsWare
)
service api {
	@doc (
		summary:    "添加协议"
		description: "业务说明：创建租户专属协议，如用户协议、隐私政策等。仅租户管理员可操作，用于租户协议管理功能。用户注册/登录时可要求确认协议。"
		authType:   "admin"
		isNeedAuth: "true"
		group: "system/tenant/agreement"
		resource: "system/tenant/agreement"
		action: "create"
		recordLogMode: "1"
	)
	@handler create
	post /create (TenantAgreement) returns (WithID)

	@doc(
	    summary: "获取协议列表"
	    description: "业务说明：查询租户的协议列表，分页返回。用于协议管理列表页展示，租户管理员可管理本租户协议。"
	    authType: "admin"
	    group: "system/tenant/agreement"
	    resource: "system/tenant/agreement"
	    action: "view"
	    recordLogMode: "3"
	)
	@handler getList
	post /get-list (TenantAgreementGetListReq) returns (TenantAgreementGetListResp)

	@doc (
		summary:    "更新协议"
		description: "业务说明：修改租户协议的内容、标题等。仅租户管理员可操作，用于协议编辑功能。"
		authType:   "admin"
		isNeedAuth: "true"
		group: "system/tenant/agreement"
		resource: "system/tenant/agreement"
		action: "update"
		recordLogMode: "1"
	)
	@handler update
	post /update (TenantAgreement)

	@doc (
		summary:    "删除协议"
		description: "业务说明：删除租户协议。仅租户管理员可操作，用于协议管理中的删除功能。删除后用户将不再被要求确认该协议。"
		authType:   "admin"
		isNeedAuth: "true"
		group: "system/tenant/agreement"
		resource: "system/tenant/agreement"
		action: "delete"
		recordLogMode: "1"
	)
	@handler delete
	post /delete (WithID)
}

@server (
	group:      system/tenant/agreement
	prefix:     /api/v1/system/tenant/agreement
	middleware: InitCtxsWare
)
service api {
	@doc(
	    summary: "获取协议详情"
	    description: "业务说明：查询单个协议的完整内容，包括标题、正文等。用于协议详情页展示或用户确认协议时的内容获取。"
	    authType: "admin"
	    group: "system/tenant/agreement"
	    resource: "system/tenant/agreement"
	    action: "view"
	    recordLogMode: "3"
	)
	@handler getOne
	post /get-one (WithIDOrCode) returns (TenantAgreement)
}

@server (
	group:            system/tenant/user
	prefix:           /api/v1/system/tenant/user
	accessCodePrefix: "systemTenantUser"
	accessNamePrefix: "租户用户"
	accessGroup:      "租户管理"
	defaultNeedAuth:  "true"
	defaultAuthType:  "admin"
	middleware:       CheckTokenWare,InitCtxsWare
)
service api {
	@doc (
		summary: "邀请用户加入租户"
		description: "业务说明：邀请已注册用户加入当前租户，可指定分配的角色。被邀请用户将收到通知，确认后成为租户成员。用于用户邀请功能。"
	    authType: "admin"
		group: "system/tenant/user"
		resource: "system/tenant/user"
		action: "invite"
		recordLogMode: "1"
	)
	@handler invite
	post /invite (TenantUserInviteReq)

	@doc (
		summary: "批量添加用户加入租户"
		description: "业务说明：批量将用户添加到租户，可设置状态、部门、角色、标签等。仅租户管理员可操作，用于批量导入用户或系统初始化场景。"
	    authType: "admin"
		group: "system/tenant/user"
		resource: "system/tenant/user"
		action: "create"
		recordLogMode: "1"
	)
	@handler batchCreate
	post /batch-create (TenantUserBatchCreateReq)

	@doc (
		summary: "获取租户用户列表"
		description: "业务说明：分页查询租户下的用户列表，支持按状态、用户名、手机号、邮箱、部门、角色过滤。用于用户管理列表页，租户管理员可管理本租户用户。"
	    authType: "admin"
		group: "system/tenant/user"
		resource: "system/tenant/user"
		action: "view"
		recordLogMode: "3"
	)
	@handler getList
	post /get-list (TenantUserGetListReq) returns (TenantUserGetListResp)

	@doc (
		summary: "更新租户用户"
		description: "业务说明：修改租户用户的信息，如状态、部门、角色、标签等。仅租户管理员可操作，用于用户编辑功能。"
	    authType: "admin"
		group: "system/tenant/user"
		resource: "system/tenant/user"
		action: "update"
		recordLogMode: "1"
	)
	@handler update
	post /update (UserTenant)

	@doc (
		summary: "删除租户用户"
		description: "业务说明：将用户从租户中移除，用户将无法访问该租户的资源。仅租户管理员可操作，用于用户管理中的移除功能。"
	    authType: "admin"
		group: "system/tenant/user"
		resource: "system/tenant/user"
		action: "delete"
		recordLogMode: "1"
	)
	@handler delete
	post /delete (WithTenantUserID)

	@doc (
		summary: "获取租户用户详情,会同时返回所拥有的角色列表"
		description: "业务说明：查询单个租户用户的完整信息，包括用户基本信息、角色分配、部门归属等。用于用户详情页或编辑表单初始化。"
	    authType: "admin"
		group: "system/tenant/user"
		resource: "system/tenant/user"
		action: "view"
		recordLogMode: "3"
	)
	@handler getOne
	post /get-one (WithTenantUserID) returns (UserTenant)

	@doc (
		summary: "生成租户用户邀请码"
		description: "业务说明：生成租户邀请码，可设置有效期和默认角色。邀请码可用于邀请新用户加入租户，用户注册时填写邀请码自动分配角色。"
	    authType: "admin"
		group: "system/tenant/user"
		resource: "system/tenant/user"
		action: "invite"
		recordLogMode: "1"
	)
	@handler inviteCodeGen
	post /invite-code/gen (TenantUserInviteCodeGenReq) returns (TenantUserInviteCodeGenResp)

	@doc (
		summary: "获取当前有效的租户用户邀请码"
		description: "业务说明：查询租户当前有效的邀请码信息，包括邀请码、有效期、关联角色。用于邀请码管理页面展示。"
	    authType: "admin"
		group: "system/tenant/user"
		resource: "system/tenant/user"
		action: "invite"
		recordLogMode: "1"
	)
	@handler inviteCodeGetOne
	post /invite-code/get-one returns (TenantUserInviteCodeGenResp)

	@doc (
		summary: "发送邀请（支持邮件和手机号）"
		description: "业务说明：通过邮件或手机号向未注册用户发送租户邀请，系统自动识别地址类型。被邀请用户收到邀请链接/短信，注册后自动加入租户。"
	    authType: "admin"
		group: "system/tenant/user"
		resource: "system/tenant/user"
		action: "send"
		recordLogMode: "1"
	)
	@handler inviteSend
	post /invite-send (TenantUserInviteSendReq)

	@doc (
		summary: "获取待处理邀请列表"
		description: "业务说明：查询租户已发送但尚未被接受的邀请列表，支持按邀请类型（邮件/手机号）过滤。用于邀请状态管理和撤销功能。"
	    authType: "admin"
		group: "system/tenant/user"
		resource: "system/tenant/user"
		action: "invite"
		recordLogMode: "1"
	)
	@handler invitePendingGetList
	post /invite-pending/get-list (TenantUserInvitePendingGetListReq) returns (TenantUserInvitePendingGetListResp)

	@doc (
		summary: "删除待处理邀请"
		description: "业务说明：撤销已发送的邀请，被邀请用户将无法通过该邀请加入租户。用于邀请管理中的撤销功能。"
	    authType: "admin"
		group: "system/tenant/user"
		resource: "system/tenant/user"
		action: "invite"
		recordLogMode: "1"
	)
	@handler invitePendingDelete
	post /invite-pending/delete (TenantUserInvitePendingDeleteReq)
}

type (
	TenantCoreGetListReq {
		Page  *PageInfo `json:"page,optional"` // 分页信息
		AppID int64     `json:"appID,string,optional"` //过滤绑定了指定app的租户
		Code  string    `json:"code,optional"` // 编号
		Name  string    `json:"name,optional"` // 租户名称
	}
	TenantCoreGetListResp {
		List []*TenantCore `json:"list"` // 列表数据
		PageResp
	}
)

type (
	TenantAgreement {
		ID      int64  `json:"id,string,optional"` // 编号
		Code    string `json:"code,optional"` // 编号
		Name    string `json:"name,optional"` // 协议名称
		Title   string `json:"title,optional"` //协议标题
		Content string `json:"content,optional"` //协议内容(只有详情会返回)
	}
	TenantAgreementGetListReq {
		Page *PageInfo `json:"page,optional"` // 分页信息
	}
	TenantAgreementGetListResp {
		List []*TenantAgreement `json:"list"` // 列表数据
		PageResp
	}
)

type (
	TenantUserInviteReq {
		UserIDs  []int64  `json:"userIDs,string,optional"` // 用户ID列表
		Accounts []string `json:"accounts,optional"` // 账号列表(userIDs没有取这个)
		RoleID   int64    `json:"roleID,string,optional"` // 角色ID,默认取这个
		RoleCode string   `json:"roleCode,optional"` // 角色code,如果有重复的,则只授权第一个角色
	}
	TenantUserBatchCreateReq {
		Users []*UserTenantCore `json:"users"` // 用户列表
	}
	UserTenantCore {
		UserID  int64             `json:"userID,string"` // 用户ID,新增必填
		Status  int64             `json:"status,optional"` // 租户状态（1:启用(默认)，2:禁用）
		DeptIDs []int64           `json:"deptIDs,string,optional"` // 部门ID列表,默认展示第一个(可选)
		RoleIDs []int64           `json:"roleIDs,string,optional"` // 角色ID(新增必填)
		Tags    map[string]string `json:"tags,optional"` // 私有标签,只有管理员可以修改(可选)
		PubTags map[string]string `json:"pubTags,optional"` // 公共的标签,用户自己可以修改(可选)
	}
	TenantUserGetListReq {
		Page           *PageInfo `json:"page,optional"` // 分页信息
		Status         int64     `json:"status,optional"` // 租户状态（1:启用，2:禁用）
		UserName       string    `json:"userName,optional"` // 用户名
		Phone          string    `json:"phone,optional"` // 手机号
		Email          string    `json:"email,optional"` // 邮箱
		UserIDs        []int64   `json:"userIDs,string,optional"` // 用户ID列表
		Account        string    `json:"account,optional"` // 账号
		HasAccessAreas []int64   `json:"hasAccessAreas,optional"` // 拥有访问权限的区域
		RoleCode       string    `json:"roleCode,optional"` // 角色编码
		DeptID         int64     `json:"deptID,string,optional"` // 部门ID
		NickName       string    `json:"nickName,optional"` // 昵称
		TenantCode     string    `json:"tenantCode,optional"` // 租户代码,(平台管理员查看其他租户下的用户时使用,普通租户只能查看自己的用户)
		WithRole       bool      `json:"withRole,optional"` //同时返回角色信息
	}
	TenantUserGetListResp {
		List []*UserTenant `json:"list"` // 用户列表
		PageResp
	}
	WithTenantUserID {
		UserID     int64  `json:"userID,string"` // 用户ID
		TenantCode string `json:"tenantCode,optional"` // 租户代码,(平台管理员查看其他租户下的用户时使用,普通租户只能查看自己的用户)
	}
)

type (
	TenantInfoTransferReq {
		NewOwnerUserID int64  `json:"newOwnerUserID,string"` // 新的租户所有者用户ID
		TenantCode     string `json:"tenantCode,optional"`   // 目标租户编码;平台管理员强制转让时必填(需超管权限),企业主自助转让不传(默认当前登录者所在租户)
	}
	TenantInfoGetListReq {
		Page          *PageInfo `json:"page,optional"` // 分页信息,只获取一个则不填
		Name          string    `json:"name,optional"` // 租户名称
		Code          string    `json:"code,optional"` // 租户编号
		TenantCodes   []string  `json:"tenantCodes,optional"` // 指定租户编码列表，非空时按编码精确返回
		Status        int64     `json:"status,optional"` //租户状态
		WithOwnerUser bool      `json:"withOwnerUser,optional"` //同时获取管理员核心信息
		IsGetAll      bool      `json:"isGetAll,optional"` //是否返回所有,只有平台管理员有权限
		OwnerUserID   int64     `json:"ownerUserID,string,optional"` // 超级管理员id,只有平台管理员有权限
	}
	TenantInfoGetListResp {
		List []*TenantInfo `json:"list"` // 租户列表数据
		PageResp
	}
	//    TenantConfig{
	//        ID int64 `json:"id,string,optional"`
	//        TenantCode                string                                   `json:"tenantCode,optional"`  // 租户编码
	//        RegisterRoleID            int64                                    `json:"registerRoleID,string,optional"`  //注册分配的角色id
	//    }
	//    TenantConfigRegisterAutoCreateProject  {
	//        ID int64 `json:"id,string,optional"`
	//        ProjectName  string                                   `json:"projectName"`
	//        IsSysCreated int64                                    `json:"isSysCreated"` //是否是系统创建的,系统创建的只有管理员可以删除
	//        Areas        []*TenantConfigRegisterAutoCreateArea `json:"areas,optional"`
	//    }
	//    TenantConfigRegisterAutoCreateArea  {
	//        ID int64 `json:"id,string,optional"`
	//        AreaName     string `json:"areaName"`
	//        AreaImg      string `json:"areaImg,optional"`
	//        IsUpdateAreaImg bool   `json:"isUpdateAreaImg,omitempty,optional"`
	//        IsSysCreated int64  `json:"isSysCreated"` //是否是系统创建的,系统创建的只有管理员可以删除
	//    }
	// ==================== 租户用户邀请相关类型定义 ====================
	// 生成租户用户邀请码请求
	TenantUserInviteCodeGenReq {
		TenantCode string `json:"tenantCode,optional"` // 租户编码（可选，不填取header）
		RoleID     int64  `json:"roleID,string"` // 分配的角色ID（必填）
	}
	// 生成租户用户邀请码响应
	TenantUserInviteCodeGenResp {
		Code           string `json:"code"` // 邀请码
		ValidUntilTime int64  `json:"validUntilTime,string"` // 有效期截止时间（毫秒时间戳）
		RoleID         int64  `json:"roleID,string"` // 角色ID
	}
	// 发送邀请请求（统一接口，支持邮件和手机号，自动识别类型）
	TenantUserInviteSendReq {
		TenantCode     string   `json:"tenantCode,optional"` // 租户编码（可选，不填取header）
		RoleID         int64    `json:"roleID,string"` // 分配的角色ID（必填）
		Addresses      []string `json:"addresses"` // 邀请地址列表（邮箱或手机号，自动识别类型）
		ValidUntilTime int64    `json:"validUntilTime,string,optional"` // 有效期到（毫秒时间戳，不填使用默认值）
	}
	// 租户用户邀请信息（统一的邀请数据结构）
	TenantUserInvite {
		InviteType     string `json:"inviteType"` // 邀请类型：email（邮件）、phone（手机号）
		Address        string `json:"address"` // 邮箱地址或手机号
		RoleID         int64  `json:"roleID,string"` // 角色ID
		ValidUntilTime int64  `json:"validUntilTime,string"` // 有效期到（毫秒时间戳）
		CreatedTime    int64  `json:"createdTime,string"` // 创建时间（毫秒时间戳）
	}
	// 获取待处理邀请列表请求
	TenantUserInvitePendingGetListReq {
		TenantCode string `json:"tenantCode,optional"` // 租户编码（可选，不填取header）
		InviteType string `json:"inviteType,optional"` // 邀请类型筛选（可选：email/phone，不填返回全部）
	}
	// 获取待处理邀请列表响应
	TenantUserInvitePendingGetListResp {
		List []*TenantUserInvite `json:"list"` // 待处理邀请列表
	}
	// 删除待处理邀请请求
	TenantUserInvitePendingDeleteReq {
		TenantCode string `json:"tenantCode,optional"` // 租户编码（可选，不填取header）
		InviteType string `json:"inviteType"` // 邀请类型：email/phone
		Address    string `json:"address"` // 邮箱地址或手机号
	}
)
