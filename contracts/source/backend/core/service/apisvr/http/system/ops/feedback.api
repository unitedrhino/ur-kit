info (
	desc:   "菜单权限"
	author: "lbs"
	email:  "174805676@qq.com"
)

@server (
	group:            system/ops/feedback
	prefix:           /api/v1/system/ops
	accessNamePrefix: "帮助与反馈"
	accessGroup:      "运营管理"
	defaultAuthType:  "all"
	defaultNeedAuth:  "true"
	middleware:       CheckTokenWare,InitCtxsWare
)
service api {
	@doc(
	    summary: "添加帮助与反馈"
	    description: "业务说明：用户提交反馈信息，包括反馈类型（设备问题/智能场景/体验问题）、联系方式、问题描述等。反馈进入待处理状态，运营人员跟进处理。支持所有登录用户提交反馈。"
	    authType: "all"
	    group: "system/ops/feedback"
	    resource: "system/ops/feedback"
	    action: "create"
	    recordLogMode: "1"
	)
	@handler create
	post /feedback/create (OpsFeedback) returns (WithID)

	@doc(
	    summary: "更新帮助与反馈"
	    description: "业务说明：更新反馈状态和处理信息，支持状态流转（待处理→处理中→已完成）。运营人员跟进反馈时调用，记录处理进度。用户也可更新自己提交的反馈内容。"
	    authType: "all"
	    group: "system/ops/feedback"
	    resource: "system/ops/feedback"
	    action: "update"
	    recordLogMode: "1"
	)
	@handler update
	post /feedback/update (OpsFeedback) returns (WithID)

	@doc(
	    summary: "获取帮助与反馈"
	    description: "业务说明：查询反馈列表，支持按类型、状态、项目、租户等条件筛选。普通用户查看自己提交的反馈，平台管理员可查看所有租户的反馈。用于反馈管理页面的列表展示。"
	    authType: "all"
	    group: "system/ops/feedback"
	    resource: "system/ops/feedback"
	    action: "view"
	    recordLogMode: "3"
	)
	@handler getList
	post /feedback/get-list (OpsFeedbackGetListReq) returns (OpsFeedbackGetListResp)
}

type (
	OpsFeedback {
		ID                 int64     `json:"id,string,optional"`
		TenantCode         string    `json:"tenantCode,optional"`
		RaiseUserID        int64     `json:"raiseUserID,string,optional"`
		ProjectID          int64     `json:"projectID,string,optional"`
		Type               string    `json:"type,optional"` //反馈类型 设备问题:thingsDevice 智能场景:thingsScene 体验问题: experience 其他: other
		ContactInformation string    `json:"contactInformation,optional"` //联系方式
		IssueDesc          string    `json:"issueDesc,optional"` //反馈内容
		CreatedTime        int64     `json:"createdTime,string,optional"` //创建时间
		Status             int64     `json:"status,optional,range=[0:3]"` // 状态（1 待处理 2:处理中 3:已完成）
		AppID              int64     `json:"appID,string,optional"` //所属应用ID
		FeedbackUserID     int64     `json:"feedbackUserID,string,optional"` //反馈用户ID
		FeedbackType       string    `json:"feedbackType,optional"` //问题反馈类型: usageProblem/businessImpaired/businessUnavailable
		Detail             string    `json:"detail,optional"` //详细信息（页面URL + AI对话历史）
		User               *UserCore `json:"user,optional"` //获取用户类型返回
	}
	OpsFeedbackGetListReq {
		Page          *PageInfo `json:"page,optional"` // 分页信息,只获取一个则不填
		Type          string    `json:"type,optional"` //反馈类型 设备问题:thingsDevice 智能场景:thingsScene 体验问题: experience 其他: other
		ProjectID     string    `json:"projectID,string,optional"` //所属项目
		Status        int64     `json:"status,optional,range=[0:3]"` // 状态（1 待处理 2:处理中 3:已完成）
		IsAllTenant   bool      `json:"isAllTenant,optional"` //default租户获取所有租户的信息
		TenantCode    string    `json:"tenantCode,optional"` //过滤所属租户,isAllTenant为true有效
		AppID         int64     `json:"appID,string,optional"` //按应用过滤
		FeedbackType  string    `json:"feedbackType,optional"` //按问题反馈类型过滤
	}
	OpsFeedbackGetListResp {
		List []*OpsFeedback `json:"list"` //菜单列表
		PageResp
	}
)
