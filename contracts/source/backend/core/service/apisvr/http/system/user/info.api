info(
	title: "用户管理模块"
	desc: "用户管理相关接口，包括创建账号，登录，获取验证码，获取用户列表，获取单个用户信息，更新用户信息，删除用户"
	author: "L"
	email: "174805676@qq.com"
	version: "v0.1.0"
)
//import "common.api"  //公共结构体定义
//import "system.api"



@server (
	group: system/user/info
	prefix: /api/v1/system/user/info
	accessCodePrefix: "systemUserManage"
	accessNamePrefix: "用户信息"
	accessGroup: "用户管理"
	defaultAuthType: "admin"
	defaultNeedAuth: "true"
	middleware:  CheckTokenWare,InitCtxsWare
)
service api {
	@doc(
	    summary: "创建用户信息"
	    description: "业务说明：管理员创建新用户账号，设置用户名、密码、邮箱、手机号等基本信息，并可为用户分配角色。创建成功后返回用户ID。用于平台管理员或租户管理员添加新用户。"
	    authType: "admin"
	    group: "system/user/info"
	    resource: "system/user/info"
	    action: "create"
	    recordLogMode: "1"
	)
	@handler create
	post /create (UserInfoCreateReq) returns (UserCreateResp)

	@doc(
	    summary: "查询用户信息列表"
	    description: "业务说明：分页查询用户列表，支持按用户名、手机号、邮箱、昵称等条件过滤。用于用户管理界面的列表展示、用户搜索等场景。返回用户基本信息及所属租户列表。"
	    authType: "admin"
	    group: "system/user/info"
	    resource: "system/user/info"
	    action: "view"
	    recordLogMode: "3"
	)
	@handler getList
	post /get-list (UserInfoGetListReq) returns (UserInfoGetListResp)

	@doc(
	    summary: "更新用户基本数据"
	    description: "业务说明：管理员更新用户的基本信息，包括用户名、昵称、邮箱、手机号、性别、头像等。平台管理员可修改敏感字段（用户名、邮箱、手机号），普通租户管理员权限受限。支持部分更新，未传字段保持原值。"
	    authType: "admin"
	    group: "system/user/info"
	    resource: "system/user/info"
	    action: "update"
	    recordLogMode: "1"
	)
	@handler update
	post /update (UserInfoUpdateReq) returns ()

	@doc(
	    summary: "获取用户信息"
	    description: "业务说明：获取单个用户的详细信息，包括用户基本信息、所属租户列表、绑定的第三方账号等。可指定是否同时返回租户详情。用于用户详情页、用户编辑前的数据加载等场景。"
	    authType: "admin"
	    group: "system/user/info"
	    resource: "system/user/info"
	    action: "view"
	    recordLogMode: "3"
	)
	@handler getOne
	post /get-one (UserInfoGetOneReq) returns (UserInfo)

	@doc(
	    summary: "刪除用户"
	    description: "业务说明：删除指定用户账号。删除后用户无法登录，相关数据（租户归属、角色绑定等）同步清理。用于用户账号注销、离职员工账号清理等场景。需确认用户无重要业务数据关联后再执行。"
	    authType: "admin"
	    group: "system/user/info"
	    resource: "system/user/info"
	    action: "delete"
	    recordLogMode: "1"
	)
	@handler delete
	post /delete (UserInfoDeleteReq) returns ()

	@doc(
	    summary: "重置用户密码"
	    description: "业务说明：平台管理员为任意用户重置登录密码，用于忘记密码的兜底处理与账号安全管理。入参password为原始密码明文（与管理员创建用户接口同口径，HTTPS内传输），后端按系统配置等级对明文做真实强度校验后以bcrypt(SHA256)存储，重置成功后清除该用户全部登录态强制重新登录。仅平台管理员可操作，租户管理员与普通用户无权限。"
	    authType: "platform"
	    group: "system/user/info"
	    resource: "system/user/info"
	    action: "update"
	    recordLogMode: "2"
	)
	@handler resetPwd
	post /reset-pwd (UserInfoResetPwdReq) returns ()
}



type (
//	 UserInfo {
//		UserID         int64  `json:"userID,string,optional"`        // 用户id
//		UserName    string `json:"userName,optional"`          // 用户名(唯一)
