//	 	Roles []*RoleInfo `json:"roles,optional,omitempty"`
//		Tenant *TenantInfo `json:"tenant,optional,omitempty"`
//		Projects []*ProjectInfo `json:"projects,optional,omitempty"`    //项目列表
//	 	Depts []*DeptInfo `json:"depts,optional,omitempty"`
//        BindThird map[string]string `json:"bindThird,optional,omitempty"` //key为: wx:微信  ding: 钉钉 Value有值代表已绑定
//	 }
//     UserTenant{
//        TenantCode string `json:"tenantCode,optional"`
//        UserID         int64  `json:"userID,string,optional"`        // 用户id
//        DeviceCount int64  `json:"deviceCount,optional,omitempty"` //用户所拥有的设备数量统计
//        Status int64  `json:"status,optional"`
//        DeptIDs 		[]string `json:"deptIDs,optional,omitempty"` //部门ID列表
//        Tags    map[string]string       `json:"tags,optional,omitempty"` //私有标签,只有管理员可以修改
//        PubTags  map[string]string      `json:"pubTags,optional,omitempty"`  // 公共的标签,用户自己可以修改
//     }

 // UserInfoUpdateReq 用户信息更新请求（仅包含可更新字段）
 UserInfoUpdateReq {
    UserID   int64    `json:"userID,string"`               // 用户ID（必填）
    UserName string   `json:"userName,optional"`           // 登录用户名,,平台管理员可修改
    NickName string   `json:"nickName,optional"`           // 用户昵称
    Email    *string  `json:"email,optional"`              // 邮箱,平台管理员可修改
    Phone    *string  `json:"phone,optional"`              // 手机号,平台管理员可修改
    Sex      int64    `json:"sex,optional"`                // 性别（1:男，2:女，0:未知）
    Avatar   string   `json:"avatar,optional"`             // 头像（传图片的filePath）
}

 UserInfo  {
    UserID      int64            `json:"userID,string,optional,omitempty"`        // 用户id
    UserName    string   `json:"userName,optional,omitempty"` // 登录用户名
    NickName    string           `json:"nickName,optional,omitempty"`                                     // 用户的昵称
    Password    string           `json:"password,optional,omitempty"`                                         // 登录密码
    Email       *string   `json:"email,optional,omitempty"` // 邮箱
    Phone       *string   `json:"phone,optional,omitempty"`  // 手机号
    LastIP      string           `json:"lastIP,optional,omitempty"`                                      // 最后登录ip
    LastTokenID string           `json:"lastTokenID,optional,omitempty"`                     // 最后登录的token ID
    LastLoginTime int64  `json:"lastLoginTime,string,optional,omitempty"` // 最后登录时间(毫秒时间戳)
    RegIP       string           `json:"regIP,optional,omitempty"`                                       // 注册ip
    Sex         int64            `json:"sex,optional,omitempty"`                                    // 用户的性别，值为1时是男性，值为2时是女性，其他值为未知
    City        string           `json:"city,optional,omitempty"`                                          // 用户所在城市
    Country     string           `json:"country,optional,omitempty"`                                       // 用户所在国家
    Province    string           `json:"province,optional,omitempty"`                                      // 用户所在省份
    Language    string           `json:"language,optional,omitempty"`                                      // 用户的语言，简体中文为zh_CN
    Avatar      string           `json:"avatar,optional,omitempty"`                                       // 头像,更新的时候传 图片的filePath
    Tenants     []*UserTenant `json:"tenants,optional,omitempty"`
    Thirds      []*UserThird  `json:"thirds,optional,omitempty"`
    CreatedTime int64  `json:"createdTime,string,optional,omitempty"`// 创建时间
}

UserTenant  {
    TenantCode    string `json:"tenantCode,optional,omitempty"` // 租户编码,只读
    UserID        int64               `json:"userID,string,optional,omitempty"`           // 用户id,只读
    DeviceCount   int64               `json:"deviceCount,optional,omitempty"`                                                         //用户所拥有的设备数量统计,只读
    IsTenantOwner int64            `json:"isTenantOwner,optional,omitempty"`                                //是否是租户管理员,只读
    Status        int64               `json:"status,optional,omitempty"`                    //用户状态(管理员才可修改): 1启用 2禁用
    DeptIDs       []int64           `json:"deptIDs,optional,string,omitempty"` //部门ID列表,默认展示第一个
    Tags          map[string]string   `json:"tags,optional,omitempty"`     // 管理员才可修改的标签
    PubTags       map[string]string   `json:"pubTags,optional,omitempty"` // 公共的标签,用户自己可以修改
    CreatedTime int64  `json:"createdTime,string,optional,omitempty"`// 创建时间,只读
    Roles []*RoleInfo `json:"roles,optional"` // 角色列表
	User *UserCore `json:"user,omitempty,optional"` //只读
	Tenant *TenantCore `json:"tenant,omitempty,optional"` //只读
}


 UserThird  {
    AppType    string       `json:"appType,optional,omitempty"` //应用类型: wx:微信, wxMiniP:微信小程序, wxOpen:微信开放平台登录, ding:钉钉应用
    ThirdAppID string              `json:"thirdAppID,optional,omitempty"`
    CreatedTime int64  `json:"createdTime,string,optional,omitempty"`// 创建时间
}

	UserCreateResp {
		UserID         int64  `json:"userID,string,optional"`        // 用户id
	}


	 UserInfoCreateReq{
	 	Info *UserInfo `json:"info"`
	 	RoleIDs 		[]int64 `json:"roleIDs,string,optional,range=(0:120]"` //平台的角色编号列表
	 }
	UserInfoGetListReq {
		Page *PageInfo `json:"page,optional"` //分页信息
		UserName    string `json:"userName,optional"`          //用户名(唯一)
		Phone       string `json:"phone,optional"`             // 手机号
		Email       string `json:"email,optional"`             // 邮箱
		Account string  `json:"account,optional"`
		UserIDs []int64  `json:"userIDs,string,optional"`
		// HasAccessAreas []int64 `json:"hasAccessAreas,string,optional"` //查询拥有该区域权限的用户
		// DeptID int64 `json:"deptID,string,optional"`
		// RoleCode string  `json:"roleCode,optional"` //查询角色code
		NickName    string `json:"nickName,optional"`          // 用户的昵称
		// WithRoles bool  `json:"withRoles,optional"` //同时返回所有的角色列表
		// WithDepts bool  `json:"withDepts,optional"` //同时返回所属的部门列表
	}

	UserInfoGetListResp {
		List  []*UserInfo `json:"list,omitempty"`           //用户信息列表
		PageResp
	}

	UserInfoGetOneReq{
		UserID         int64  `json:"userID,string,optional"`        // 用户id
		// WithRoles bool  `json:"withRoles,optional"`
		WithTenant bool `json:"withTenant,optional"`
		// WithDepts bool  `json:"withDepts,optional"` //同时返回所属的部门列表
	}

	UserInfoDeleteReq {
		UserID         int64  `json:"userID,string,optional"`        // 用户id
	}

	UserInfoResetPwdReq {
		UserID   int64  `json:"userID,string"`     // 目标用户ID（必填）
		Password string `json:"password"`          // 新密码（原始密码明文，与管理员创建用户接口同口径）
	}
)

