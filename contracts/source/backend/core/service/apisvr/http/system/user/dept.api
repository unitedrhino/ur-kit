info(
    title: "用户数据权限管理模块"
    desc: "用户数据权限管理接口"
    author: "godLei6"
    email: "603785348@qq.com"
    version: "v1"
)


@server (
    group: system/user/dept
    prefix: /api/v1/system/user/dept
    accessCodePrefix: "systemUserManage"
    accessNamePrefix: "用户部门"
    accessGroup: "用户管理"
    defaultAuthType: "admin"
    defaultNeedAuth: "true"
    middleware:  CheckTokenWare,InitCtxsWare
)
service api {
    @doc(
        summary: "新增用户的部门列表"
        description: "业务说明：为指定用户批量添加部门归属关系，支持一次性绑定多个部门。用于新用户入职分配部门、用户部门调整等场景。添加后用户将继承部门对应的权限和数据范围。"
        authType: "admin"
        group: "system/user/dept"
        resource: "system/user/dept"
        action: "create"
        recordLogMode: "1"
    )
    @handler batchCreate
    post /batch-create (UserDeptMultiSaveReq) returns ()
    @doc(
        summary: "删除用户的部门列表"
        description: "业务说明：批量移除指定用户的部门归属关系，支持一次性解除多个部门。用于用户部门调动、离职清理等场景。移除后用户将失去该部门对应的权限和数据访问范围。"
        authType: "admin"
        group: "system/user/dept"
        resource: "system/user/dept"
        action: "delete"
        recordLogMode: "1"
    )
    @handler batchDelete
    post /batch-delete (UserDeptMultiSaveReq) returns ()
}


//用户级权限控制
type (
    UserDeptMultiSaveReq{
        UserID         int64  `json:"userID,string"`        // 用户id
        DeptIDs 		[]int64 `json:"deptIDs,string"` //角色编号列表
    }
)