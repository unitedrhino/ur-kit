info (
	title:   "用户认证管理"
	desc:    "用户认证相关接口，包括登录、注册、忘记密码、验证码"
	author:  "L"
	email:   "174805676@qq.com"
	version: "v0.1.0"
)

@server (
	group:            system/user/self
	prefix:           /api/v1/system/user/self
	defaultAuthType:  "public"
	middleware:       InitCtxsWare
)
service api {
	@doc(
	    summary: "获取验证码"
	    description: "生成图形验证码，用于登录、注册等需要人机验证的场景，验证码5分钟内有效，返回base64编码的图片和验证码ID"
	    authType: "public"
	    group: "system/user/self"
	    resource: "system/user/self"
	    action: "captcha"
	    recordLogMode: "3"
	)
	@handler captcha
	post /captcha (UserCaptchaReq) returns (UserCaptchaResp)

	@doc(
	    summary: "用户登录"
	    description: "用户通过账号密码或手机验证码登录系统，返回会话Token用于后续API调用认证，支持多种登录类型：密码登录、验证码登录、第三方登录"
	    authType: "public"
	    group: "system/user/self"
	    resource: "system/user/self"
	    action: "login"
	    recordLogMode: "3"
	)
	@handler login
	post /login (UserLoginReq) returns (UserLoginResp)

	@doc(
	    summary: "第三方登录授权起跳"
	    description: "业务说明：根据当前应用配置生成 Huawei、Google、GitHub、Apple 的授权跳转地址，前端只传 provider 与平台类型，不允许覆盖 redirectURI。"
	    authType: "public"
	    group: "system/user/self"
	    resource: "system/user/self"
	    action: "login"
	    recordLogMode: "3"
	)
	@handler thirdAuthStart
	post /third-auth/start (UserThirdAuthStartReq) returns (UserThirdAuthStartResp)

	@doc(
	    summary: "第三方登录回调换平台登录态"
	    description: "业务说明：前端携带第三方回调 code 与 state 调用此接口，后端完成第三方身份解析、自动绑定、自动建号或返回需补全信息状态。"
	    authType: "public"
	    group: "system/user/self"
	    resource: "system/user/self"
	    action: "login"
	    recordLogMode: "3"
	)
	@handler thirdLogin
	post /third-login (UserThirdLoginReq) returns (UserThirdLoginResp)

	@doc(
	    summary: "第三方补全注册"
	    description: "业务说明：第三方登录缺少可用邮箱或手机号时，前端提交 pendingToken 与补全信息，后端完成建号、绑定并直接登录。"
	    authType: "public"
	    group: "system/user/self"
	    resource: "system/user/self"
	    action: "register"
	    recordLogMode: "3"
	)
	@handler thirdRegister
	post /third-register (UserThirdRegisterReq) returns (UserLoginResp)

	@doc(
	    summary: "普通用户注册"
	    description: "新用户注册账号，支持手机号注册和邮箱注册，注册成功后自动登录并返回会话Token"
	    authType: "public"
	    group: "system/user/self"
	    resource: "system/user/self"
	    action: "register"
	    recordLogMode: "3"
	)
	@handler register
	post /register (UserRegisterReq) returns (UserLoginResp)

	@doc(
	    summary: "忘记密码"
	    description: "用户通过手机验证码或邮箱验证码重置密码，验证身份后设置新密码"
	    authType: "public"
	    group: "system/user/self"
	    resource: "system/user/self"
	    action: "reset-password"
	    recordLogMode: "3"
	)
	@handler forgetPwd
	post /forget-pwd (UserForgetPwdReq)
}
