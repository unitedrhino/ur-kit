info(
	title: "日志管理模块"
	desc: "登录日志，操作日志"
	author: "L"
	email: "174805676@qq.com"
	version: "v0.1.0"
)

@server (
	group: system/log
	prefix: /api/v1/system/log
    accessCodePrefix: "systemLog"
    accessNamePrefix: "系统日志"
    accessGroup: "系统日志"
    defaultAuthType: "admin"
    defaultNeedAuth: "true"
	middleware:  CheckTokenWare,InitCtxsWare
)

service api {
	@doc(
	    summary: "获取登录日志列表"
	    description: "业务说明：查询用户登录日志列表，支持按IP、登录地点、时间范围、用户、登录状态筛选。用于安全审计、异常登录检测、用户行为分析等场景。返回分页结果包含登录IP、地点、浏览器、操作系统等信息。"
	    authType: "admin"
	    group: "system/log"
	    resource: "system/log"
	    action: "login"
	    recordLogMode: "3"
	)
	@handler loginGetList
	post /login/get-list (SysLogLoginGetListReq) returns (SysLogLoginGetListResp)

    @doc(
        summary: "获取操作日志列表"
        description: "业务说明：查询用户操作日志列表，支持按操作名称、操作人、业务类型、时间范围、状态筛选。用于操作审计、问题追溯、安全合规等场景。返回分页结果包含操作详情、请求参数、响应结果、执行状态等完整信息。"
        authType: "admin"
        group: "system/log"
        resource: "system/log"
        action: "view"
        recordLogMode: "3"
    )
	@handler operGetList
	post /oper/get-list (SysLogOperGetListReq) returns (SysLogOperGetListResp)
}

type (
	 SysLogLoginGetListReq {
         Page *PageInfo `json:"page,optional"`                                //分页信息,只获取一个则不填
        IpAddr string `json:"ipAddr,optional"`                     //按ip地址查找
        LoginLocation string `json:"loginLocation,optional"`       //按登录地址查找
        DateRange DateRange `json:"dateRange,optional"`            //按时间范围查找
         AppID int64 `json:"appID,string,optional"`                               // 应用编号
         UserID         int64  `json:"userID,string,optional"`        // 用户id
         UserName string `json:"userName,optional"`                                // 登录账号
         Code int64 `json:"code,string,optional"`                                  // 登录状态（200成功 其它失败）
     }

    SysLogLoginInfo {
        UserID         int64  `json:"userID,string,optional"`        // 用户id
        AppID int64 `json:"appID,string"`                               // 应用编号
        UserName string `json:"userName"`                                // 登录账号
        IpAddr string `json:"ipAddr"`                                    // 登录IP地址
        LoginLocation string `json:"loginLocation"`                      // 登录地点
        Browser string `json:"browser"`                                  // 浏览器类型
        Os string `json:"os"`                                            // 操作系统
        Code int64 `json:"code,string"`                                  // 登录状态（200成功 其它失败）
        Msg string `json:"msg"`                                          // 提示消息
        CreatedTime int64 `json:"createdTime,string"`                    // 登录时间
    }

    SysLogLoginGetListResp {
        List []*SysLogLoginInfo `json:"list"`  //登录日志列表数据
        PageResp
    }

     SysLogOperGetListReq {
        Page *PageInfo `json:"page,optional"`                               //分页信息,只获取一个则不填
        OperName string `json:"operName,optional"`                //按操作名称查找
        OperUserName string `json:"operUserName,optional"`        //按操作人员名称查找
        OperType string `json:"operType,optional"`              //操作类型（create/update/delete/get/other）
        AuthType string `json:"authType,optional"`              //认证方式（user/open）
        AccessKey string `json:"accessKey,optional"`            //open token 的 accessKey
        AppID int64 `json:"appID,string,optional"`                               // 应用编号
        OperUserID         int64  `json:"operUserID,string,optional"`        // 操作用户id
        Code int64 `json:"code,string,optional"`                            //登录状态（200成功 其它失败）
     }

    SysLogOperInfo {
        UserID         int64  `json:"userID,string,optional"`        // 用户id
        AppID int64 `json:"appID,string"`                               // 应用编号
        OperUserName string `json:"operUserName"`                  //操作人员名称
        AuthType string `json:"authType"`                          //认证方式（user/open）
        AccessKey string `json:"accessKey"`                        //open token 的 accessKey
        OperName string `json:"operName"`                          //操作名称
        OperType string `json:"operType"`                        //操作类型（create/update/delete/get/other）
        Uri string `json:"uri"`                                    //请求地址
        OperIpAddr string `json:"operIpAddr"`                      //操作主机ip地址
        OperLocation string `json:"operLocation"`                  //操作地点
        Req string `json:"req"`                                    //请求参数
        Resp string `json:"resp"`                                  //返回参数
        Code int64 `json:"code,string"`                            //登录状态（200成功 其它失败）
        Msg string `json:"msg"`                                    //提示消息
        CreatedTime int64 `json:"createdTime,string"`              //操作时间
    }
    SysLogOperGetListResp {
        List []*SysLogOperInfo `json:"list"`  //操作日志列表数据
        PageResp
    }
)
