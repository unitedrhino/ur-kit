info(
    desc: "系统配置"
    author: "lbs"
    email: "174805676@qq.com"
)
//import "common.api"  //公共结构体定义

@server (
    group: system/common
    prefix: /api/v1/system/common
    defaultAuthType: "all"
    defaultNeedAuth: "true"
    middleware:  CheckTokenWare,InitCtxsWare
)
service api {

    @doc(
        summary: "获取文件上传地址"
        description: "业务说明：生成OSS预签名上传URL，用于前端直传文件场景。返回uploadUri供前端PUT上传，filePath用于后续关联业务。支持文件重命名、公开/私有桶选择等配置。"
        authType: "all"
        group: "system/common"
        resource: "system/common"
        action: "upload"
        recordLogMode: "3"
    )
    @handler uploadUrlCreate
    post /upload-url/create (UploadUrlCreateReq) returns (UploadUrlCreateResp)
    @doc(
        summary: "文件直传"
        description: "业务说明：通过multipart/formdata直接上传文件。isPublic=false走临时桶返回临时路径；isPublic=true走公开桶返回永久fileUrl。公开桶需传business(业务)、scene(场景)、useBy(用途)。useBy=user路径前缀user/{userID}；useBy=tenant需租户管理员权限路径前缀tenant/{tenantCode}；useBy=platform需平台管理员权限路径前缀platform/。禁止上传html/php/jsp等危险文件。"
        injectFormdataParam: "file"
        authType: "all"
        group: "system/common"
        resource: "system/common"
        action: "upload"
        recordLogMode: "3"
    )
    @handler uploadFile
    post /upload-file(Empty) returns (UploadFileResp)
    @doc(
        summary: "获取天气情况"
        description: "业务说明：根据地理位置或项目ID获取实时天气和空气质量数据。用于物联网设备环境展示、户外作业提醒、能耗分析辅助等场景。数据来源于配置的天气API服务。"
        authType: "all"
        group: "system/common"
        resource: "system/common"
        action: "view"
        recordLogMode: "3"
    )
    @handler weatherGetOne
    post /weather/get-one(WeatherGetOneReq) returns (WeatherGetOneResp)
    @doc(
        summary: "websocket连接"
        description: "业务说明：建立WebSocket长连接用于实时消息推送。连接建立后自动订阅用户通知频道，支持接收告警推送、系统通知、实时数据更新等消息。适用于监控大屏、实时状态展示、即时通知等场景。"
        authType: "all"
        group: "system/common"
        resource: "system/common"
        action: "connect"
        recordLogMode: "3"
    )
    @handler websocketConnect
    get /websocket/connect () returns ()


    @doc(
        summary: "获取小程序二维码"
        description: "业务说明：生成微信小程序二维码图片。用于扫码进入指定页面、设备绑定二维码、分享推广等场景。支持指定页面路径、场景参数、环境版本（开发/体验/正式）。返回二维码图片Buffer数据。"
        authType: "all"
        group: "system/common"
        resource: "system/common"
        action: "view"
        recordLogMode: "3"
    )
    @handler qRCodeGetOneReq
    post /qr-code/get-one (QRCodeGetOneReq) returns (QRCodeGetOneResp)

    @doc(
        summary: "获取第三方部门详情"
        description: "业务说明：从钉钉、企业微信等第三方平台获取单个部门信息。用于部门同步、组织架构对接等场景。Children只返回一层，需递归调用获取完整树结构。支持获取父级和子级部门。"
        authType: "all"
        group: "system/common"
        resource: "system/common"
        action: "view"
        recordLogMode: "3"
    )
    @handler thirdDeptGetOne
    post /third/dept/get-one (ThirdDeptInfoGetOneReq) returns (DeptInfo)
    @doc(
        summary: "获取第三方部门列表"
        description: "业务说明：从钉钉、企业微信等第三方平台获取部门列表。用于部门同步、组织架构导入等场景。支持按父节点筛选获取下级部门，实现递归同步完整组织架构。"
        authType: "all"
        group: "system/common"
        resource: "system/common"
        action: "view"
        recordLogMode: "3"
    )
    @handler thirdDeptGetList
    post /third/dept/get-list (ThirdDeptInfoGetListReq) returns (DeptInfoGetListResp)

    @doc(
        summary: "批量聚合接口请求"
        description: "业务说明：一次请求调用多个API接口并聚合返回结果。用于前端页面初始化时减少请求次数、仪表盘数据聚合加载等场景。支持并行请求提升响应速度，减少网络往返开销。"
        authType: "all"
        group: "system/common"
        resource: "system/common"
        action: "view"
        recordLogMode: "3"
    )
    @handler apiBatchAgg
    post /api/batch-agg (ApiBatchAggReq) returns (ApiBatchAggResp)

    @doc(
        summary: "更新系统配置信息"
        description: "业务说明：平台管理员修改系统全局配置。包括OEM定制（Logo/标题/页脚）、短信配置、邮件配置、地图配置、天气配置等。修改后立即生效，影响所有租户用户体验。"
        authType: "platform"
        group: "system/common"
        resource: "system/common"
        action: "update"
        recordLogMode: "1"
    )
    @handler sysConfigInfoUpdate
    post /sys-config/info/update (SysConfigInfo) returns ()
    @doc(
        summary: "读取系统配置信息"
        description: "业务说明：平台管理员查询系统全局配置详情。返回完整配置包括OEM、短信、邮件、地图、天气、用户策略等。用于配置管理页面展示和编辑初始化。敏感信息（如短信密钥）仅平台超管可见。"
        authType: "platform"
        group: "system/common"
        resource: "system/common"
        action: "view"
        recordLogMode: "3"
    )
    @handler sysConfigInfoGetOne
    post /sys-config/info/get-one (Empty) returns (SysConfigInfo)
    @doc(
        summary: "读取业务地图运行配置"
        description: "业务说明：登录用户读取当前启用地图的浏览器公开参数和同源代理地址，不返回安全密钥；每次进入地图按运行配置生效。"
        authType: "all"
        group: "system/common"
        resource: "system/common"
        action: "view"
        recordLogMode: "3"
    )
    @handler mapRuntime
    post /map/runtime (Empty) returns (MapRuntimeConfig)

    @doc(
        summary: "生成OAuth Provider RSA私钥"
        description: "业务说明：平台管理员生成新的RS256签名私钥（RSA-2048，PKCS8 PEM格式），用于OIDC/OAuth2 Provider签发ID Token。生成结果返回给前端填入表单，点击保存后生效。生成新密钥后，使用旧密钥签发的ID Token将失效，接入方需重新获取公钥。"
        authType: "platform"
        group: "system/common"
        resource: "system/common"
        action: "operate"
        recordLogMode: "1"
    )
    @handler sysConfigOauthKeyGenerate
    post /sys-config/oauth/key/generate (Empty) returns (SysOauthKeyGenerateResp)
}

@server (
    group: system/common
    prefix: /api/v1/system/common
    middleware:  InitCtxsWare
)
service api {
    @doc(
        summary: "ntp时间同步"
        description: "业务说明：网络时间协议接口，用于客户端与服务器时间同步。返回设备发送时间、服务器接收时间、服务器发送时间，客户端可据此计算网络延迟并校正本地时钟。适用于物联网设备时间校准、分布式系统时钟同步。"
        authType: "public"
        group: "system/common"
        resource: "system/common"
        action: "view"
        recordLogMode: "3"
    )
    @handler ntpGetOne
    post /ntp/get-one(NtpGetOneReq) returns (NtpGetOneResp)
    @doc(
        summary: "调试接口POST"
        description: "业务说明：开发调试专用接口，返回请求URI、Headers、Body等完整信息。用于API调试、中间件验证、请求格式检查等开发场景。生产环境建议禁用或限制访问。"
        authType: "public"
        group: "system/common"
        resource: "system/common"
        action: "view"
        recordLogMode: "3"
    )
    @handler debugPost
    post /debug() returns (DebugResp)
    @doc(
        summary: "调试接口GET"
        description: "业务说明：开发调试专用接口（GET方式），返回请求URI、Headers等完整信息。用于API调试、中间件验证、请求格式检查等开发场景。生产环境建议禁用或限制访问。"
        authType: "public"
        group: "system/common"
        resource: "system/common"
        action: "view"
        recordLogMode: "3"
    )
    @handler debugGet
    get /debug() returns (DebugResp)
    @doc(
        summary: "腾讯云调试接口"
        description: "业务说明：腾讯云服务连通性测试接口。用于验证腾讯云API调用、密钥配置、网络连通等。适用于短信服务、对象存储等腾讯云集成调试场景。"
        authType: "public"
        group: "system/common"
        resource: "system/common"
        action: "view"
        recordLogMode: "3"
    )
    @handler debugGetTencent
    get /debug-tencent() returns ()

    @doc(
        summary: "下载本地文件"
        description: "业务说明：从服务器本地文件系统下载文件。用于导出报表、下载日志、获取配置文件等场景。私有文件需签名验证，签名通过URL参数传递。支持各种文件类型的下载响应。"
        authType: "public"
        group: "system/common"
        resource: "system/common"
        action: "download"
        recordLogMode: "3"
    )
    @handler downloadFile
    get /download-file(DownloadFileReq) returns ()

    @doc(
        summary: "对象存储文件代理"
        description: "业务说明：流式代理返回本站对象存储公开桶/临时桶中的文件，用于浏览器跨域拉取文件字节受限的场景（如大屏 CAD 渲染器 fetch COS 文件被 CORS 拦截）。仅接受当前环境配置的公开桶/临时桶 URL，私有桶与任意外部 URL 一律拒绝，无 SSRF 面。需登录。"
        authType: "all"
        group: "system/common"
        resource: "system/common"
        action: "view"
        recordLogMode: "3"
    )
    @handler fileProxy
    get /file-proxy(FileProxyReq) returns ()


    @doc(
        summary: "高德 JS API 安全代理"
        description: "仅代理地图初始化和地理编码白名单，校验当前平台 Web Key，并由服务端注入安全码；禁止任意上游。"
        authType: "public"
        group: "system/common"
        resource: "system/common"
        action: "view"
        recordLogMode: "3"
    )
    @handler mapProxy
    get /map/_AMapService/:version/:service/:operation(MapProxyReq) returns ()

    @doc(
        summary: "读取系统配置信息(无需登录)"
        description: "业务说明：公开接口获取系统基础配置（OEM定制信息）。用于登录页、注册页在未登录状态下展示Logo、标题、页脚等。不返回敏感配置，仅返回用户可见的界面定制信息。"
        authType: "public"
        group: "system/config/core"
        resource: "system/config/core"
        action: "view"
        recordLogMode: "3"
    )
    @handler sysConfigCoreGetOne
    post /sys-config/core/get-one (Empty) returns (SysConfigInfo)



    @doc(
        summary: "初始化系统"
        description: "业务说明：系统首次部署时的初始化接口。创建平台超级管理员用户、平台租户、默认角色（admin/client/supper）、写入OEM配置。仅在sys_user_info表为空时可执行，已初始化系统调用会报错。"
        authType: "public"
        group: "system/init"
        resource: "system/init"
        action: "execute"
        recordLogMode: "3"
    )
    @handler systemInit
    post /system/init (SystemInitReq) returns (Empty)

    @doc(
        summary: "初始化上传文件"
        description: "业务说明：系统未初始化时的文件上传接口（无需登录）。用于初始化流程上传Logo等OEM定制资源。初始化完成后此接口禁用，应使用标准upload-file接口。该接口继续禁止上传svg。"
        injectFormdataParam: "file"
        authType: "public"
        group: "system/common"
        resource: "system/common"
        action: "upload"
        recordLogMode: "3"
    )
    @handler initUploadFile
    post /init-upload-file(Empty) returns (UploadFileResp)
}


type (
    SysConfigInfo {
        DefaultLanguage string `json:"defaultLanguage,optional,omitempty"` // 平台默认语言，初始为 zh-CN
        Oem    *SysOemConfig    `json:"oem,optional,omitempty"`              // OEM配置
        Sms    *SysSmsConfig    `json:"sms,optional,omitempty"`              // 短信配置，全租户共用,非平台超管不返回该参数,也只有平台超管可修改
        Email  *SysEmailConfig `json:"email,optional,omitempty"` // 邮件配置,全租户共用,非平台超管不返回该参数,也只有平台超管可修改
        Tenant *SysTenantConfig `json:"tenant,optional,omitempty"`           // 租户配置,非管理员获取不返回该参数
        Weather *SysWeatherConfig `json:"weather,optional,omitempty"`        // 天气配置 非平台超管不返回该参数,也只有平台超管可修改
        Map    *SysMapConfig    `json:"map,optional,omitempty"`              // 地图配置
        Log    *SysLogConfig    `json:"log,optional,omitempty"`              // 日志配置
        User   *SysUserConfig   `json:"user,optional,omitempty"`             // 用户配置
        Oauth  *SysOAuthConfig  `json:"oauth,optional,omitempty"`            // OIDC/OAuth2 Provider 全局配置
    }
     SysEmailConfig  {
        IsEnable int64  `json:"isEnable,optional,omitempty"`//是否启用,1为是,2为否
        From     string `json:"from,optional,omitempty"` // 发件人  你自己要发邮件的邮箱
        Host     string `json:"host,optional,omitempty"` // 服务器地址 例如 smtp.qq.com  请前往QQ或者你要发邮件的邮箱查看其smtp协议
        Secret   string `json:"secret,optional,omitempty"` // 密钥    用于登录的密钥 最好不要用邮箱密码 去邮箱smtp申请一个用于登录的密钥
        Nickname string `json:"nickname,optional,omitempty"` // 昵称    发件人昵称 通常为自己的邮箱
        Port     int64  `json:"port,default=465,optional,omitempty"` // 端口     请前往QQ或者你要发邮件的邮箱查看其smtp协议 大多为 465
        IsSSL    int64  `json:"isSsl,default=2,optional,omitempty"` // 是否SSL   是否开启SSL
    }

    SysLogConfig {
        OperKeepDays  int64 `json:"operKeepDays,default=30"`      // 操作日志保留天数
        LoginKeepDays int64 `json:"loginKeepDays,default=30"`     // 登录日志保留天数
    }

    SysOemFooterConfig {
        CompanyName     string `json:"companyName"`               // 公司名称
        CompanySiteLink string `json:"companySiteLink,optional,omitempty"` // 公司网站链接
        Date            string `json:"date,optional,omitempty"`   // 年份或日期
        IsEnable        int64  `json:"isEnable,default=2"`        // 是否启用(1:启用，2:禁用)
        Icp             string `json:"icp,optional,omitempty"`    // ICP备案号
        IcpLink         string `json:"icpLink,optional,omitempty"` // ICP备案的跳转链接
        Beian           string `json:"beian,optional,omitempty"`  // 公安备案号
        BeianLink       string `json:"beianLink,optional,omitempty"` // 公安备案的跳转链接
    }

    SysOemConfig {
        Avatar string `json:"avatar"`                 // Logo图片地址
        Title  string `json:"title,default=联犀"`                  // 系统标题
        LoginPageTitle string `json:"loginPageTitle,optional,omitempty"` // 登录页左侧标题
        LoginPageDescription string `json:"loginPageDescription,optional,omitempty"` // 登录页左侧描述
        LoginFormTitle string `json:"loginFormTitle,optional,omitempty"` // 登录表单标题
        LoginFormDescription string `json:"loginFormDescription,optional,omitempty"` // 登录表单描述
        SloganImageType string `json:"sloganImageType,optional,omitempty,default=template,options=template|upload"` // Slogan图片类型
        SloganImageTemplate string `json:"sloganImageTemplate,optional,omitempty,default=iot-platform"` // Slogan模板ID
        SloganImage string `json:"sloganImage,optional,omitempty"` // 上传的Slogan图片
        Footer SysOemFooterConfig `json:"footer"`     // 页脚信息
    }

    SysSmsConfig {
        IsEnable int64  `json:"isEnable,optional,omitempty"`//是否启用,1为是,2为否
        Type            string `json:"type,optional,omitempty,default=ali,options=ali|tencent"`            // 短信类型, ali: 阿里云 tencent: 腾讯
        AccessKeyID     string `json:"accessKeyID,optional,omitempty"`     // AccessKey ID
        AccessKeySecret string `json:"accessKeySecret,optional,omitempty"` // AccessKey Secret
        AppID           string `json:"appID,optional,omitempty"`           // 应用ID 短信SdkAppId在 [短信控制台] 添加应用后生成的实际SdkAppId，示例如1400006666,可前往 [短信控制台](https://console.cloud.tencent.com/smsv2/app-manage) 查看
        signName          string `json:"signName,optional,omitempty"`          // 签名
    }

    SysMapProviderConfig {
        AccessKey string `json:"accessKey,optional"` // Web 访问密钥
        AccessSecret string `json:"accessSecret,optional,omitempty"` // 安全密钥，仅更新时传入
        SecretConfigured bool `json:"secretConfigured,optional"` // 已配置状态，只读
        ClearSecret bool `json:"clearSecret,optional"` // 明确清除安全密钥
    }

    MapRuntimeConfig {
        IsEnable int64 `json:"isEnable"` // 平台地图开关
        Type string `json:"type"` // 默认服务商
        AccessKey string `json:"accessKey"` // 浏览器 Web Key
        ServiceHost string `json:"serviceHost"` // 同源高德安全代理地址
        CoordinateSystem string `json:"coordinateSystem"` // 存储坐标口径 GCJ-02
    }

    MapProxyReq {
        Version string `path:"version"` // 白名单版本
        Service string `path:"service"` // 白名单服务
        Operation string `path:"operation"` // 白名单操作
    }

    SysMapConfig {
        IsEnable int64  `json:"isEnable,optional,omitempty"`//是否启用,1为是,2为否
        Type         string `json:"type,default=gaode,options=gaode|baidu|tianditu|tencent"`            // 地图服务商模式 gaode: 高德 baidu: 百度 tianditu: 天地图 tencent: 腾讯
        AccessKey    string `json:"accessKey,optional"`         // 访问密钥
        AccessSecret string `json:"accessSecret,optional,omitempty"`      // 安全密钥/Secret，选填
        Gaode *SysMapProviderConfig `json:"gaode,optional,omitempty"` // 高德独立配置
        Tianditu *SysMapProviderConfig `json:"tianditu,optional,omitempty"` // 天地图独立配置
        SecretConfigured bool `json:"secretConfigured,optional"` // 当前服务商安全密钥已配置
        ClearSecret bool `json:"clearSecret,optional"` // 明确清除当前服务商安全密钥

    }

    SysWeatherConfig {
        IsEnable int64  `json:"isEnable,optional,omitempty"`//是否启用,1为是,2为否
        ApiKey  string `json:"apiKey"`                // 天气API密钥
        ApiHost string `json:"apiHost"`               // 天气API主机地址
    }

    SysUserConfig {
        CaptchaLen        int32 `json:"captchaLen,default=6"`      // 验证码长度
        PassLevel         int64 `json:"passLevel,range=[1:4]"`       // 用户密码强度级别 1:长度大于等于8位即可 2:包含数字,大写字母,小写字母,特殊字符起码两种  3:包含数字,大写字母,小写字母,特殊字符起码3种 4:包含数字,大写字母,小写字母,特殊字符   特殊字符: !@#~$%^&*()+|_
        UserOwnTenantLimit int64 `json:"userOwnTenantLimit,default=1"` // 用户可直接创建免费租户数量，0表示不可直接创建免费租户，需提供授权码
        OwnerUserID       int64 `json:"ownerUserID,string,optional,omitempty"`     // 平台超级管理员ID 非平台超管不返回该参数,不可修改
        RemindSetPassword int64 `json:"remindSetPassword,default=1,options=1|2"`   // 是否提醒未设置密码的用户设置密码(1:是，2:否)
        ForceSetPassword  int64 `json:"forceSetPassword,default=2,options=1|2"`    // 是否强制未设置密码的用户登录后设置密码(1:是，2:否)
    }

    SysOAuthConfig {
        IsEnable   int64  `json:"isEnable,optional,omitempty"` // 是否启用(1:启用，2:禁用)
        Issuer     string `json:"issuer,optional,omitempty"`   // issuer 标识
        PrivateKey string `json:"privateKey,optional,omitempty"` // RS256 私钥（PEM 内容，留空保持原私钥）
    }

    SysOauthKeyGenerateResp {
        PrivateKey string `json:"privateKey"` // 新生成的 RS256 私钥（PEM 格式）
    }

    SysTenantConfig {
        DefaultLimit TenantLimit `json:"defaultLimit"`  // 默认限制配置
    }

    SystemInitReq {
        Config    SysConfigInfo `json:"config"`    // 系统初始化配置（其中 oem.title 必填）
        OwnerUser UserCreate           `json:"ownerUser"` // 所有者用户信息
    }

    UserCreate {
        UserName string  `json:"userName"`             // 用户账号
        Password string  `json:"password"`             // 密码原文
        Email    *string `json:"email,optional"`       // 可选邮箱
        Phone    *string `json:"phone,optional"`       // 可选手机号
        NickName string  `json:"nickName,optional"`    // 可选昵称
        Avatar   string  `json:"avatar,optional"`      // 可选头像，创建的时候传filePath
    }


    TenantLimit {
        DeviceNum *int64 `json:"deviceNum,optional"`  // 租户下的设备数量限制,0为不限制
        UserNum *int64 `json:"userNum,optional"`    // 租户下的用户数量限制,0为不限制
        AiTokenMonthly *int64 `json:"aiTokenMonthly,optional"` // 默认 AI Token 月配额（单位：token）
        DiskSpaceGB *int64 `json:"diskSpaceGB,optional"` // 默认磁盘空间 GB
        DeviceMsgPerDay    *int64 `json:"deviceMsgPerDay,optional"`    // 默认租户每天设备消息总量上限
    }
)




