	email:  "174805676@qq.com"
)

@server (
	group:            system/role/info
	prefix:           /api/v1/system/role/info
	accessCodePrefix: "systemRoleManage"
	accessNamePrefix: "角色管理"
	accessGroup:      "角色管理"
	defaultAuthType:  "admin"
	defaultNeedAuth:  "true"
	middleware:       CheckTokenWare,InitCtxsWare
)
service api {
	@doc(
	    summary: "添加角色"
	    description: "业务说明：创建新的角色定义。角色是权限管理的核心单元，用于批量授权用户访问特定功能和数据。创建时可设置角色名称、编码、状态和描述等信息。"
	    authType: "admin"
	    group: "system/role/info"
	    resource: "system/role/info"
	    action: "create"
	    recordLogMode: "1"
	)
	@handler create
	post /create (RoleInfo) returns (WithID)

	@doc(
	    summary: "获取角色列表"
	    description: "业务说明：查询角色列表，支持按名称、状态、编码筛选。平台管理员可用tenantCode指定目标企业，普通管理员只能查询当前企业。用于角色选择器、权限配置页面、用户授权等场景。返回分页结果包含角色基本信息。"
	    authType: "admin"
	    group: "system/role/info"
	    resource: "system/role/info"
	    action: "view"
	    recordLogMode: "3"
	)
	@handler getList
	post /get-list (RoleInfoGetListReq) returns (RoleInfoGetListResp)

	@doc(
	    summary: "更新角色"
	    description: "业务说明：修改角色定义。可调整角色名称、状态、描述等属性。角色编码通常不可修改以保持权限引用稳定性。更新后立即生效，已授权用户权限自动同步。"
	    authType: "admin"
	    group: "system/role/info"
	    resource: "system/role/info"
	    action: "update"
	    recordLogMode: "1"
	)
	@handler update
	post /update (RoleInfo)

	@doc(
	    summary: "删除角色"
	    description: "业务说明：删除角色定义。删除前需确保无用户绑定该角色，否则删除失败。用于清理废弃角色、权限体系重构等场景。删除后相关权限配置需重新分配。"
	    authType: "admin"
	    group: "system/role/info"
	    resource: "system/role/info"
	    action: "delete"
	    recordLogMode: "1"
	)
	@handler delete
	post /delete (WithID)
}

@server (
	group:            system/role/app
	prefix:           /api/v1/system/role/app
	accessCodePrefix: "systemRoleManage"
	accessNamePrefix: "角色应用"
	accessGroup:      "角色管理"
	defaultAuthType:  "admin"
	defaultNeedAuth:  "true"
	middleware:       CheckTokenWare,InitCtxsWare
)
service api {
	@doc(
	    summary: "更新APP权限"
	    description: "业务说明：批量设置角色可访问的应用列表。控制角色能看到哪些应用入口。用于应用级权限控制，如限制普通用户只能访问特定模块的应用。"
	    authType: "admin"
	    group: "system/role/app"
	    resource: "system/role/app"
	    action: "update"
	    recordLogMode: "1"
	)
	@handler batchUpdate
	post /batch-update (RoleAppBatchUpdateReq)

	@doc(
	    summary: "获取APP权限列表"
	    description: "业务说明：查询角色已授权的应用列表。用于查看角色当前应用权限配置、权限对比、授权编辑等场景。返回应用ID列表和总数。"
	    authType: "admin"
	    group: "system/role/app"
	    resource: "system/role/app"
	    action: "view"
	    recordLogMode: "3"
	)
	@handler getList
	post /get-list (RoleAppGetListReq) returns (RoleAppGetListResp)
}

@server (
	group:            system/role/menu
	prefix:           /api/v1/system/role/menu
	accessCodePrefix: "systemRoleManage"
	accessNamePrefix: "角色菜单"
	accessGroup:      "角色管理"
	defaultAuthType:  "admin"
	defaultNeedAuth:  "true"
	middleware:       CheckTokenWare,InitCtxsWare
)
service api {
	@doc(
	    summary: "更新角色对应菜单列表"
	    description: "业务说明：批量设置角色在指定应用下可访问的菜单列表。控制角色能看到哪些菜单项和页面入口。用于菜单级权限控制，如隐藏管理菜单、限制敏感功能入口等。"
	    authType: "admin"
	    group: "system/role/menu"
	    resource: "system/role/menu"
	    action: "update"
	    recordLogMode: "1"
	)
	@handler batchUpdate
	post /batch-update (RoleMenuBatchUpdateReq)

	@doc(
	    summary: "获取角色对应菜单列表"
	    description: "业务说明：查询角色在指定应用下已授权的菜单列表。用于查看角色当前菜单权限配置、菜单权限对比、授权编辑等场景。返回菜单ID数组。"
	    authType: "admin"
	    group: "system/role/menu"
	    resource: "system/role/menu"
	    action: "view"
	    recordLogMode: "3"
	)
	@handler getList
	post /get-list (RoleMenuGetListReq) returns (RoleMenuGetListResp)
}

