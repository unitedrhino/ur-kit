//     post /batch-update (RoleModuleBatchUpdateReq) returns ()
//     @doc "获取角色对应模块列表"
//     @handler getList
//     post /getList (RoleModuleGetListReq) returns (RoleModuleGetListResp)
// }
type (
	RoleAppBatchUpdateReq {
		ID     int64   `json:"id,string"` //角色ID
		AppIDs []int64 `json:"appIDs,string"` //App列表数据
	}
	RoleAppGetListReq {
		ID int64 `json:"id,string"` //角色ID
	}
	RoleAppGetListResp {
		AppIDs []string `json:"appIDs,string"` //App列表数据
		Total  int64    `json:"total"` //App列表总数
	}
	RoleInfoGetListReq {
        TenantCode string `json:"tenantCode,optional"` // 平台管理员可指定目标企业；省略时查询当前企业
		Page   *PageInfo `json:"page,optional"` //分页信息,只获取一个则不填
		Name   string    `json:"name,optional"` //按名称查找角色
		Status int64     `json:"status,optional"` //按状态查找角色
		Codes  []string  `json:"codes,optional"` //角色编码过滤
		IDs    []int64   `json:"ids,string,optional"`
	}
	RoleInfo {
		ID          int64   `json:"id,string,optional"` // 编号
		Name        string  `json:"name,optional"` // 角色名称
		Desc        *string `json:"desc,optional"` // 备注
		CreatedTime int64   `json:"createdTime,string,optional"` // 创建时间
		Status      int64   `json:"status,optional"` // 角色状态
		Code        string  `json:"code,optional"` //角色编码
		IsFullAuth  int64   `json:"isFullAuth,optional"` // 是否完全授权（1:是，2:否）
	}
	RoleInfoGetListResp {
		List []*RoleInfo `json:"list"` //角色列表数据
		PageResp
	}
	RoleMenuBatchUpdateReq {
		ID      int64   `json:"id,string"` //角色编号
		AppID   int64   `json:"appID,string"` // 应用编号
		MenuIDs []int64 `json:"menuIDs,string"` //菜单编号列表
	}
	RoleMenuGetListReq {
		ID    int64 `json:"id,string"` //角色编号
		AppID int64 `json:"appID,string"` // 应用编号
	}
	RoleMenuGetListResp {
		MenuIDs []int64 `json:"menuIDs,string"` //菜单编号列表
	}
	RoleResourceActionItem {
		Resource string `json:"resource"` // 资源标识
		Action   string `json:"action"`   // 动作标识
	}
	RoleResourceActionGetListReq {
		RoleID   int64  `json:"roleId,string"`         // 角色ID
		Resource string `json:"resource,optional"`     // 可选资源筛选
	}
	RoleResourceActionGetListResp {
		List []*RoleResourceActionItem `json:"list"` // 资源动作权限列表
	}
	RoleResourceActionBatchUpdateReq {
		RoleID int64                    `json:"roleId,string"`  // 角色ID
		List   []*RoleResourceActionItem `json:"list"`           // 完整权限列表（全量替换）
	}
)

@server (
	group:            system/role/resource
	prefix:           /api/v1/system/role/resource
	accessCodePrefix: "systemRoleManage"
	accessNamePrefix: "角色资源动作管理"
	accessGroup:      "角色管理"
	defaultAuthType:  "admin"
	defaultNeedAuth:  "true"
	middleware:       CheckTokenWare,InitCtxsWare
)

service api {
	@doc(
	    summary: "获取角色资源动作权限列表"
	    description: "业务说明：查询指定角色已绑定的资源动作权限列表，用于角色编辑页权限回填显示。返回该角色下所有资源-动作对。"
	    authType: "admin"
	    group: "system/role/resource"
	    resource: "system/role/resource"
	    action: "view"
	    recordLogMode: "3"
	)
	@handler getList
	post /get-list (RoleResourceActionGetListReq) returns (RoleResourceActionGetListResp)

	@doc(
	    summary: "批量更新角色资源动作权限"
	    description: "业务说明：全量替换指定角色的资源动作权限绑定，传入完整的资源-动作列表，未包含的权限将被撤销。"
	    authType: "admin"
	    group: "system/role/resource"
	    resource: "system/role/resource"
	    action: "update"
	    recordLogMode: "1"
	)
	@handler batchUpdate
	post /batch-update (RoleResourceActionBatchUpdateReq) returns ()
}

