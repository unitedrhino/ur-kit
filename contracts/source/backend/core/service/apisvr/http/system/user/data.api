info(
    title: "用户数据权限管理模块"
    desc: "用户数据权限管理接口"
    author: "godLei6"
    email: "603785348@qq.com"
    version: "v1"
)


@server (
    group: system/user/data
    prefix: /api/v1/system/user/data
    accessCodePrefix: "systemUserManage"
    accessNamePrefix: "用户数据"
    accessGroup: "用户管理"
    defaultAuthType: "admin"
    defaultNeedAuth: "true"
    middleware:  CheckTokenWare,InitCtxsWare
)
service api {
    @doc(
        summary: "获取项目权限列表"
        description: "业务说明：查询指定用户在各项目中的权限分配情况，返回用户拥有的项目列表及每个项目的权限类型（管理/读写/只读）。用于用户权限审计、权限配置界面展示等场景。"
        authType: "admin"
        group: "system/user/data"
        resource: "system/user/data"
        action: "view"
        recordLogMode: "3"
    )
    @handler projectGetList
    post /project/get-list (UserDataProjectGetListReq) returns (UserDataProjectGetListResp)
    @doc(
        summary: "获取区域权限列表"
        description: "业务说明：查询指定用户在各区域中的权限分配情况，返回用户拥有的区域列表及每个区域的权限类型。可按项目ID过滤，用于数据权限配置、用户可访问区域范围查询等场景。"
        authType: "admin"
        group: "system/user/data"
        resource: "system/user/data"
        action: "view"
        recordLogMode: "3"
    )
    @handler areaGetList
    post /area/get-list (UserDataAreaGetListReq) returns (DataAreaGetListResp)
}


//用户级权限控制
type (
    UserDataProject  {
        ProjectID   int64 `json:"projectID,string"`     //权限数据ID
        AuthType  int64 `json:"authType"`// 1:管理权限,可以修改别人的权限,及读写权限 2:读写权限,可以读写该权限 3:读权限,只能读,不能修改
        TargetID   int64 `json:"targetID,string,optional"`    //用户ID
        UpdatedTime int64 `json:"updatedTime,optional"` //更新时间
        Project *ProjectInfo `json:"project,optional"`//获取用户类型返回
    }
    UserDataProjectGetListReq  {
        Page *PageInfo `json:"page,optional"`        //进行数据分页（不传默认2000相当于全部）
        UserID   int64 `json:"userID,string"`    //用户ID
    }

    UserDataProjectGetListResp  {
        PageResp
        List  []*UserDataProject `json:"list"`    //用户数据权限列表
    }

    UserDataAreaGetListReq  {
        Page *PageInfo `json:"page,optional"`        //进行数据分页（不传默认2000相当于全部）
        UserID   int64 `json:"userID,string"`    //用户ID
        ProjectID int64           `json:"projectID,string,optional"` //项目id
    }

    DataAreaDetail {
        AreaID      int64  `json:"areaID,string"`      //区域ID
        AuthType    int64  `json:"authType"`            //权限类型 1:读权限 4:管理权限
        TargetID    int64  `json:"targetID,string"`     //目标ID
        UpdatedTime int64  `json:"updatedTime,optional"` //更新时间
    }

    DataAreaGetListResp  {
        PageResp
        List  []*DataAreaDetail `json:"list"`    //用户数据权限列表
    }
)