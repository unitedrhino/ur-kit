# 接口地址
VITE_GLOB_API_URL=
VITE_BASE=/

#存储桶地址
VITE_GLOB_BUCKET_BASE_URL=

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 天地图 API Key（生产环境需配置）
VITE_TIANDITU_KEY=

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# 公共镜像的本地示例默认值；实际平台应用标识在构建时覆盖。
VITE_APP_TITLE=IoT Client
VITE_GLOB_APPNAME=iot-client
VITE_GLOB_APPID=600
VITE_APP_NAMESPACE=iot-client
