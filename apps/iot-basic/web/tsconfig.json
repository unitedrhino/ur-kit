{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@vben/tsconfig/web-app.json",
  "compilerOptions": {
    "baseUrl": ".",
    // 与依赖的 bigscreen 包源码口径对齐（其 tsconfig 显式关闭以下三项）：
    // org-iot-client 通过 @/ 与 @app/ 直接编译 bigscreen 源码（dashboard 嵌入 goview 场景），
    // 若保持严格口径会对同一批依赖文件按更严规则重复报错
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "paths": {
      "#/*": ["./src/*"],
      // 与 vite alias 对齐：@/ 与 @app/ 指向 bigscreen 包源码
      "@/*": ["../../../web-shared/packages/bigscreen/src/goview/*"],
      "@app/*": ["../../../web-shared/packages/bigscreen/src/*"],
      "@app/shared/*": ["../../../web-shared/packages/bigscreen/src/shared/*"],
      "@app/views/bigscreen/*": ["../../../web-shared/packages/bigscreen/src/views/bigscreen/*"]
    }
  },
  "references": [{ "path": "./tsconfig.node.json" }],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    // bigscreen 的 goview 全局声明（window.$message 等）与 *.vue 模块 shim，供依赖源码编译时生效
    "../../../web-shared/packages/bigscreen/src/goview/types/global.d.ts",
    "../../../web-shared/packages/bigscreen/src/goview/types/shims-vue.d.ts"
  ]
}
