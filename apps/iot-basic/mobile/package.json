{
  "name": "saas-mobile-uniapp",
  "version": "1.0.0",
  "private": true,
  "description": "联犀Iot 多端应用（uni-app + Vue 3 + TS）",
  "scripts": {
    "dev": "uni -p mp-weixin",
    "dev2": "UNI_OUTPUT_DIR=dist/dev2/mp-weixin uni -p mp-weixin --mode dev2",
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev2:mp-weixin": "UNI_OUTPUT_DIR=dist/dev2/mp-weixin uni -p mp-weixin --mode dev2",
    "dev:mp-alipay": "uni -p mp-alipay",
    "dev:mp-toutiao": "uni -p mp-toutiao",
    "dev:app": "uni -p app",
    "dev:app-android": "uni -p app-android",
    "dev:app-ios": "uni -p app-ios",
    "dev:app-harmony": "uni -p app-harmony",
    "build": "uni build -p mp-weixin",
    "build2": "UNI_OUTPUT_DIR=dist/build2/mp-weixin uni build -p mp-weixin --mode build2",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build2:mp-weixin": "UNI_OUTPUT_DIR=dist/build2/mp-weixin uni build -p mp-weixin --mode build2",
