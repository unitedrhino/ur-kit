    "build:mp-toutiao": "uni build -p mp-toutiao",
    "build:app": "uni build -p app",
    "build:app-android": "uni build -p app-android",
    "build:app-ios": "uni build -p app-ios",
    "build:app-harmony": "uni build -p app-harmony",
    "codegen": "node codegen.js",
    "generate:icons": "node scripts/generate-icons.cjs",
    "test:contract": "node --test scripts/*.test.cjs",
    "test:automator:mp-weixin": "jest -c jest.config.cjs --runInBand",
    "test": "node --test scripts/*.test.cjs",
    "tsc": "vue-tsc --noEmit"
  },
